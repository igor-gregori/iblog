+import { emTransacao, type Banco } from '../banco.ts'
+import { Conflito, ErroDeNegocio } from '../erros.ts'
+import { devolverEstoque } from '../produtos/repositorio.ts'
+import { mudarStatus } from './estados.ts'
+import {
+  buscarDevolucao,
+  buscarDevolucaoPorChave,
+  devolvidoPorProduto,
+  inserirDevolucao,
+  somarReembolso,
+  type Devolucao,
+  type Pedido,
+} from './repositorio.ts'
+
+const PRAZO_EM_MS = 7 * 24 * 60 * 60 * 1000
+
+export function cancelarPedido(banco: Banco, pedido: Pedido, agora: Date): void {
+  emTransacao(banco, () => {
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) devolverEstoque(banco, item.produtoId, item.quantidade)
+    somarReembolso(banco, pedido.id, pedido.total)
+  })
+}
+
+export type ItemDevolvido = { produtoId: number; quantidade: number }
+
+const mesmosItens = (a: ItemDevolvido[], b: ItemDevolvido[]) =>
+  a.length === b.length && a.every((item, i) => item.produtoId === b[i].produtoId && item.quantidade === b[i].quantidade)
+
+/** Registra a devolução e diz se ela é nova (201) ou a repetição de uma com a mesma chave (200). */
+export function registrarDevolucao(
+  banco: Banco,
+  pedido: Pedido,
+  itens: ItemDevolvido[],
+  chave: string | undefined,
+  agora: Date,
+): { devolucao: Devolucao; nova: boolean } {
+  return emTransacao(banco, () => {
+    if (chave !== undefined) {
+      const anterior = buscarDevolucaoPorChave(banco, pedido.id, chave)
+      if (anterior) {
+        if (!mesmosItens(anterior.itens, itens)) {
+          throw new Conflito('chave_reutilizada', 'Essa Idempotency-Key já foi usada com outros itens')
+        }
+        return { devolucao: anterior, nova: false }
+      }
+    }
+    if (pedido.status === 'cancelado' || pedido.status === 'devolvido') {
+      throw new Conflito('transicao_invalida', `Um pedido ${pedido.status} não aceita devolução`)
+    }
+    if (pedido.status !== 'entregue') {
+      throw new ErroDeNegocio('pedido_nao_entregue', 'Só um pedido entregue aceita devolução')
+    }
+    if (agora.getTime() - new Date(pedido.entregueEm!).getTime() > PRAZO_EM_MS) {
+      throw new ErroDeNegocio('prazo_de_devolucao_encerrado', 'O prazo de 7 dias para devolução acabou')
+    }
+    if (new Set(itens.map((item) => item.produtoId)).size !== itens.length) {
+      throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução')
+    }
+    const jaDevolvido = devolvidoPorProduto(banco, pedido.id)
+    let reembolso = 0
+    for (const item of itens) {
+      const comprado = pedido.itens.find((comprado) => comprado.produtoId === item.produtoId)
+      if (!comprado) throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      const total = (jaDevolvido.get(item.produtoId) ?? 0) + item.quantidade
+      if (total > comprado.quantidade) {
+        throw new ErroDeNegocio('quantidade_maior_que_a_comprada', `Devolução maior que a compra do produto ${item.produtoId}`)
+      }
+      jaDevolvido.set(item.produtoId, total)
+      reembolso += comprado.precoUnitario * item.quantidade
+    }
+    const id = inserirDevolucao(banco, pedido.id, { itens, reembolso, chave: chave ?? null, criadaEm: agora.toISOString() })
+    for (const item of itens) devolverEstoque(banco, item.produtoId, item.quantidade)
+    somarReembolso(banco, pedido.id, reembolso)
+    if (pedido.itens.every((comprado) => jaDevolvido.get(comprado.produtoId) === comprado.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return { devolucao: buscarDevolucao(banco, id)!, nova: true }
+  })
+}
