+export async function rotasDeDevolucoes(app: FastifyInstance): Promise<void> {
+  app.post<{ Params: { id: number } }>(
+    '/pedidos/:id/cancelar',
+    { schema: { params: parametrosComId } },
+    async (pedido) => {
+      const encontrado = pedidoOu404(app, pedido.params.id)
+      cancelarPedido(app.banco, encontrado, app.agora())
+      return buscarPedido(app.banco, encontrado.id)
+    },
+  )
+
+  app.post<{ Params: { id: number }; Body: { itens: ItemDevolvido[] }; Headers: { 'idempotency-key'?: string } }>(
+    '/pedidos/:id/devolucoes',
+    {
+      schema: {
+        params: parametrosComId,
+        headers: {
+          type: 'object',
+          properties: { 'idempotency-key': { type: 'string', minLength: 1, maxLength: 100 } },
+        },
+        body: {
+          type: 'object',
+          required: ['itens'],
+          additionalProperties: false,
+          properties: {
+            itens: {
+              type: 'array',
+              minItems: 1,
+              maxItems: 50,
+              items: {
+                type: 'object',
+                required: ['produtoId', 'quantidade'],
+                additionalProperties: false,
+                properties: { produtoId: id, quantidade: { type: 'integer', minimum: 1, maximum: 1000 } },
+              },
+            },
+          },
+        },
+      },
+    },
+    async (pedido, resposta) => {
+      const encontrado = pedidoOu404(app, pedido.params.id)
+      const { devolucao, nova } = registrarDevolucao(
+        app.banco,
+        encontrado,
+        pedido.body.itens,
+        pedido.headers['idempotency-key'],
+        app.agora(),
+      )
+      return resposta.code(nova ? 201 : 200).send(devolucao)
+    },
+  )
+}
+
 function pedidoOu404(app: FastifyInstance, pedidoId: number) {
   const pedido = buscarPedido(app.banco, pedidoId)
   if (!pedido) throw new NaoEncontrado('Pedido')
