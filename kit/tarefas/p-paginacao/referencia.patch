+/** Minúsculas e sem acentos: "Café" vira "cafe". Usada na busca, em TypeScript e no SQL (`normalizar`). */
+export function normalizar(texto: string): string {
+  return texto.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase()
+}
