+import type { FastifyInstance } from 'fastify'
+import { Conflito } from '../erros.ts'
+import { buscarCupom, inserirCupom, type Cupom } from './repositorio.ts'
+
+function dataExiste(data: string): boolean {
+  const instante = new Date(`${data}T00:00:00Z`)
+  return !Number.isNaN(instante.getTime()) && instante.toISOString().slice(0, 10) === data
+}
+
+export async function rotasDeCupons(app: FastifyInstance): Promise<void> {
+  app.post<{ Body: Cupom }>(
+    '/cupons',
+    {
+      schema: {
+        body: {
+          type: 'object',
+          required: ['codigo', 'tipo', 'valor', 'validoAte', 'minimo'],
+          additionalProperties: false,
+          properties: {
+            codigo: { type: 'string', pattern: '^[A-Za-z0-9]{1,30}$' },
+            tipo: { type: 'string', enum: ['percentual', 'fixo'] },
+            valor: { type: 'integer', minimum: 1 },
+            validoAte: { type: 'string', pattern: '^\\d{4}-\\d{2}-\\d{2}$' },
+            minimo: { type: 'integer', minimum: 0 },
+          },
+        },
+      },
+    },
+    async (pedido, resposta) => {
+      const cupom = { ...pedido.body, codigo: pedido.body.codigo.toUpperCase() }
+      if ((cupom.tipo === 'percentual' && cupom.valor > 100) || !dataExiste(cupom.validoAte)) {
+        return resposta.code(400).send({ erro: { codigo: 'dados_invalidos', mensagem: 'Cupom inválido' } })
+      }
+      if (buscarCupom(app.banco, cupom.codigo)) {
+        throw new Conflito('codigo_em_uso', 'Já existe um cupom com esse código')
+      }
+      inserirCupom(app.banco, cupom, app.agora().toISOString())
+      return resposta.code(201).send(cupom)
+    },
+  )
+}
