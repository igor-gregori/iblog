@@ -0,0 +1,37 @@
+import type { Banco } from '../banco.ts'
+import type { Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  validoAte: string
+  minimo: Centavos
+}
+
+type Linha = { codigo: string; tipo: TipoDeCupom; valor: number; valido_ate: string; minimo: number }
+
+export function buscarCupom(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE codigo = ?').get(codigo.toUpperCase()) as Linha | undefined
+  return (
+    linha && {
+      codigo: linha.codigo,
+      tipo: linha.tipo,
+      valor: linha.valor,
+      validoAte: linha.valido_ate,
+      minimo: linha.minimo,
+    }
+  )
+}
+
+export function inserirCupom(banco: Banco, cupom: Cupom, criadoEm: string): void {
+  banco
+    .prepare('INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(cupom.codigo, cupom.tipo, cupom.valor, cupom.validoAte, cupom.minimo, criadoEm)
+}
+
+export function clienteJaUsou(banco: Banco, clienteId: number, codigo: string): boolean {
+  return banco.prepare('SELECT 1 FROM pedidos WHERE cliente_id = ? AND cupom = ?').get(clienteId, codigo) !== undefined
+}
