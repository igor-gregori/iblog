+import type { Centavos } from '../dinheiro.ts'
+import type { Cupom } from './repositorio.ts'
+
+export type ItemParaDesconto = { preco: Centavos; quantidade: number; emPromocao: boolean }
+
+/** O desconto do cupom: só sobre os itens sem promoção, arredondado para baixo, nunca maior que a base. */
+export function calcularDesconto(cupom: Pick<Cupom, 'tipo' | 'valor'>, itens: ItemParaDesconto[]): Centavos {
+  const base = itens.filter((item) => !item.emPromocao).reduce((soma, item) => soma + item.preco * item.quantidade, 0)
+  const desconto = cupom.tipo === 'percentual' ? Math.floor((base * cupom.valor) / 100) : cupom.valor
+  return Math.min(desconto, base)
+}
+
+/** O cupom vale até o fim do dia `validoAte`, em UTC. */
+export function estaValido(cupom: Pick<Cupom, 'validoAte'>, agora: Date): boolean {
+  return agora.toISOString().slice(0, 10) <= cupom.validoAte
+}
