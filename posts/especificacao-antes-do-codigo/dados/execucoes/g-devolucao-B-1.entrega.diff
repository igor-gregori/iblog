+test('as devoluções se somam, até o que foi comprado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  const segunda = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(segunda.status, 201)
+  assert.equal(segunda.corpo.reembolso, 2 * 3990 + 1500)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 3 * 3990 + 1500)
+
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(demais.status, 422)
+  assert.equal(demais.corpo.erro.codigo, 'devolucao_acima_do_comprado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 3 * 3990 + 1500)
+})
+
+test('uma devolução com um item inválido não grava nada', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  const { status, corpo } = await devolver(ctx, pedido.id, [
