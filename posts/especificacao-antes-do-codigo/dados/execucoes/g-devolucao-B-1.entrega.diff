@@ -0,0 +1,186 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+async function buscar(ctx: Contexto, pedidoId: number) {
+  return (await ctx.pedir({ method: 'GET', url: `/pedidos/${pedidoId}` })).corpo
+}
+
+/** Um pedido de 3 canecas (R$ 39,90) e 2 pires (R$ 15,00), com 10 de estoque de cada antes da compra. */
+async function comprar(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 2 },
+    ],
+  })
+  return { pedido, caneca, pires }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number): Promise<void> {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown) {
+  return ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/devolucoes`, payload: { itens } })
+}
+
+test('um pedido novo não tem nada reembolsado', async () => {
+  const ctx = montar()
+  const { pedido } = await comprar(ctx)
+  assert.equal(pedido.reembolsado, 0)
+  assert.equal(pedido.canceladoEm, null)
+})
+
+test('cancela um pedido pago: o estoque volta e o total é reembolsado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, pedido.total)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela duas vezes, nem um pedido enviado ou entregue', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await comprar(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  const denovo = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(denovo.status, 409)
+  assert.equal(denovo.corpo.erro.codigo, 'transicao_invalida')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, pedido.total)
+
+  const enviado = (await comprar(ctx)).pedido
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.id}/enviar` })
+  const entregue = await comprar(ctx)
+  await entregar(ctx, entregue.pedido.id)
+  for (const id of [enviado.id, entregue.pedido.id]) {
+    const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${id}/cancelar` })
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'transicao_invalida')
+    assert.equal((await buscar(ctx, id)).reembolsado, 0)
+  }
+  assert.equal(await estoqueDe(ctx, entregue.caneca.id), 7)
+})
+
+test('devolve parte de um pedido entregue, pelo preço da compra', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.equal(corpo.reembolso, 2 * 3990)
+  assert.equal(corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+  assert.deepEqual(corpo.itens, [{ produtoId: caneca.id, quantidade: 2, precoUnitario: 3990 }])
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+
+  const depois = await buscar(ctx, pedido.id)
+  assert.equal(depois.status, 'entregue')
+  assert.equal(depois.reembolsado, 2 * 3990)
+})
