+function cupomValido(banco: Banco, codigo: string, agora: Date): Cupom {
+  const cupom = buscarCupomPorCodigo(banco, codigo)
+  if (!cupom) {
+    throw new ErroDeNegocio('cupom_inexistente', 'Cupom não encontrado')
+  }
+  if (hojeEmBrasilia(agora) > cupom.validoAte) {
