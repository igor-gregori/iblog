+test('o mínimo do cupom vale sobre o subtotal com preço promocional', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'JUSTO', minimo: 5980 })
+  await criarCupom(ctx, { codigo: 'QUASE', minimo: 5981 })
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, precoPromocional: 2990, estoque: 10 })
+  const pedir = (cupom: string) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: caneca.id, quantidade: 2 }], cupom })
+
+  const justo = await pedir('JUSTO')
+  assert.equal(justo.status, 201)
+  assert.equal(justo.corpo.subtotal, 5980)
+  assert.equal(justo.corpo.desconto, 598)
+
+  const quase = await pedir('QUASE')
+  assert.equal(quase.status, 422)
+  assert.equal(quase.corpo.erro.codigo, 'pedido_abaixo_do_minimo')
+  assert.match(quase.corpo.erro.mensagem, /R\$ 59,81/)
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+})
+
+test('recusa cupom que não existe, sem baixar o estoque', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: 'NADA',
