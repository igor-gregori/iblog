+test('o cupom vale até o fim do dia validoAte, no horário de Brasília', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'HOJE', validoAte: '2026-03-01' })
+  const pedir = await pedidoDeUmaCaneca(ctx)
+
+  assert.equal((await pedir('HOJE')).status, 201)
+
+  // 23h de 1º de março em Brasília.
+  ctx.relogio.atual = new Date('2026-03-02T02:00:00Z')
+  assert.equal((await pedir('HOJE')).status, 201)
+
+  // Meia-noite de 2 de março em Brasília.
+  ctx.relogio.atual = new Date('2026-03-02T03:00:00Z')
+  const { status, corpo } = await pedir('HOJE')
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_expirado')
+})
+
+test('o pedido guarda o desconto: aparece na busca e na lista', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', valor: 10 })
+  const pedir = await pedidoDeUmaCaneca(ctx)
+  const { corpo: criado } = await pedir('DEZ')
+  const resumo = (p: Record<string, unknown>) => ({
+    subtotal: p.subtotal,
+    desconto: p.desconto,
+    total: p.total,
+    cupom: p.cupom,
+  })
+  const esperado = { subtotal: 3990, desconto: 399, total: 3591, cupom: 'DEZ' }
+
+  const { corpo: buscado } = await ctx.pedir({ method: 'GET', url: `/pedidos/${criado.id}` })
+  assert.deepEqual(resumo(buscado), esperado)
+  const { corpo: lista } = await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${criado.clienteId}` })
+  assert.deepEqual(resumo(lista.itens[0]), esperado)
+})
