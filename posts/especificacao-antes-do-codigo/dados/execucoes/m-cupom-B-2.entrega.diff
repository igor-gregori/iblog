+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { DatabaseSync } from 'node:sqlite'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { migrar } from '../src/banco.ts'
+import { criarCupom, montar } from './ajuda.ts'
+
+const valido = { codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 }
+
+test('cadastra um cupom, com o código em maiúsculas', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx, { ...valido, codigo: ' natal10 ' })
+  assert.equal(typeof cupom.id, 'number')
+  assert.deepEqual({ ...cupom, id: 0 }, { ...valido, id: 0 })
+})
+
+test('recusa código repetido, mesmo em outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, valido)
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { ...valido, codigo: 'Natal10', tipo: 'fixo', valor: 500 },
+  })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'cupom_ja_existe')
+})
+
+test('recusa cupom malformado', async () => {
+  const ctx = montar()
+  const { codigo: _, ...semCodigo } = valido
+  const casos: Record<string, unknown>[] = [
+    { ...valido, tipo: 'brinde' },
+    { ...valido, valor: 0 },
+    { ...valido, valor: 101 },
+    { ...valido, valor: 9.5 },
+    { ...valido, tipo: 'fixo', valor: 0 },
+    { ...valido, validoAte: '2026-13-01' },
+    { ...valido, validoAte: '25/12/2026' },
+    { ...valido, minimo: -1 },
+    { ...valido, codigo: 'X' },
+    { ...valido, codigo: 'com espaço' },
+    semCodigo,
+  ]
+  for (const payload of casos) {
+    const { status, corpo } = await ctx.pedir({ method: 'POST', url: '/cupons', payload })
+    assert.equal(status, 400, JSON.stringify(payload))
+    assert.equal(corpo.erro.codigo, 'dados_invalidos')
+  }
+})
+
+test('um cupom fixo pode passar de 100 centavos', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx, { ...valido, tipo: 'fixo', valor: 2500 })
+  assert.equal(cupom.valor, 2500)
+})
+
+test('a migração 002 guarda o total dos pedidos antigos como subtotal', () => {
+  const banco = new DatabaseSync(':memory:')
+  banco.exec(readFileSync(join(import.meta.dirname, '../src/migracoes/001_inicial.sql'), 'utf8'))
+  banco.exec('CREATE TABLE migracoes (nome TEXT PRIMARY KEY, aplicada_em TEXT NOT NULL)')
+  banco.exec("INSERT INTO migracoes VALUES ('001_inicial.sql', '2026-01-01')")
+  banco.exec("INSERT INTO clientes (nome, email, criado_em) VALUES ('Ana', 'ana@exemplo.com', '2026-01-01')")
+  banco.exec("INSERT INTO pedidos (cliente_id, status, total, criado_em) VALUES (1, 'pago', 3990, '2026-01-01')")
+
+  migrar(banco)
+  assert.deepEqual(
+    { ...(banco.prepare('SELECT subtotal, desconto, total, cupom_id FROM pedidos').get() as object) },
+    { subtotal: 3990, desconto: 0, total: 3990, cupom_id: null },
+  )
+})
