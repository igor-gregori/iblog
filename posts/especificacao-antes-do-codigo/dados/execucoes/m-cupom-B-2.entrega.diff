+test('cupom percentual desconta a porcentagem, arredondando para baixo', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', valor: 10 })
+  await criarCupom(ctx, { codigo: 'QUINZE', valor: 15 })
+  const pedir = await pedidoDeUmaCaneca(ctx)
+
+  const dez = await pedir('DEZ')
+  assert.equal(dez.status, 201)
+  assert.equal(dez.corpo.subtotal, 3990)
+  assert.equal(dez.corpo.desconto, 399)
+  assert.equal(dez.corpo.total, 3591)
+  assert.equal(dez.corpo.cupom, 'DEZ')
+
+  // 15% de 3990 são 598,5 centavos.
+  const quinze = await pedir('QUINZE')
+  assert.equal(quinze.corpo.desconto, 598)
+  assert.equal(quinze.corpo.total, 3392)
+})
+
