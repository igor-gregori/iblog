+export type FiltrosDeProdutos = {
+  /** Trecho do nome, sem diferença de maiúsculas e acentos. */
+  busca?: string
+  /** Limites inclusivos do preço de venda (o promocional, se houver). */
+  precoMin?: Centavos
+  precoMax?: Centavos
+}
+
+export type Pagina<T> = { itens: T[]; total: number }
+
+/** Os produtos à venda que atendem aos filtros, em ordem de nome, uma página por vez. */
+export function listarProdutosAtivos(
+  banco: Banco,
+  filtros: FiltrosDeProdutos,
+  pagina: number,
+  porPagina: number,
+): Pagina<Produto> {
+  const condicoes = ['ativo = 1']
+  const valores: (string | number)[] = []
+  const busca = filtros.busca?.trim()
+  if (busca) {
+    condicoes.push('instr(normalizar(nome), normalizar(?)) > 0')
+    valores.push(busca)
+  }
+  if (filtros.precoMin !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) >= ?')
+    valores.push(filtros.precoMin)
+  }
+  if (filtros.precoMax !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) <= ?')
+    valores.push(filtros.precoMax)
+  }
+  const where = condicoes.join(' AND ')
+
+  const { total } = banco.prepare(`SELECT COUNT(*) AS total FROM produtos WHERE ${where}`).get(...valores) as {
+    total: number
+  }
+  const linhas = banco
+    .prepare(`SELECT * FROM produtos WHERE ${where} ORDER BY nome, id LIMIT ? OFFSET ?`)
+    .all(...valores, porPagina, (pagina - 1) * porPagina) as Linha[]
+  return { itens: linhas.map(paraProduto), total }
 }
 
