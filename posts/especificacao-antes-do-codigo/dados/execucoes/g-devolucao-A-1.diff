+/** Cancela um pedido que ainda não foi enviado: o estoque de todos os itens volta e o total é reembolsado. */
+export function cancelarPedido(banco: Banco, pedido: Pedido, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    return buscarPedido(banco, pedido.id)!
+  })
+}
+
+/** Quantos dias depois da entrega o cliente ainda pode devolver. */
+export const PRAZO_DE_DEVOLUCAO_EM_DIAS = 7
+
+const UM_DIA = 24 * 60 * 60 * 1000
+
+/**
+ * Registra a devolução de itens de um pedido entregue, até `PRAZO_DE_DEVOLUCAO_EM_DIAS` depois da entrega: o estoque
+ * volta e o cliente recebe o que pagou por eles. Um pedido pode ter várias devoluções, mas nunca mais unidades
+ * devolvidas do que compradas; quando tudo foi devolvido, o pedido passa para `devolvido`.
+ *
+ * Com uma `chaveDeIdempotencia`, repetir a requisição com o mesmo corpo devolve a devolução que já existe, sem repetir
+ * nada (`criada` é `false`); com outro corpo, é um conflito.
+ */
+export function devolverItens(
+  banco: Banco,
+  pedido: Pedido,
+  nova: NovaDevolucao,
+  agora: Date,
+  chaveDeIdempotencia: string | null = null,
+): { devolucao: Devolucao; criada: boolean } {
+  const corpo = JSON.stringify(nova.itens.map((item) => ({ produtoId: item.produtoId, quantidade: item.quantidade })))
+  if (chaveDeIdempotencia !== null) {
+    const anterior = buscarDevolucaoPorChave(banco, pedido.id, chaveDeIdempotencia)
+    if (anterior) {
+      if (anterior.corpo !== corpo) {
+        throw new Conflito(
+          'chave_de_idempotencia_reusada',
+          'Esta Idempotency-Key já foi usada numa devolução diferente deste pedido',
+        )
+      }
+      return { devolucao: anterior.devolucao, criada: false }
+    }
+  }
+
+  if (pedido.status !== 'entregue') {
+    throw new Conflito(
+      'pedido_nao_entregue',
+      `Só é possível devolver itens de um pedido entregue; este está ${pedido.status}`,
+    )
+  }
+  const limite = new Date(pedido.entregueEm!).getTime() + PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA
+  if (agora.getTime() > limite) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_encerrado',
+      `O prazo para devolver é de ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+    )
+  }
+  const produtos = new Set(nova.itens.map((item) => item.produtoId))
+  if (produtos.size !== nova.itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
+
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está neste pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_maior_que_a_comprada',
+          `Do produto ${item.produtoId}, ainda podem ser devolvidas ${restante} unidade(s)`,
+        )
+      }
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const devolucao = inserirDevolucao(banco, {
+      pedidoId: pedido.id,
+      itens,
+      reembolso,
+      criadaEm: agora.toISOString(),
+      chaveDeIdempotencia,
+      corpo,
+    })
+
+    const devolvidasAgora = quantidadesDevolvidas(banco, pedido.id)
+    if (pedido.itens.every((item) => devolvidasAgora.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return { devolucao, criada: true }
+  })
+}
