+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const pedir = () =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedido.id}/devolucoes`,
+      headers: { 'idempotency-key': 'abc' },
+      payload: {
+        itens: [
+          { produtoId: caneca.id, quantidade: 3 },
+          { produtoId: pires.id, quantidade: 1 },
+        ],
+      },
+    })
+  const primeira = await pedir()
+  assert.equal(primeira.status, 201)
+  // Repete depois que o pedido já ficou devolvido e o prazo passou: continua sendo a mesma devolução.
+  ctx.relogio.avancarDias(30)
+  const segunda = await pedir()
+  assert.equal(segunda.status, 200)
+  assert.deepEqual(segunda.corpo, primeira.corpo)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  const { corpo } = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(corpo.devolucoes.length, 1)
+  assert.equal(corpo.reembolsado, pedido.total)
+})
