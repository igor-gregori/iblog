+CREATE TABLE cupons (
+  codigo TEXT PRIMARY KEY,
+  tipo TEXT NOT NULL,
+  valor INTEGER NOT NULL,
+  valido_ate TEXT NOT NULL,
+  minimo INTEGER NOT NULL,
+  criado_em TEXT NOT NULL
+);
+
+ALTER TABLE pedidos ADD COLUMN subtotal INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE pedidos ADD COLUMN desconto INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE pedidos ADD COLUMN cupom TEXT REFERENCES cupons (codigo);
+
+UPDATE pedidos SET subtotal = total;
+
+-- Cada cliente usa cada cupom uma vez, mesmo com dois pedidos ao mesmo tempo.
+CREATE UNIQUE INDEX pedidos_cupom_por_cliente ON pedidos (cliente_id, cupom) WHERE cupom IS NOT NULL;
