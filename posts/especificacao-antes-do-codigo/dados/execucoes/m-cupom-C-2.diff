+import { multiplicar, somar, type Centavos } from '../dinheiro.ts'
+import type { Cupom } from './repositorio.ts'
+
+export type ItemComPreco = {
+  precoUnitario: Centavos
+  quantidade: number
+  emPromocao: boolean
+}
+
+/**
+ * O desconto do cupom, em centavos. Itens em promoção não recebem desconto: a base é a soma dos outros. O percentual
+ * é arredondado para baixo ao centavo, e o fixo nunca passa da base.
+ */
+export function calcularDesconto(cupom: Pick<Cupom, 'tipo' | 'valor'>, itens: ItemComPreco[]): Centavos {
+  const base = somar(
+    itens.filter((item) => !item.emPromocao).map((item) => multiplicar(item.precoUnitario, item.quantidade)),
+  )
+  if (cupom.tipo === 'percentual') return Math.floor((base * cupom.valor) / 100)
+  return Math.min(cupom.valor, base)
+}
+
+/** Se o cupom ainda vale em `agora`: vale até o fim do dia `validoAte`, em UTC. */
+export function cupomValeEm(cupom: Pick<Cupom, 'validoAte'>, agora: Date): boolean {
+  const fimDoDia = new Date(`${cupom.validoAte}T00:00:00.000Z`).getTime() + 24 * 60 * 60 * 1000
+  return agora.getTime() < fimDoDia
+}
