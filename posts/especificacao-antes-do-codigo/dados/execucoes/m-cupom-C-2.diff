@@ -0,0 +1,106 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { test } from 'node:test'
+import { migrar } from '../src/banco.ts'
+import { calcularDesconto, cupomValeEm } from '../src/cupons/desconto.ts'
+import { montar } from './ajuda.ts'
+
+const cupomValido = { codigo: 'natal10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 }
+
+test('cadastra um cupom com o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: '/cupons', payload: cupomValido })
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, { ...cupomValido, codigo: 'NATAL10' })
+})
+
+test('recusa código repetido, em qualquer caixa, com 409', async () => {
+  const ctx = montar()
+  await ctx.pedir({ method: 'POST', url: '/cupons', payload: cupomValido })
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { ...cupomValido, codigo: 'NaTaL10', tipo: 'fixo' },
+  })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa cupom fora das regras com 400', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { codigo: '' },
+    { codigo: 'A'.repeat(31) },
+    { codigo: 'NATAL-10' },
+    { tipo: 'brinde' },
+    { valor: 0 },
+    { valor: 101 },
+    { valor: 10.5 },
+    { tipo: 'fixo', valor: 0 },
+    { validoAte: '2026-13-01' },
+    { validoAte: '2026-02-30' },
+    { validoAte: '25/12/2026' },
+    { validoAte: '2026-12-25T00:00:00Z' },
+    { minimo: -1 },
+  ]
+  for (const caso of casos) {
+    const { status, corpo } = await ctx.pedir({ method: 'POST', url: '/cupons', payload: { ...cupomValido, ...caso } })
+    assert.equal(status, 400, JSON.stringify(caso))
+    assert.equal(corpo.erro.codigo, 'dados_invalidos')
+  }
+  const { minimo: _, ...semMinimo } = cupomValido
+  assert.equal((await ctx.pedir({ method: 'POST', url: '/cupons', payload: semMinimo })).status, 400)
+})
+
+test('aceita os limites: 100%, fixo acima do mínimo, 29 de fevereiro em ano bissexto', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { codigo: 'CEM', valor: 100 },
+    { codigo: 'UM', valor: 1 },
+    { codigo: 'FIXO', tipo: 'fixo', valor: 1000000, minimo: 0 },
+    { codigo: 'BISSEXTO', validoAte: '2028-02-29' },
+  ]
+  for (const caso of casos) {
+    const { status } = await ctx.pedir({ method: 'POST', url: '/cupons', payload: { ...cupomValido, ...caso } })
+    assert.equal(status, 201, JSON.stringify(caso))
+  }
+})
+
