+import type { Banco } from '../banco.ts'
+import type { Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  /** Sempre em maiúsculas. */
+  codigo: string
+  tipo: TipoDeCupom
+  /** `percentual`: a porcentagem, de 1 a 100. `fixo`: o desconto em centavos. */
+  valor: number
+  /** O último dia em que o cupom vale (até o fim do dia, em UTC), como `AAAA-MM-DD`. */
+  validoAte: string
+  /** O subtotal mínimo do pedido. */
+  minimo: Centavos
+}
+
+type Linha = {
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  valido_ate: string
+  minimo: number
+}
+
+function paraCupom(linha: Linha): Cupom {
+  return {
+    codigo: linha.codigo,
+    tipo: linha.tipo,
+    valor: linha.valor,
+    validoAte: linha.valido_ate,
+    minimo: linha.minimo,
+  }
+}
+
+/** Busca pelo código, que precisa já estar em maiúsculas. */
+export function buscarCupom(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco
+    .prepare('SELECT codigo, tipo, valor, valido_ate, minimo FROM cupons WHERE codigo = ?')
+    .get(codigo) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+export function inserirCupom(banco: Banco, cupom: Cupom, criadoEm: string): Cupom {
+  banco
+    .prepare('INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(cupom.codigo, cupom.tipo, cupom.valor, cupom.validoAte, cupom.minimo, criadoEm)
+  return buscarCupom(banco, cupom.codigo)!
+}
