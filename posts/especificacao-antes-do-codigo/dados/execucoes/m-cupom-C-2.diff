+import type { FastifyInstance } from 'fastify'
+import { Conflito, ErroDeNegocio } from '../erros.ts'
+import { centavos } from '../esquemas.ts'
+import { buscarCupom, inserirCupom, type Cupom } from './repositorio.ts'
+
+export async function rotasDeCupons(app: FastifyInstance): Promise<void> {
+  app.post<{ Body: Cupom }>(
+    '/cupons',
+    {
+      schema: {
+        body: {
+          type: 'object',
+          required: ['codigo', 'tipo', 'valor', 'validoAte', 'minimo'],
+          additionalProperties: false,
+          properties: {
+            codigo: { type: 'string', pattern: '^[A-Za-z0-9]{1,30}$' },
+            tipo: { type: 'string', enum: ['percentual', 'fixo'] },
+            valor: { type: 'integer', minimum: 1 },
+            validoAte: { type: 'string', pattern: '^\\d{4}-\\d{2}-\\d{2}$' },
+            minimo: centavos,
+          },
+        },
+      },
+    },
+    async (pedido, resposta) => {
+      const { tipo, valor, validoAte } = pedido.body
+      if (tipo === 'percentual' && valor > 100) {
+        throw new ErroDeNegocio('dados_invalidos', 'A porcentagem do cupom vai de 1 a 100', 400)
+      }
+      if (!ehDataReal(validoAte)) {
+        throw new ErroDeNegocio('dados_invalidos', `${validoAte} não é uma data`, 400)
+      }
+      const codigo = pedido.body.codigo.toUpperCase()
+      if (buscarCupom(app.banco, codigo)) {
+        throw new Conflito('codigo_em_uso', 'Já existe um cupom com esse código')
+      }
+      const cupom = inserirCupom(app.banco, { ...pedido.body, codigo }, app.agora().toISOString())
+      return resposta.code(201).send(cupom)
+    },
+  )
+}
+
+/** Se `AAAA-MM-DD` é um dia que existe: recusa `2026-13-01` e `2026-02-30`. */
+function ehDataReal(data: string): boolean {
+  const dia = new Date(`${data}T00:00:00.000Z`)
+  return !Number.isNaN(dia.getTime()) && dia.toISOString().slice(0, 10) === data
+}
