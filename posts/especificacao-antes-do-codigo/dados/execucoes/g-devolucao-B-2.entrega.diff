diff --git a/test/devolucoes.test.ts b/test/devolucoes.test.ts
new file mode 100644
index 0000000..617624b
--- /dev/null
+++ b/test/devolucoes.test.ts
@@ -0,0 +1,184 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Um pedido de 3 canecas (R$ 39,90) e 2 pires (R$ 15,00), com o estoque de cada um em 10 antes da compra. */
+async function pedidoDeExemplo(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 2 },
+    ],
+  })
+  return { pedido, caneca, pires }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number): Promise<void> {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown) {
+  return ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/devolucoes`, payload: { itens } })
+}
+
+test('um pedido novo não tem nada reembolsado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoDeExemplo(ctx)
+  assert.equal(pedido.reembolsado, 0)
+  assert.equal(pedido.canceladoEm, null)
+})
+
+test('cancela um pedido pago: o estoque volta e o total é reembolsado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, 3 * 3990 + 2 * 1500)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela pedido enviado, entregue ou já cancelado, nem mexe no estoque', async () => {
+  const ctx = montar()
+
+  const enviado = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.pedido.id}/enviar` })
+  const entregue = await pedidoDeExemplo(ctx)
+  await entregar(ctx, entregue.pedido.id)
+  const cancelado = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.pedido.id}/cancelar` })
+
+  for (const { pedido, caneca } of [enviado, entregue, cancelado]) {
+    const antes = await estoqueDe(ctx, caneca.id)
+    const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'transicao_invalida')
+    assert.equal(await estoqueDe(ctx, caneca.id), antes)
+  }
+})
+
+test('um pedido cancelado não pode mais ser enviado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })).status, 409)
+})
+
+test('devolve parte de um pedido entregue, pelo preço da compra', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.equal(corpo.reembolso, 2 * 3990)
+  assert.equal(corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+  assert.deepEqual(corpo.itens, [{ produtoId: caneca.id, quantidade: 2, precoUnitario: 3990 }])
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 2 * 3990)
+})
+
+test('várias devoluções somam no reembolsado, até devolver tudo', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  const segunda = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  assert.equal(segunda.status, 201)
+  assert.equal(segunda.corpo.reembolso, 2 * 3990 + 2 * 1500)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.reembolsado, depois.corpo.total)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const mais = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+  assert.equal(mais.status, 422)
+  assert.equal(mais.corpo.erro.codigo, 'quantidade_maior_que_a_comprada')
+})
+
+test('não aceita devolução de pedido que não foi entregue', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  const itens = [{ produtoId: caneca.id, quantidade: 1 }]
+
+  const pago = await devolver(ctx, pedido.id, itens)
+  assert.equal(pago.status, 409)
+  assert.equal(pago.corpo.erro.codigo, 'pedido_nao_entregue')
+
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })
+  assert.equal((await devolver(ctx, pedido.id, itens)).status, 409)
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+})
+
+test('recusa devolução inválida sem mexer no estoque nem no reembolsado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  const outro = await criarProduto(ctx, { nome: 'Bule' })
+  await entregar(ctx, pedido.id)
+
+  const casos: [unknown, number, string][] = [
+    [[{ produtoId: outro.id, quantidade: 1 }], 422, 'item_fora_do_pedido'],
+    [[{ produtoId: caneca.id, quantidade: 4 }], 422, 'quantidade_maior_que_a_comprada'],
+    [
+      [
+        { produtoId: caneca.id, quantidade: 1 },
+        { produtoId: caneca.id, quantidade: 1 },
+      ],
+      422,
+      'item_repetido',
+    ],
+    // O primeiro item seria aceito, mas o segundo não: nada da devolução fica gravado.
+    [
+      [
+        { produtoId: caneca.id, quantidade: 1 },
+        { produtoId: pires.id, quantidade: 3 },
+      ],
+      422,
+      'quantidade_maior_que_a_comprada',
+    ],
+    [[], 400, 'dados_invalidos'],
+    [[{ produtoId: caneca.id, quantidade: 0 }], 400, 'dados_invalidos'],
+  ]
+  for (const [itens, status, codigo] of casos) {
+    const resposta = await devolver(ctx, pedido.id, itens)
+    assert.equal(resposta.status, status, codigo)
+    assert.equal(resposta.corpo.erro.codigo, codigo)
+  }
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.reembolsado, 0)
+})
+
+test('404 para cancelar ou devolver pedido que não existe', async () => {
+  const ctx = montar()
+  assert.equal((await ctx.pedir({ method: 'POST', url: '/pedidos/7/cancelar' })).status, 404)
+  assert.equal((await devolver(ctx, 7, [{ produtoId: 1, quantidade: 1 }])).status, 404)
+})
