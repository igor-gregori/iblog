+ALTER TABLE pedidos ADD COLUMN cancelado_em TEXT;
+ALTER TABLE pedidos ADD COLUMN reembolsado INTEGER NOT NULL DEFAULT 0;
+
+CREATE TABLE devolucoes (
+  id INTEGER PRIMARY KEY,
+  pedido_id INTEGER NOT NULL REFERENCES pedidos (id),
+  reembolso INTEGER NOT NULL,
+  -- O `Idempotency-Key` da requisição, quando veio. Chaves nulas não colidem no índice único.
+  chave TEXT,
+  criada_em TEXT NOT NULL
+);
+
+CREATE TABLE itens_devolucao (
+  id INTEGER PRIMARY KEY,
+  devolucao_id INTEGER NOT NULL REFERENCES devolucoes (id),
+  produto_id INTEGER NOT NULL REFERENCES produtos (id),
+  quantidade INTEGER NOT NULL
+);
+
+CREATE UNIQUE INDEX devolucoes_por_pedido_e_chave ON devolucoes (pedido_id, chave);
+CREATE INDEX itens_devolucao_por_devolucao ON itens_devolucao (devolucao_id);
