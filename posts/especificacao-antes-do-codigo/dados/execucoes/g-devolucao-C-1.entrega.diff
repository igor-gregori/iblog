+/** Soma `valor` ao que o pedido já tem de reembolsado. */
+export function somarReembolso(banco: Banco, pedidoId: number, valor: Centavos): void {
+  banco.prepare('UPDATE pedidos SET reembolsado = reembolsado + ? WHERE id = ?').run(valor, pedidoId)
+}
+
+/** A devolução do pedido feita com esta `Idempotency-Key`, se houver. */
+export function buscarDevolucaoPorChave(banco: Banco, pedidoId: number, chave: string): Devolucao | undefined {
+  const linha = banco
+    .prepare('SELECT id, reembolso, criada_em FROM devolucoes WHERE pedido_id = ? AND chave = ?')
+    .get(pedidoId, chave) as LinhaDeDevolucao | undefined
+  return linha && paraDevolucao(banco, linha)
+}
+
+export function inserirDevolucao(
+  banco: Banco,
+  devolucao: { pedidoId: number; reembolso: Centavos; chave: string | null; criadaEm: string; itens: ItemDevolvido[] },
+): Devolucao {
+  const { lastInsertRowid } = banco
+    .prepare('INSERT INTO devolucoes (pedido_id, reembolso, chave, criada_em) VALUES (?, ?, ?, ?)')
+    .run(devolucao.pedidoId, devolucao.reembolso, devolucao.chave, devolucao.criadaEm)
+  const id = Number(lastInsertRowid)
+  const inserirItem = banco.prepare(
+    'INSERT INTO itens_devolucao (devolucao_id, produto_id, quantidade) VALUES (?, ?, ?)',
+  )
+  for (const item of devolucao.itens) {
+    inserirItem.run(id, item.produtoId, item.quantidade)
+  }
+  return { id, itens: devolucao.itens, reembolso: devolucao.reembolso, criadaEm: devolucao.criadaEm }
+}
