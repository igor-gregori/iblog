+++ b/src/pedidos/devolucoes.ts
@@ -0,0 +1,136 @@
+import { emTransacao, type Banco } from '../banco.ts'
+import { multiplicar, somar } from '../dinheiro.ts'
+import { Conflito, ErroDeNegocio, NaoEncontrado } from '../erros.ts'
+import { devolverEstoque } from '../produtos/repositorio.ts'
+import { mudarStatus } from './estados.ts'
+import {
+  buscarDevolucaoPorChave,
+  buscarPedido,
+  inserirDevolucao,
+  somarReembolso,
+  type Devolucao,
+  type ItemDevolvido,
+  type Pedido,
+} from './repositorio.ts'
+
+/** Quanto tempo depois da entrega o cliente ainda pode devolver: 7 dias, contando até o instante exato do limite. */
+export const PRAZO_DE_DEVOLUCAO_MS = 7 * 24 * 60 * 60 * 1000
+
+export type NovaDevolucao = {
+  itens: ItemDevolvido[]
+  /** O `Idempotency-Key` da requisição, se veio. */
+  chave?: string
+}
+
+/** Cancela um pedido pago: devolve todo o estoque e marca todo o total como reembolsado. */
+export function cancelarPedido(banco: Banco, pedidoId: number, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      devolverEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, pedido.total)
+    return buscarPedido(banco, pedido.id)!
+  })
+}
+
+/**
+ * Registra a devolução de itens de um pedido entregue. Com uma `chave` já usada nesse pedido para os mesmos itens,
+ * devolve a devolução de antes sem gravar nada (`repetida`).
+ */
+export function registrarDevolucao(
+  banco: Banco,
+  pedidoId: number,
+  nova: NovaDevolucao,
+  agora: Date,
+): { devolucao: Devolucao; repetida: boolean } {
+  return emTransacao(banco, () => {
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+
+    // A repetição vem antes das regras: depois da primeira, o pedido pode já estar devolvido ou fora do prazo.
+    if (nova.chave !== undefined) {
+      const anterior = buscarDevolucaoPorChave(banco, pedido.id, nova.chave)
+      if (anterior) {
+        if (!mesmosItens(anterior.itens, nova.itens)) {
+          throw new Conflito('chave_reutilizada', 'Esta Idempotency-Key já foi usada com outros itens')
+        }
+        return { devolucao: anterior, repetida: true }
+      }
+    }
+
+    conferirDevolucao(pedido, nova.itens, agora)
+
+    const precos = new Map(pedido.itens.map((item) => [item.produtoId, item.precoUnitario]))
+    const itens = nova.itens.map((item) => ({ produtoId: item.produtoId, quantidade: item.quantidade }))
+    const reembolso = somar(itens.map((item) => multiplicar(precos.get(item.produtoId)!, item.quantidade)))
+    const devolucao = inserirDevolucao(banco, {
+      pedidoId: pedido.id,
+      reembolso,
+      chave: nova.chave ?? null,
+      criadaEm: agora.toISOString(),
+      itens,
+    })
+    for (const item of itens) {
+      devolverEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, reembolso)
+
+    const devolvidos = quantidadesDevolvidas([...pedido.devolucoes, devolucao])
+    if (pedido.itens.every((item) => devolvidos.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return { devolucao, repetida: false }
+  })
+}
+
+function conferirDevolucao(pedido: Pedido, itens: ItemDevolvido[], agora: Date): void {
+  if (pedido.status === 'pago' || pedido.status === 'enviado') {
+    throw new ErroDeNegocio('pedido_nao_entregue', 'Só um pedido entregue pode ter itens devolvidos')
+  }
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('transicao_invalida', `Um pedido ${pedido.status} não pode ter itens devolvidos`)
+  }
+  if (agora.getTime() - Date.parse(pedido.entregueEm!) > PRAZO_DE_DEVOLUCAO_MS) {
+    throw new ErroDeNegocio('prazo_de_devolucao_encerrado', 'O prazo de 7 dias para devolver este pedido acabou')
+  }
+  if (new Set(itens.map((item) => item.produtoId)).size !== itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
+  const comprados = new Map(pedido.itens.map((item) => [item.produtoId, item.quantidade]))
+  const devolvidos = quantidadesDevolvidas(pedido.devolucoes)
+  for (const item of itens) {
+    const comprada = comprados.get(item.produtoId)
+    if (comprada === undefined) {
+      throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+    }
+    const jaDevolvida = devolvidos.get(item.produtoId) ?? 0
+    if (jaDevolvida + item.quantidade > comprada) {
+      throw new ErroDeNegocio(
+        'quantidade_maior_que_a_comprada',
+        `Do produto ${item.produtoId} foram comprados ${comprada} e já foram devolvidos ${jaDevolvida}`,
+      )
+    }
+  }
+}
+
+/** O total devolvido de cada produto, somando as devoluções. */
+function quantidadesDevolvidas(devolucoes: Devolucao[]): Map<number, number> {
+  const total = new Map<number, number>()
+  for (const devolucao of devolucoes) {
+    for (const item of devolucao.itens) {
+      total.set(item.produtoId, (total.get(item.produtoId) ?? 0) + item.quantidade)
+    }
+  }
+  return total
+}
+
+/** Mesmos produtos e quantidades, na mesma ordem. */
+function mesmosItens(a: ItemDevolvido[], b: ItemDevolvido[]): boolean {
+  return (
+    a.length === b.length &&
+    a.every((item, i) => item.produtoId === b[i].produtoId && item.quantidade === b[i].quantidade)
+  )
+}
