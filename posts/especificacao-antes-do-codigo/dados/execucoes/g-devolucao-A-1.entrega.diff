   itens: { produtoId: number; quantidade: number }[]
 }
 
+export type NovaDevolucao = {
+  itens: { produtoId: number; quantidade: number }[]
+}
+
 /** Cria o pedido já pago: confere cliente, produtos e estoque, baixa o estoque e registra o primeiro evento. */
 export function criarPedido(banco: Banco, novo: NovoPedido, agora: Date): Pedido {
   if (!buscarCliente(banco, novo.clienteId)) {
@@ -38,3 +52,52 @@ export function criarPedido(banco: Banco, novo: NovoPedido, agora: Date): Pedido
     return buscarPedido(banco, id)!
   })
 }
+
+/** Cancela um pedido que ainda não foi enviado: o estoque de todos os itens volta e o total é reembolsado. */
+export function cancelarPedido(banco: Banco, pedido: Pedido, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    return buscarPedido(banco, pedido.id)!
+  })
+}
+
+/**
+ * Registra a devolução de itens de um pedido entregue: o estoque volta e o cliente recebe o que pagou por eles. Um
+ * pedido pode ter várias devoluções, mas nunca mais unidades devolvidas do que compradas.
+ */
+export function devolverItens(banco: Banco, pedido: Pedido, nova: NovaDevolucao, agora: Date): Devolucao {
+  if (pedido.status !== 'entregue') {
+    throw new Conflito(
+      'pedido_nao_entregue',
+      `Só é possível devolver itens de um pedido entregue; este está ${pedido.status}`,
+    )
+  }
+  const produtos = new Set(nova.itens.map((item) => item.produtoId))
+  if (produtos.size !== nova.itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
+
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está neste pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_maior_que_a_comprada',
+          `Do produto ${item.produtoId}, ainda podem ser devolvidas ${restante} unidade(s)`,
+        )
+      }
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    return inserirDevolucao(banco, { pedidoId: pedido.id, itens, reembolso, criadaEm: agora.toISOString() })
+  })
+}
