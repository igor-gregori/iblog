+import { Conflito, ErroDeNegocio } from '../erros.ts'
+import { baixarEstoque, buscarProduto, precoDeVenda, reporEstoque } from '../produtos/repositorio.ts'
+import { mudarStatus } from './estados.ts'
+import {
+  buscarPedido,
