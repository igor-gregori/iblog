+/** Cancela um pedido que ainda não foi enviado: o estoque volta e o total inteiro é reembolsado. */
+export function cancelarPedido(banco: Banco, pedidoId: number, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    return buscarPedido(banco, pedidoId)!
+  })
+}
+
+/** O cliente tem este prazo, contado da entrega, para devolver. */
+const DIAS_PARA_DEVOLVER = 7
+
+const UM_DIA_EM_MS = 24 * 60 * 60 * 1000
+
+/** Os mesmos produtos nas mesmas quantidades, em qualquer ordem. */
+function mesmosItens(a: ItemPedido[], b: ItemPedido[]): boolean {
+  const chave = (itens: ItemPedido[]) =>
+    itens
+      .map((item) => `${item.produtoId}:${item.quantidade}`)
+      .sort()
+      .join(',')
+  return chave(a) === chave(b)
+}
+
+/** Quanto de cada produto do pedido já foi devolvido, somando todas as devoluções. */
+function quantidadesDevolvidas(pedido: Pedido): Map<number, number> {
+  const devolvidas = new Map<number, number>()
+  for (const devolucao of pedido.devolucoes) {
+    for (const item of devolucao.itens) {
+      devolvidas.set(item.produtoId, (devolvidas.get(item.produtoId) ?? 0) + item.quantidade)
+    }
+  }
+  return devolvidas
+}
