+test('o pedido lista as devoluções e soma os reembolsos', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  ctx.relogio.avancarDias(1)
+  const segunda = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+
+  const { corpo } = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.deepEqual(corpo.devolucoes, [primeira.corpo, segunda.corpo])
+  assert.deepEqual(corpo.devolucoes[1].itens, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(corpo.reembolsado, 2 * 3990 + 1500)
+  assert.equal(corpo.status, 'entregue')
+})
