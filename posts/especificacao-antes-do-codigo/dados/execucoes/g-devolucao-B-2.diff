+test('recusa devolução inválida sem mexer no estoque nem no reembolsado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  const outro = await criarProduto(ctx, { nome: 'Bule' })
+  await entregar(ctx, pedido.id)
+
+  const casos: [unknown, number, string][] = [
+    [[{ produtoId: outro.id, quantidade: 1 }], 422, 'item_fora_do_pedido'],
+    [[{ produtoId: caneca.id, quantidade: 4 }], 422, 'quantidade_maior_que_a_comprada'],
+    [
+      [
+        { produtoId: caneca.id, quantidade: 1 },
+        { produtoId: caneca.id, quantidade: 1 },
+      ],
+      422,
+      'item_repetido',
+    ],
+    // O primeiro item seria aceito, mas o segundo não: nada da devolução fica gravado.
+    [
+      [
+        { produtoId: caneca.id, quantidade: 1 },
+        { produtoId: pires.id, quantidade: 3 },
+      ],
+      422,
+      'quantidade_maior_que_a_comprada',
+    ],
+    [[], 400, 'dados_invalidos'],
+    [[{ produtoId: caneca.id, quantidade: 0 }], 400, 'dados_invalidos'],
+  ]
+  for (const [itens, status, codigo] of casos) {
+    const resposta = await devolver(ctx, pedido.id, itens)
+    assert.equal(resposta.status, status, codigo)
+    assert.equal(resposta.corpo.erro.codigo, codigo)
+  }
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.reembolsado, 0)
+})
