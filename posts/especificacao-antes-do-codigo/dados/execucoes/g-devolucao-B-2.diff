+test('devolução depois de 7 dias da entrega é recusada', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const itens = [{ produtoId: caneca.id, quantidade: 1 }]
