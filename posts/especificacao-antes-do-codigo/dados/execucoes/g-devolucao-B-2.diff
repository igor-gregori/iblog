+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 2 },
+    ],
+  })
+  return { pedido, caneca, pires }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number): Promise<void> {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown) {
+  return ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/devolucoes`, payload: { itens } })
+}
+
+test('um pedido novo não tem nada reembolsado', async () => {
