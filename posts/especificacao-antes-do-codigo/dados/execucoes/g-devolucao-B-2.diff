+ * volta e cada unidade é reembolsada pelo preço da compra. Um pedido pode ter várias devoluções, mas nunca mais
+ * unidades devolvidas do que compradas; quando tudo volta, o pedido passa para devolvido.
+ *
+ * Com uma `chaveDeIdempotencia` já usada neste pedido, não registra nada de novo: devolve a devolução original
+ * (`repetida: true`), ou recusa se o corpo for outro.
+ */
+export function registrarDevolucao(
+  banco: Banco,
+  pedidoId: number,
+  itens: ItemPedido[],
+  chaveDeIdempotencia: string | null,
+  agora: Date,
+): { devolucao: Devolucao; repetida: boolean } {
+  recusarItemRepetido(itens, 'Cada produto aparece uma vez só na devolução; use a quantidade')
+
+  const criadaEm = agora.toISOString()
+  return emTransacao(banco, () => {
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+
+    if (chaveDeIdempotencia !== null) {
+      const anterior = buscarDevolucaoPelaChave(banco, pedido.id, chaveDeIdempotencia)
+      if (anterior) {
+        if (!mesmosItens(anterior.itens, itens)) {
+          throw new Conflito(
+            'chave_de_idempotencia_reutilizada',
+            'Esta Idempotency-Key já foi usada numa devolução com outros itens',
+          )
+        }
+        return { devolucao: anterior, repetida: true }
+      }
+    }
+
+    if (pedido.status !== 'entregue') {
+      throw new Conflito('pedido_nao_entregue', `Um pedido ${pedido.status} não pode ter devolução`)
+    }
+    const prazo = new Date(pedido.entregueEm!).getTime() + DIAS_PARA_DEVOLVER * UM_DIA_EM_MS
+    if (agora.getTime() > prazo) {
+      throw new ErroDeNegocio(
+        'prazo_de_devolucao_encerrado',
+        `A devolução só pode ser feita até ${DIAS_PARA_DEVOLVER} dias depois da entrega`,
+      )
+    }
+
+    const devolvidas = quantidadesDevolvidas(pedido)
+    const devolvendo: ItemDoPedido[] = itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_maior_que_a_comprada',
+          `Do produto ${item.produtoId}, só ${restante} unidade(s) ainda podem ser devolvidas`,
+        )
+      }
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(devolvendo.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const id = inserirDevolucao(banco, {
+      pedidoId: pedido.id,
+      itens: devolvendo,
+      reembolso,
+      criadaEm,
+      chaveDeIdempotencia,
+    })
+    for (const item of devolvendo) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      devolvidas.set(item.produtoId, (devolvidas.get(item.produtoId) ?? 0) + item.quantidade)
+    }
+    if (pedido.itens.every((item) => devolvidas.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return { devolucao: buscarDevolucao(banco, id)!, repetida: false }
+  })
+}
