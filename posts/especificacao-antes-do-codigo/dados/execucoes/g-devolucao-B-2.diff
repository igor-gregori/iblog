+test('cancela um pedido pago: o estoque volta e o total é reembolsado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, 3 * 3990 + 2 * 1500)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela pedido enviado, entregue ou já cancelado, nem mexe no estoque', async () => {
+  const ctx = montar()
+
+  const enviado = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.pedido.id}/enviar` })
+  const entregue = await pedidoDeExemplo(ctx)
+  await entregar(ctx, entregue.pedido.id)
+  const cancelado = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.pedido.id}/cancelar` })
+
+  for (const { pedido, caneca } of [enviado, entregue, cancelado]) {
+    const antes = await estoqueDe(ctx, caneca.id)
+    const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'transicao_invalida')
+    assert.equal(await estoqueDe(ctx, caneca.id), antes)
+  }
+})
+
+test('um pedido cancelado não pode mais ser enviado', async () => {
