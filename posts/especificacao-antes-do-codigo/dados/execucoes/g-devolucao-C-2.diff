--- /dev/null
+++ b/test/devolucoes.test.ts
@@ -0,0 +1,232 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Uma caneca (2 por R$ 50,00) e um pires (1 por R$ 15,00), num pedido já entregue. */
+async function pedidoEntregue(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 5000, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 2 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+  })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/entregar` })
+  return { pedido, caneca, pires }
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown[], chave?: string) {
+  return ctx.pedir({
+    method: 'POST',
+    url: `/pedidos/${pedidoId}/devolucoes`,
+    payload: { itens },
+    headers: chave === undefined ? {} : { 'idempotency-key': chave },
+  })
+}
+
+test('devolve parte de um pedido entregue: estoque volta e o reembolso é pelo preço da compra', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, {
+    id: corpo.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    reembolso: 5000,
+    criadaEm: '2026-03-01T12:00:00.000Z',
+  })
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+
+  const depois = (await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo
+  assert.equal(depois.status, 'entregue')
+  assert.equal(depois.reembolsado, 5000)
+  assert.deepEqual(depois.devolucoes, [corpo])
+})
+
+test('os itens da devolução saem na ordem em que vieram', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+  const itens = [
+    { produtoId: pires.id, quantidade: 1 },
+    { produtoId: caneca.id, quantidade: 1 },
+  ]
+  const { corpo } = await devolver(ctx, pedido.id, itens)
+  assert.deepEqual(corpo.itens, itens)
+  assert.equal(corpo.reembolso, 1500 + 5000)
+})
+
+test('devoluções parciais se somam e, quando tudo voltou, o pedido fica devolvido', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+  ctx.relogio.avancarDias(1)
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(demais.status, 422)
