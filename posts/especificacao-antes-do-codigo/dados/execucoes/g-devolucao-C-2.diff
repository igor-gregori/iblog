index 0000000..08faa8b
--- /dev/null
+++ b/src/pedidos/devolucoes.ts
@@ -0,0 +1,134 @@
+import { emTransacao, type Banco } from '../banco.ts'
+import { multiplicar, somar } from '../dinheiro.ts'
+import { Conflito, ErroDeNegocio, NaoEncontrado } from '../erros.ts'
+import { devolverEstoque } from '../produtos/repositorio.ts'
+import { mudarStatus } from './estados.ts'
+import {
+  buscarDevolucao,
+  buscarDevolucaoPorChave,
+  buscarPedido,
+  inserirDevolucao,
+  somarReembolso,
+  type Devolucao,
+  type ItemDevolvido,
+  type Pedido,
+} from './repositorio.ts'
+
+/** Quanto tempo depois da entrega o cliente ainda pode devolver: 7 dias, contando até o instante exato do limite. */
+const PRAZO_DE_DEVOLUCAO_EM_MS = 168 * 60 * 60 * 1000
+
+/** Cancela um pedido pago: devolve todos os itens ao estoque (mesmo de produto desativado) e reembolsa o total. */
+export function cancelarPedido(banco: Banco, pedidoId: number, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      devolverEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, pedido.total - pedido.reembolsado)
+    return buscarPedido(banco, pedido.id)!
+  })
+}
+
+export type NovaDevolucao = {
+  itens: ItemDevolvido[]
+  /** O `Idempotency-Key` da requisição, se veio. */
+  chave: string | null
+}
+
+/**
+ * Registra a devolução de itens de um pedido entregue: devolve o estoque, soma o reembolso (pelo preço da compra) e,
+ * se com ela todos os itens voltaram, passa o pedido para devolvido. Com uma `chave` já usada nesse pedido para os
+ * mesmos itens, devolve a devolução de antes sem gravar nada (`nova` é `false`).
+ */
+export function registrarDevolucao(
+  banco: Banco,
+  pedidoId: number,
+  nova: NovaDevolucao,
+  agora: Date,
+): { devolucao: Devolucao; nova: boolean } {
+  return emTransacao(banco, () => {
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+
+    if (nova.chave !== null) {
+      const anterior = buscarDevolucaoPorChave(banco, pedido.id, nova.chave)
+      if (anterior) {
+        if (!mesmosItens(anterior.itens, nova.itens)) {
+          throw new Conflito('chave_reutilizada', 'Esta Idempotency-Key já foi usada numa devolução com outros itens')
+        }
+        return { devolucao: anterior, nova: false }
+      }
+    }
+
+    if (pedido.status === 'cancelado' || pedido.status === 'devolvido') {
+      throw new Conflito('transicao_invalida', `Um pedido ${pedido.status} não aceita devolução`)
+    }
+    if (pedido.status !== 'entregue') {
+      throw new ErroDeNegocio('pedido_nao_entregue', 'Só um pedido entregue aceita devolução')
+    }
+    const limite = new Date(pedido.entregueEm!).getTime() + PRAZO_DE_DEVOLUCAO_EM_MS
+    if (agora.getTime() > limite) {
+      throw new ErroDeNegocio('prazo_de_devolucao_encerrado', 'O prazo de 7 dias para devolver já acabou')
+    }
+    const produtos = new Set(nova.itens.map((item) => item.produtoId))
+    if (produtos.size !== nova.itens.length) {
+      throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+    }
+
+    const jaDevolvido = quantidadesDevolvidas(pedido)
+    const reembolsos = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const devolvido = jaDevolvido.get(item.produtoId) ?? 0
+      if (devolvido + item.quantidade > comprado.quantidade) {
+        throw new ErroDeNegocio(
+          'quantidade_maior_que_a_comprada',
+          `Do produto ${item.produtoId} foram comprados ${comprado.quantidade} e já devolvidos ${devolvido}`,
+        )
+      }
+      return multiplicar(comprado.precoUnitario, item.quantidade)
+    })
+    const reembolso = somar(reembolsos)
+
+    const id = inserirDevolucao(banco, {
+      pedidoId: pedido.id,
+      reembolso,
+      chave: nova.chave,
+      criadaEm: agora.toISOString(),
+      itens: nova.itens,
+    })
+    for (const item of nova.itens) {
+      devolverEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, reembolso)
+
+    const depois = buscarPedido(banco, pedido.id)!
+    const devolvidoDepois = quantidadesDevolvidas(depois)
+    if (depois.itens.every((item) => devolvidoDepois.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, depois, 'devolvido', agora)
+    }
+    return { devolucao: buscarDevolucao(banco, id)!, nova: true }
+  })
+}
+
+/** Quanto de cada produto já voltou, somando todas as devoluções do pedido. */
+function quantidadesDevolvidas(pedido: Pedido): Map<number, number> {
+  const devolvidas = new Map<number, number>()
+  for (const devolucao of pedido.devolucoes) {
+    for (const item of devolucao.itens) {
+      devolvidas.set(item.produtoId, (devolvidas.get(item.produtoId) ?? 0) + item.quantidade)
+    }
+  }
+  return devolvidas
+}
+
+function mesmosItens(a: ItemDevolvido[], b: ItemDevolvido[]): boolean {
+  return (
+    a.length === b.length &&
+    a.every((item, i) => item.produtoId === b[i].produtoId && item.quantidade === b[i].quantidade)
+  )
+}
