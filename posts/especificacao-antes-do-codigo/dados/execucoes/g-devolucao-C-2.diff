 }
+
+export function somarReembolso(banco: Banco, pedidoId: number, valor: Centavos): void {
+  banco.prepare('UPDATE pedidos SET reembolsado = reembolsado + ? WHERE id = ?').run(valor, pedidoId)
+}
+
+type LinhaDeDevolucao = {
+  id: number
+  reembolso: number
+  criada_em: string
+}
+
+type LinhaDeItemDevolvido = {
+  produto_id: number
+  quantidade: number
+}
+
+function paraDevolucao(banco: Banco, linha: LinhaDeDevolucao): Devolucao {
+  const itens = banco
+    .prepare('SELECT produto_id, quantidade FROM itens_devolucao WHERE devolucao_id = ? ORDER BY id')
+    .all(linha.id) as LinhaDeItemDevolvido[]
+  return {
+    id: linha.id,
+    itens: itens.map((item) => ({ produtoId: item.produto_id, quantidade: item.quantidade })),
+    reembolso: linha.reembolso,
+    criadaEm: linha.criada_em,
+  }
+}
+
+/** As devoluções do pedido, em ordem de criação. */
+export function devolucoesDoPedido(banco: Banco, pedidoId: number): Devolucao[] {
+  const linhas = banco
+    .prepare('SELECT id, reembolso, criada_em FROM devolucoes WHERE pedido_id = ? ORDER BY id')
+    .all(pedidoId) as LinhaDeDevolucao[]
+  return linhas.map((linha) => paraDevolucao(banco, linha))
+}
+
+export function buscarDevolucao(banco: Banco, id: number): Devolucao | undefined {
+  const linha = banco.prepare('SELECT id, reembolso, criada_em FROM devolucoes WHERE id = ?').get(id) as
+    | LinhaDeDevolucao
+    | undefined
+  return linha && paraDevolucao(banco, linha)
+}
+
+/** A devolução do pedido feita com esta `Idempotency-Key`, se houver. */
+export function buscarDevolucaoPorChave(banco: Banco, pedidoId: number, chave: string): Devolucao | undefined {
+  const linha = banco
+    .prepare('SELECT id, reembolso, criada_em FROM devolucoes WHERE pedido_id = ? AND chave = ?')
+    .get(pedidoId, chave) as LinhaDeDevolucao | undefined
+  return linha && paraDevolucao(banco, linha)
+}
+
+export function inserirDevolucao(
+  banco: Banco,
+  devolucao: { pedidoId: number; reembolso: Centavos; chave: string | null; criadaEm: string; itens: ItemDevolvido[] },
+): number {
+  const { lastInsertRowid } = banco
+    .prepare('INSERT INTO devolucoes (pedido_id, reembolso, chave, criada_em) VALUES (?, ?, ?, ?)')
+    .run(devolucao.pedidoId, devolucao.reembolso, devolucao.chave, devolucao.criadaEm)
+  const id = Number(lastInsertRowid)
+  const inserirItem = banco.prepare('INSERT INTO itens_devolucao (devolucao_id, produto_id, quantidade) VALUES (?, ?, ?)')
+  for (const item of devolucao.itens) {
+    inserirItem.run(id, item.produtoId, item.quantidade)
+  }
+  return id
+}
