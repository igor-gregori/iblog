+    clienteId: cliente.id,
+    cupom: 'DEZ',
+    itens: [{ produtoId: caneca.id, quantidade: 2 }],
+  })
+  assert.equal(igual.status, 201)
+  assert.equal(igual.corpo.desconto, 798)
+})
