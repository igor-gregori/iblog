+async function pedidoMisto(ctx: Contexto, cupom: Record<string, unknown>) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 1000 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 3000, precoPromocional: 2000 })
+  await criarCupom(ctx, { codigo: 'C', ...cupom })
+  return criarPedido(ctx, {
+    clienteId: cliente.id,
+    cupom: 'C',
+    itens: [
+      { produtoId: caneca.id, quantidade: 1 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+  })
+}
+
+test('itens em promoção não recebem o desconto do percentual', async () => {
+  const ctx = montar()
+  const { status, corpo } = await pedidoMisto(ctx, { tipo: 'percentual', valor: 10 })
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3000)
+  assert.equal(corpo.desconto, 100)
+  assert.equal(corpo.total, 2900)
+})
+
+test('o desconto fixo não passa do valor dos itens fora de promoção', async () => {
+  const ctx = montar()
+  const { corpo } = await pedidoMisto(ctx, { tipo: 'fixo', valor: 5000 })
+  assert.equal(corpo.subtotal, 3000)
+  assert.equal(corpo.desconto, 1000)
+  assert.equal(corpo.total, 2000)
+})
