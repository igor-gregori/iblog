@@ -0,0 +1,285 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarCupom, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+function cadastrar(ctx: Contexto, payload: Record<string, unknown>) {
+  return ctx.pedir({ method: 'POST', url: '/cupons', payload })
+}
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Uma caneca, e uma função que faz um pedido de `quantidade` canecas com o cupom, cada vez de um cliente novo. */
+async function preparar(ctx: Contexto, produto: Record<string, unknown> = {}) {
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 100, ...produto })
+  return async (cupom: string | undefined, quantidade = 1) => {
+    const cliente = await criarCliente(ctx)
+    return criarPedido(ctx, { clienteId: cliente.id, cupom, itens: [{ produtoId: caneca.id, quantidade }] })
+  }
+}
+
+test('cadastra um cupom, guardando o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await cadastrar(ctx, {
+    codigo: 'natal-10',
+    tipo: 'percentual',
+    valor: 10,
+    validoAte: '2026-12-25',
+    minimo: 5000,
+  })
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, {
+    id: corpo.id,
+    codigo: 'NATAL-10',
+    tipo: 'percentual',
+    valor: 10,
+    validoAte: '2026-12-25',
+    minimo: 5000,
+  })
+})
+
+test('o mínimo é zero quando não vem', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx)
+  assert.equal(cupom.minimo, 0)
+})
+
+test('recusa código repetido, mesmo com outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ' })
+  const { status, corpo } = await cadastrar(ctx, { codigo: 'dez', tipo: 'fixo', valor: 500, validoAte: '2026-03-31' })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'cupom_ja_existe')
+})
+
+test('recusa cupom malformado com 400, inclusive porcentagem acima de 100', async () => {
+  const ctx = montar()
+  const valido = { codigo: 'DEZ', tipo: 'percentual', valor: 10, validoAte: '2026-03-31' }
+  const casos: Record<string, unknown>[] = [
+    { ...valido, tipo: 'brinde' },
+    { ...valido, valor: 0 },
+    { ...valido, valor: 101 },
+    { ...valido, valor: 2.5 },
+    { ...valido, validoAte: '31/03/2026' },
+    { ...valido, validoAte: '2026-02-31' },
+    { ...valido, codigo: 'com espaço' },
+    { ...valido, minimo: -1 },
+    { tipo: 'fixo', valor: 10, validoAte: '2026-03-31' },
+  ]
+  for (const payload of casos) {
+    assert.equal((await cadastrar(ctx, payload)).status, 400, JSON.stringify(payload))
+  }
+  assert.equal((await cadastrar(ctx, { ...valido, valor: 100 })).status, 201)
+  assert.equal((await cadastrar(ctx, { ...valido, codigo: 'FIXO', tipo: 'fixo', valor: 10000 })).status, 201)
+})
+
+test('aceita cadastrar um cupom com validade já passada', async () => {
