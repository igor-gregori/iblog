@@ -0,0 +1,55 @@
+import type { Banco } from '../banco.ts'
+import type { Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  /** A porcentagem (de 1 a 100), se o cupom é percentual; o valor em centavos, se é fixo. */
+  valor: number
+  /** O último dia em que o cupom vale, `AAAA-MM-DD`, no horário de Brasília. */
+  validoAte: string
+  /** O subtotal mínimo do pedido para o cupom valer. */
+  minimo: Centavos
+}
+
+export type NovoCupom = Omit<Cupom, 'id' | 'minimo'> & { minimo?: Centavos }
+
+type Linha = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  valido_ate: string
+  minimo: number
+}
+
+function paraCupom(linha: Linha): Cupom {
+  return {
+    id: linha.id,
+    codigo: linha.codigo,
+    tipo: linha.tipo,
+    valor: linha.valor,
+    validoAte: linha.valido_ate,
+    minimo: linha.minimo,
+  }
+}
+
+export function buscarCupom(banco: Banco, id: number): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE id = ?').get(id) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+export function buscarCupomPorCodigo(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE codigo = ?').get(codigo) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+export function inserirCupom(banco: Banco, novo: NovoCupom, criadoEm: string): Cupom {
+  const { lastInsertRowid } = banco
+    .prepare('INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(novo.codigo, novo.tipo, novo.valor, novo.validoAte, novo.minimo ?? 0, criadoEm)
+  return buscarCupom(banco, Number(lastInsertRowid))!
+}
