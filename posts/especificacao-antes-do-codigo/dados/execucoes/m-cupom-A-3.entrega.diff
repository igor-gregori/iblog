diff --git a/test/cupons.test.ts b/test/cupons.test.ts
new file mode 100644
index 0000000..4e10dbc
--- /dev/null
+++ b/test/cupons.test.ts
@@ -0,0 +1,165 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'BEMVINDO', tipo: 'percentual', valor: 10, validoAte: '2026-03-31', minimo: 0, ...dados },
+  })
+  if (status !== 201) throw new Error(`não criou o cupom: ${JSON.stringify(corpo)}`)
+  return corpo
+}
+
+/** Um cliente e um produto de R$ 100,00, prontos para um pedido. */
+async function preparar(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco: 10000, estoque: 10 })
+  return (cupom?: string, quantidade = 1) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom })
+}
+
+test('cadastra um cupom, guardando o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'natal10', tipo: 'fixo', valor: 1500, validoAte: '2026-12-25', minimo: 5000 },
+  })
+  assert.equal(status, 201)
+  assert.deepEqual(
+    { ...corpo, id: undefined },
+    { id: undefined, codigo: 'NATAL10', tipo: 'fixo', valor: 1500, validoAte: '2026-12-25', minimo: 5000 },
+  )
+})
+
+test('recusa código repetido, mesmo com outras maiúsculas', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'BEMVINDO' })
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'bemvindo', tipo: 'fixo', valor: 100, validoAte: '2026-03-31' },
+  })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa cupom malformado e percentual acima de 100', async () => {
+  const ctx = montar()
+  const base = { codigo: 'X', tipo: 'fixo', valor: 100, validoAte: '2026-03-31' }
+  const malformados = [
+    { ...base, tipo: 'brinde' },
+    { ...base, valor: 0 },
+    { ...base, validoAte: '31/03/2026' },
+    { ...base, validoAte: '2026-02-30' },
+    { ...base, codigo: 'com espaço' },
+    { ...base, minimo: -1 },
+  ]
+  for (const payload of malformados) {
+    assert.equal((await ctx.pedir({ method: 'POST', url: '/cupons', payload })).status, 400, JSON.stringify(payload))
+  }
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { ...base, tipo: 'percentual', valor: 101 },
+  })
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'percentual_invalido')
+})
+
+test('pedido sem cupom tem desconto zero', async () => {
+  const ctx = montar()
+  const pedir = await preparar(ctx)
+  const { corpo } = await pedir()
+  assert.equal(corpo.subtotal, 10000)
+  assert.equal(corpo.desconto, 0)
+  assert.equal(corpo.total, 10000)
+  assert.equal(corpo.cupom, null)
+})
+
+test('cupom percentual desconta a porcentagem do subtotal, arredondando para baixo', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco: 3999 })
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: produto.id, quantidade: 1 }],
+    cupom: 'dez',
+  })
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3999)
+  assert.equal(corpo.desconto, 399)
+  assert.equal(corpo.total, 3600)
+  assert.equal(corpo.cupom, 'DEZ')
+})
+
+test('cupom fixo desconta o valor, mas nunca mais que o subtotal', async () => {
+  const ctx = montar()
+  const pedir = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'QUINZE', tipo: 'fixo', valor: 1500 })
+  await criarCupom(ctx, { codigo: 'TUDO', tipo: 'fixo', valor: 50000 })
+
+  const quinze = await pedir('QUINZE')
+  assert.deepEqual([quinze.corpo.subtotal, quinze.corpo.desconto, quinze.corpo.total], [10000, 1500, 8500])
+
+  const tudo = await pedir('TUDO')
+  assert.deepEqual([tudo.corpo.subtotal, tudo.corpo.desconto, tudo.corpo.total], [10000, 10000, 0])
+})
+
+test('o pedido guarda o desconto: aparece na busca e na lista', async () => {
+  const ctx = montar()
+  const pedir = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'DEZ', valor: 10 })
+  const { corpo: criado } = await pedir('DEZ')
+
+  const buscado = await ctx.pedir({ method: 'GET', url: `/pedidos/${criado.id}` })
+  assert.deepEqual(buscado.corpo, criado)
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${criado.clienteId}` })
+  assert.deepEqual(lista.corpo.itens, [criado])
+})
+
+test('recusa cupom abaixo do mínimo, sem baixar o estoque', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco: 10000, estoque: 10 })
+  await criarCupom(ctx, { codigo: 'GRANDE', minimo: 20000 })
+
+  const pedir = (quantidade: number) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom: 'GRANDE' })
+  const abaixo = await pedir(1)
+  assert.equal(abaixo.status, 422)
+  assert.equal(abaixo.corpo.erro.codigo, 'cupom_abaixo_do_minimo')
+  assert.match(abaixo.corpo.erro.mensagem, /R\$ 200,00/)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/produtos/${produto.id}` })).corpo.estoque, 10)
+
+  const noMinimo = await pedir(2)
+  assert.equal(noMinimo.status, 201)
+  assert.equal(noMinimo.corpo.desconto, 2000)
+})
+
+test('o cupom vale até o fim do dia de validade, no horário de Brasília', async () => {
+  const ctx = montar()
+  const pedir = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'MARCO', validoAte: '2026-03-01' })
+
+  // 1º de março, 23h59 em Brasília (02h59 do dia 2 em UTC): ainda vale.
+  ctx.relogio.atual = new Date('2026-03-02T02:59:00Z')
+  assert.equal((await pedir('MARCO')).status, 201)
+
+  // 2 de março, 00h01 em Brasília: venceu.
+  ctx.relogio.atual = new Date('2026-03-02T03:01:00Z')
+  const vencido = await pedir('MARCO')
+  assert.equal(vencido.status, 422)
+  assert.equal(vencido.corpo.erro.codigo, 'cupom_expirado')
+})
+
+test('recusa cupom que não existe', async () => {
+  const ctx = montar()
+  const pedir = await preparar(ctx)
+  const { status, corpo } = await pedir('NAOEXISTE')
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_inexistente')
+})
