+import { formatar, type Centavos } from '../dinheiro.ts'
+import { ErroDeNegocio } from '../erros.ts'
+import type { Cupom } from './repositorio.ts'
+
+/** Os códigos não diferenciam maiúsculas: `natal10` e `NATAL10` são o mesmo cupom. */
+export function normalizarCodigo(codigo: string): string {
+  return codigo.trim().toUpperCase()
+}
+
+/** O dia de `agora` no horário de Brasília, `AAAA-MM-DD`: é nele que a validade do cupom é contada. */
+export function diaEmBrasilia(agora: Date): string {
+  return agora.toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' })
+}
+
+/**
+ * O desconto que o cupom dá num pedido de `subtotal`. Recusa o cupom vencido ou abaixo do mínimo. O percentual é
+ * arredondado para baixo, e o desconto nunca passa do subtotal.
+ */
+export function calcularDesconto(cupom: Cupom, subtotal: Centavos, agora: Date): Centavos {
+  if (diaEmBrasilia(agora) > cupom.validoAte) {
+    throw new ErroDeNegocio('cupom_expirado', `O cupom ${cupom.codigo} venceu em ${cupom.validoAte}`)
+  }
+  if (subtotal < cupom.minimo) {
+    throw new ErroDeNegocio(
+      'cupom_abaixo_do_minimo',
+      `O cupom ${cupom.codigo} vale para pedidos a partir de ${formatar(cupom.minimo)}`,
+    )
+  }
+  const desconto = cupom.tipo === 'percentual' ? Math.floor((subtotal * cupom.valor) / 100) : cupom.valor
+  return Math.min(desconto, subtotal)
+}
