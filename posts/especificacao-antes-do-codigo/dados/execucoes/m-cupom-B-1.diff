+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { test } from 'node:test'
+import { migrar } from '../src/banco.ts'
+
+const PASTA_DE_MIGRACOES = join(import.meta.dirname, '..', 'src', 'migracoes')
+
+test('a migração de cupons mantém o total dos pedidos antigos como subtotal, sem desconto', () => {
+  const banco = new DatabaseSync(':memory:')
+  banco.exec('CREATE TABLE migracoes (nome TEXT PRIMARY KEY, aplicada_em TEXT NOT NULL)')
+  banco.exec(readFileSync(join(PASTA_DE_MIGRACOES, '001_inicial.sql'), 'utf8'))
+  banco.prepare("INSERT INTO migracoes (nome, aplicada_em) VALUES ('001_inicial.sql', 'antes')").run()
+  banco.exec("INSERT INTO clientes (id, nome, email, criado_em) VALUES (1, 'Ana', 'ana@exemplo.com', 'antes')")
+  banco.exec("INSERT INTO pedidos (id, cliente_id, status, total, criado_em) VALUES (1, 1, 'pago', 3990, 'antes')")
+
+  migrar(banco)
+
+  assert.deepEqual({ ...banco.prepare('SELECT subtotal, desconto, total, cupom_id FROM pedidos').get() }, {
+    subtotal: 3990,
+    desconto: 0,
+    total: 3990,
+    cupom_id: null,
+  })
+})
