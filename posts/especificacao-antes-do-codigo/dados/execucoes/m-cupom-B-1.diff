diff --git a/test/cupons.test.ts b/test/cupons.test.ts
new file mode 100644
index 0000000..d45786f
--- /dev/null
+++ b/test/cupons.test.ts
@@ -0,0 +1,238 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+// O relógio dos testes começa em 2026-03-01T12:00:00Z.
+
+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  return ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-03-31', ...dados },
+  })
+}
+
+/** Um cliente e um produto com o preço dado, prontos para um pedido. */
+async function preparar(ctx: Contexto, preco = 3990) {
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco, estoque: 10 })
+  const pedir = (cupom?: string, quantidade = 1) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom })
+  return { cliente, produto, pedir }
+}
+
+test('cadastra um cupom', async () => {
+  const ctx = montar()
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'natal10', minimo: 5000 })
+  assert.equal(status, 201)
+  assert.equal(corpo.codigo, 'NATAL10')
+  assert.equal(corpo.tipo, 'percentual')
+  assert.equal(corpo.valor, 10)
+  assert.equal(corpo.validoAte, '2026-03-31')
+  assert.equal(corpo.minimo, 5000)
+})
+
+test('o mínimo do cupom é 0 se não vier', async () => {
+  const ctx = montar()
+  assert.equal((await criarCupom(ctx)).corpo.minimo, 0)
+})
+
+test('recusa código repetido, mesmo em outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx)
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'natal10' })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa cupom malformado', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { tipo: 'brinde' },
+    { validoAte: '31/03/2026' },
+    { validoAte: '2026-02-30' },
+    { valor: 0 },
+    { valor: 101 },
+    { valor: 10.5 },
+    { tipo: 'fixo', valor: 0 },
+    { codigo: 'com espaço' },
+    { minimo: -1 },
+  ]
+  for (const dados of casos) {
+    assert.equal((await criarCupom(ctx, dados)).status, 400, JSON.stringify(dados))
+  }
+})
+
+test('o teto de 100 vale só para o percentual; cupom já vencido pode ser cadastrado', async () => {
+  const ctx = montar()
+  assert.equal((await criarCupom(ctx, { codigo: 'CEM', valor: 100 })).status, 201)
+  assert.equal((await criarCupom(ctx, { codigo: 'FIXO', tipo: 'fixo', valor: 10000 })).status, 201)
+  assert.equal((await criarCupom(ctx, { codigo: 'VELHO', validoAte: '2026-02-28' })).status, 201)
+})
+
+test('aplica um cupom percentual, arredondando o desconto para baixo', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', valor: 10 })
+  await criarCupom(ctx, { codigo: 'QUINZE', valor: 15 })
+  const { pedir } = await preparar(ctx, 3333)
+
+  const dez = await pedir('DEZ')
+  assert.equal(dez.status, 201)
+  assert.equal(dez.corpo.subtotal, 3333)
+  assert.equal(dez.corpo.desconto, 333)
+  assert.equal(dez.corpo.total, 3000)
+  assert.equal(dez.corpo.cupom, 'DEZ')
+
+  const quinze = await pedir('QUINZE')
+  assert.equal(quinze.corpo.desconto, 499)
+  assert.equal(quinze.corpo.total, 2834)
+})
+
+test('aplica um cupom fixo, sem passar do subtotal', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'MENOS10', tipo: 'fixo', valor: 1000 })
+  await criarCupom(ctx, { codigo: 'MENOS100', tipo: 'fixo', valor: 10000 })
+  const { pedir } = await preparar(ctx, 3990)
+
+  const dez = await pedir('MENOS10')
+  assert.equal(dez.corpo.subtotal, 3990)
+  assert.equal(dez.corpo.desconto, 1000)
+  assert.equal(dez.corpo.total, 2990)
+
+  const cem = await pedir('MENOS100')
+  assert.equal(cem.corpo.desconto, 3990)
+  assert.equal(cem.corpo.total, 0)
+})
+
+test('o código do cupom no pedido não diferencia maiúsculas', async () => {
+  const ctx = montar()
+  await criarCupom(ctx)
+  const { pedir } = await preparar(ctx)
+  const { status, corpo } = await pedir('Natal10')
+  assert.equal(status, 201)
+  assert.equal(corpo.cupom, 'NATAL10')
+})
+
+test('abaixo do mínimo, recusa o pedido e não baixa o estoque', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { minimo: 8000 })
+  const { produto, pedir } = await preparar(ctx, 4000)
+
+  const abaixo = await pedir('NATAL10', 1)
+  assert.equal(abaixo.status, 422)
+  assert.equal(abaixo.corpo.erro.codigo, 'cupom_abaixo_do_minimo')
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/produtos/${produto.id}` })).corpo.estoque, 10)
+
+  const noMinimo = await pedir('NATAL10', 2)
+  assert.equal(noMinimo.status, 201)
+  assert.equal(noMinimo.corpo.desconto, 800)
+})
+
+/** Um pedido com uma caneca de 3000 sem promoção e um pires de 1000 em promoção (era 1500). */
+async function pedidoMisto(ctx: Contexto, cupom: string) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3000 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, precoPromocional: 1000 })
+  return criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 1 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+    cupom,
+  })
+}
+
+test('itens em promoção não recebem o desconto, mas contam para o mínimo', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { valor: 20, minimo: 4000 })
+  const { status, corpo } = await pedidoMisto(ctx, 'NATAL10')
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 4000)
+  assert.equal(corpo.desconto, 600)
+  assert.equal(corpo.total, 3400)
+})
+
+test('o desconto fixo não passa do valor dos itens sem promoção', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'MENOS50', tipo: 'fixo', valor: 5000 })
+  const { corpo } = await pedidoMisto(ctx, 'MENOS50')
+  assert.equal(corpo.desconto, 3000)
+  assert.equal(corpo.total, 1000)
+})
+
+test('se todos os itens estão em promoção, recusa o cupom e não baixa o estoque', async () => {
+  const ctx = montar()
+  await criarCupom(ctx)
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, precoPromocional: 2990, estoque: 5 })
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: 'NATAL10',
+  })
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_sem_itens_elegiveis')
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/produtos/${caneca.id}` })).corpo.estoque, 5)
+})
+
+test('cada cliente usa o mesmo cupom uma vez só', async () => {
+  const ctx = montar()
+  await criarCupom(ctx)
+  const { produto, pedir } = await preparar(ctx)
+  assert.equal((await pedir('NATAL10')).status, 201)
+
+  const deNovo = await pedir('natal10')
+  assert.equal(deNovo.status, 422)
+  assert.equal(deNovo.corpo.erro.codigo, 'cupom_ja_usado')
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/produtos/${produto.id}` })).corpo.estoque, 9)
+
+  // Sem o cupom, o mesmo cliente compra normalmente; e outro cliente ainda pode usá-lo.
+  assert.equal((await pedir()).status, 201)
+  const outro = await criarCliente(ctx)
+  const { status } = await criarPedido(ctx, {
+    clienteId: outro.id,
+    itens: [{ produtoId: produto.id, quantidade: 1 }],
+    cupom: 'NATAL10',
+  })
+  assert.equal(status, 201)
+})
+
+test('o cupom vale até o fim do último dia, em UTC', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { validoAte: '2026-03-01' })
+  const { produto, pedir } = await preparar(ctx)
+
+  ctx.relogio.atual = new Date('2026-03-02T00:00:00Z')
+  const vencido = await pedir('NATAL10')
+  assert.equal(vencido.status, 422)
+  assert.equal(vencido.corpo.erro.codigo, 'cupom_expirado')
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/produtos/${produto.id}` })).corpo.estoque, 10)
+
+  ctx.relogio.atual = new Date('2026-03-01T23:59:59Z')
+  assert.equal((await pedir('NATAL10')).status, 201)
+})
+
+test('recusa cupom que não existe', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  const { status, corpo } = await pedir('NADA')
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_inexistente')
+})
+
+test('o pedido guarda o desconto, mesmo na consulta e na lista', async () => {
+  const ctx = montar()
+  await criarCupom(ctx)
+  const { cliente, pedir } = await preparar(ctx, 3990)
+  const { corpo: criado } = await pedir('NATAL10')
+
+  const consultado = await ctx.pedir({ method: 'GET', url: `/pedidos/${criado.id}` })
+  assert.equal(consultado.corpo.subtotal, 3990)
+  assert.equal(consultado.corpo.desconto, 399)
+  assert.equal(consultado.corpo.total, 3591)
+  assert.equal(consultado.corpo.cupom, 'NATAL10')
+
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${cliente.id}` })
+  assert.deepEqual(lista.corpo.itens, [consultado.corpo])
+})
