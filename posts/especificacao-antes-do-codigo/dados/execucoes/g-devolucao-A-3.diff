+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Um pedido de 3 canecas (R$ 39,90) e 1 pires (R$ 15,00), com o estoque de cada um em 10 antes da compra. */
+async function pedidoDeExemplo(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+  })
+  return { pedido, caneca, pires }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number) {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: { produtoId: number; quantidade: number }[]) {
+  return ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/devolucoes`, payload: { itens } })
+}
+
+test('um pedido novo não tem nada reembolsado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoDeExemplo(ctx)
+  assert.equal(pedido.reembolsado, 0)
+  assert.equal(pedido.canceladoEm, null)
+  assert.deepEqual(pedido.devolucoes, [])
+})
+
+test('cancela um pedido pago: o estoque volta, o total é reembolsado e fica no histórico', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.reembolsado, 3 * 3990 + 1500)
+  assert.equal(corpo.reembolsado, corpo.total)
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela pedido enviado, entregue ou já cancelado, e não mexe no estoque', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  const deNovo = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(deNovo.status, 409)
+  assert.equal(deNovo.corpo.erro.codigo, 'transicao_invalida')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+
+  const { pedido: outro, caneca: outraCaneca } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/enviar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/cancelar` })).status, 409)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/entregar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/cancelar` })).status, 409)
+  assert.equal(await estoqueDe(ctx, outraCaneca.id), 7)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${outro.id}` })).corpo.reembolsado, 0)
+})
+
+test('um pedido cancelado não pode ser enviado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })).status, 409)
+})
+
+test('devolve parte de um pedido entregue, pelo preço da compra', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, {
+    id: corpo.id,
+    pedidoId: pedido.id,
+    itens: [{ produtoId: caneca.id, quantidade: 2 }],
+    reembolso: 2 * 3990,
+    criadaEm: '2026-03-06T12:00:00.000Z',
+  })
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 2 * 3990)
+})
+
+test('várias devoluções somam no reembolsado, mas não passam do que foi comprado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])).status, 201)
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(demais.status, 422)
+  assert.equal(demais.corpo.erro.codigo, 'quantidade_maior_que_a_comprada')
+
+  const resto = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(resto.status, 201)
+  assert.equal(resto.corpo.reembolso, 3990)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 3 * 3990)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+})
+
+test('com tudo devolvido, o pedido passa para devolvido, com evento no histórico', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+
+  ctx.relogio.avancarDias(2)
+  await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'devolvido')
+  assert.equal(depois.corpo.reembolsado, depois.corpo.total)
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'entregue', para: 'devolvido', em: '2026-03-03T12:00:00.000Z' })
+
+  const outra = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'pedido_nao_entregue')
+})
+
+test('aceita devolução até 7 dias depois da entrega e recusa depois disso', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  ctx.relogio.avancarDias(7)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+
+  ctx.relogio.atual = new Date(ctx.relogio.atual.getTime() + 1)
+  const tarde = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(tarde.status, 422)
+  assert.equal(tarde.corpo.erro.codigo, 'prazo_de_devolucao_encerrado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+})
+
+test('lista as devoluções do pedido, da mais antiga para a mais nova', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  const segunda = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+
+  const { status, corpo } = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.equal(status, 200)
+  assert.deepEqual(corpo.itens, [primeira.corpo, segunda.corpo])
+  assert.deepEqual(corpo.itens[1].itens, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal((await ctx.pedir({ method: 'GET', url: '/pedidos/999/devolucoes' })).status, 404)
+
+  const doPedido = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.deepEqual(doPedido.corpo.devolucoes, [primeira.corpo, segunda.corpo])
+})
+
+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const pedir = (itens: { produtoId: number; quantidade: number }[]) =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedido.id}/devolucoes`,
+      headers: { 'idempotency-key': 'abc-123' },
+      payload: { itens },
+    })
+
+  const primeira = await pedir([
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(primeira.status, 201)
+  const repetida = await pedir([
+    { produtoId: pires.id, quantidade: 1 },
+    { produtoId: caneca.id, quantidade: 1 },
+  ])
+  assert.equal(repetida.status, 200)
+  assert.deepEqual(repetida.corpo, primeira.corpo)
+
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.reembolsado, 3990 + 1500)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })).corpo.itens.length, 1)
+})
+
+test('a mesma Idempotency-Key com outro corpo, ou em outro pedido, é recusada com 409', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  const { pedido: outro, caneca: outraCaneca } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  await entregar(ctx, outro.id)
+  const pedir = (pedidoId: number, itens: { produtoId: number; quantidade: number }[]) =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedidoId}/devolucoes`,
+      headers: { 'idempotency-key': 'abc-123' },
+      payload: { itens },
+    })
+
+  assert.equal((await pedir(pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+  const outroCorpo = await pedir(pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(outroCorpo.status, 409)
+  assert.equal(outroCorpo.corpo.erro.codigo, 'chave_de_idempotencia_reutilizada')
+  assert.equal((await pedir(outro.id, [{ produtoId: outraCaneca.id, quantidade: 1 }])).status, 409)
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal(await estoqueDe(ctx, outraCaneca.id), 7)
+})
+
+test('uma devolução recusada não grava nada, mesmo com itens válidos junto', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const { status } = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  assert.equal(status, 422)
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.reembolsado, 0)
+})
+
+test('recusa devolução de pedido não entregue, de produto fora do pedido e de item repetido', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  const outro = await criarProduto(ctx, { nome: 'Bule' })
+
+  const naoEntregue = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(naoEntregue.status, 409)
+  assert.equal(naoEntregue.corpo.erro.codigo, 'pedido_nao_entregue')
+
+  await entregar(ctx, pedido.id)
+  const casos: [{ produtoId: number; quantidade: number }[], string][] = [
+    [[{ produtoId: outro.id, quantidade: 1 }], 'item_fora_do_pedido'],
+    [
+      [
+        { produtoId: caneca.id, quantidade: 1 },
+        { produtoId: caneca.id, quantidade: 1 },
+      ],
+      'item_repetido',
+    ],
+  ]
+  for (const [itens, codigo] of casos) {
+    const { status, corpo } = await devolver(ctx, pedido.id, itens)
+    assert.equal(status, 422, codigo)
+    assert.equal(corpo.erro.codigo, codigo)
+  }
+})
