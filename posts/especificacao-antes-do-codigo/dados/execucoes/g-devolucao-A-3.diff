+/** O pedido e os itens da devolução, numa forma que não depende da ordem dos itens nem das chaves do JSON. */
+function corpoNormalizado(pedidoId: number, nova: NovaDevolucao): string {
+  const itens = nova.itens
+    .map((item) => [item.produtoId, item.quantidade])
+    .sort(([a], [b]) => a - b)
+  return JSON.stringify({ pedidoId, itens })
+}
