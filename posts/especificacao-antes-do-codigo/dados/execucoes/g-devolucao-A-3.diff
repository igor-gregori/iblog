+/**
+ * Registra a devolução de itens de um pedido entregue, dentro do prazo. Cada item volta ao estoque e é reembolsado
+ * pelo preço pago na compra. Não se devolve mais unidades de um produto do que as compradas, somando as devoluções
+ * anteriores; quando tudo volta, o pedido passa a devolvido.
+ *
+ * Com `chave` (o cabeçalho Idempotency-Key), repetir a requisição devolve a devolução já feita, sem refazer nada, e
+ * `criada` vem `false`. A mesma chave com outro pedido ou outros itens é um conflito.
+ */
+export function devolverItens(
+  banco: Banco,
+  pedido: Pedido,
+  nova: NovaDevolucao,
+  agora: Date,
+  chave?: string,
+): { devolucao: Devolucao; criada: boolean } {
+  const idempotencia = chave === undefined ? undefined : { chave, corpo: corpoNormalizado(pedido.id, nova) }
+  if (idempotencia) {
+    const anterior = buscarDevolucaoPorChave(banco, idempotencia.chave)
+    if (anterior) {
+      if (anterior.corpo !== idempotencia.corpo) {
+        throw new Conflito(
+          'chave_de_idempotencia_reutilizada',
+          'Esta Idempotency-Key já foi usada numa devolução diferente',
+        )
+      }
+      return { devolucao: anterior.devolucao, criada: false }
+    }
+  }
+
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só se devolve item de pedido entregue; este está ${pedido.status}`)
+  }
+  const prazo = Date.parse(pedido.entregueEm!) + PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA
+  if (agora.getTime() > prazo) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_encerrado',
+      `A devolução só pode ser feita até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+    )
+  }
+  const produtos = new Set(nova.itens.map((item) => item.produtoId))
+  if (produtos.size !== nova.itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
