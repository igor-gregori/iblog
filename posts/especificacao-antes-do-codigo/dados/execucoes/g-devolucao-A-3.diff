+
+/** Soma `valor` ao que já foi reembolsado do pedido. */
+export function registrarReembolso(banco: Banco, pedidoId: number, valor: Centavos): void {
+  banco.prepare('UPDATE pedidos SET reembolsado = reembolsado + ? WHERE id = ?').run(valor, pedidoId)
+}
+
+/** Quantas unidades de cada produto do pedido já foram devolvidas, por id do produto. */
+export function quantidadesDevolvidas(banco: Banco, pedidoId: number): Map<number, number> {
+  const linhas = banco
+    .prepare(
+      `SELECT i.produto_id, SUM(i.quantidade) AS quantidade
+       FROM itens_devolucao i JOIN devolucoes d ON d.id = i.devolucao_id
+       WHERE d.pedido_id = ?
+       GROUP BY i.produto_id`,
+    )
+    .all(pedidoId) as { produto_id: number; quantidade: number }[]
+  return new Map(linhas.map((linha) => [linha.produto_id, linha.quantidade]))
+}
+
+/** A chave de idempotência de uma devolução: quem a usou e com que corpo, para reconhecer uma repetição. */
+export type ChaveDeIdempotencia = {
+  chave: string
+  /** O corpo da requisição normalizado; mesma chave com outro corpo é um erro do cliente. */
+  corpo: string
+}
+
+export function inserirDevolucao(
+  banco: Banco,
+  devolucao: {
+    pedidoId: number
+    reembolso: Centavos
+    criadaEm: string
+    itens: ItemDoPedido[]
+    idempotencia?: ChaveDeIdempotencia
+  },
+): number {
+  const { lastInsertRowid } = banco
+    .prepare(
+      'INSERT INTO devolucoes (pedido_id, reembolso, criada_em, chave_de_idempotencia, corpo) VALUES (?, ?, ?, ?, ?)',
+    )
+    .run(
+      devolucao.pedidoId,
+      devolucao.reembolso,
+      devolucao.criadaEm,
+      devolucao.idempotencia?.chave ?? null,
+      devolucao.idempotencia?.corpo ?? null,
+    )
+  const id = Number(lastInsertRowid)
+  // O preço pago fica guardado para auditoria, mas não sai na API: o que vale para o cliente é o `reembolso`.
+  const inserirItem = banco.prepare(
+    'INSERT INTO itens_devolucao (devolucao_id, produto_id, quantidade, preco_unitario) VALUES (?, ?, ?, ?)',
+  )
+  for (const item of devolucao.itens) {
+    inserirItem.run(id, item.produtoId, item.quantidade, item.precoUnitario)
+  }
+  return id
+}
+
+type LinhaDeDevolucao = {
+  id: number
+  pedido_id: number
+  reembolso: number
+  criada_em: string
+  corpo: string | null
+}
+
+function paraDevolucao(banco: Banco, linha: LinhaDeDevolucao): Devolucao {
+  const itens = banco
+    .prepare('SELECT produto_id, quantidade FROM itens_devolucao WHERE devolucao_id = ? ORDER BY id')
+    .all(linha.id) as { produto_id: number; quantidade: number }[]
+  return {
+    id: linha.id,
+    pedidoId: linha.pedido_id,
+    itens: itens.map((item) => ({ produtoId: item.produto_id, quantidade: item.quantidade })),
+    reembolso: linha.reembolso,
+    criadaEm: linha.criada_em,
+  }
+}
+
+export function buscarDevolucao(banco: Banco, id: number): Devolucao | undefined {
+  const linha = banco.prepare('SELECT * FROM devolucoes WHERE id = ?').get(id) as LinhaDeDevolucao | undefined
+  return linha && paraDevolucao(banco, linha)
+}
+
+/** A devolução já feita com esta chave de idempotência, e o corpo que a criou. */
+export function buscarDevolucaoPorChave(
+  banco: Banco,
+  chave: string,
+): { devolucao: Devolucao; corpo: string } | undefined {
+  const linha = banco.prepare('SELECT * FROM devolucoes WHERE chave_de_idempotencia = ?').get(chave) as
+    | LinhaDeDevolucao
+    | undefined
+  return linha && { devolucao: paraDevolucao(banco, linha), corpo: linha.corpo ?? '' }
+}
+
+export function listarDevolucoesDoPedido(banco: Banco, pedidoId: number): Devolucao[] {
+  const linhas = banco
+    .prepare('SELECT * FROM devolucoes WHERE pedido_id = ? ORDER BY id')
+    .all(pedidoId) as LinhaDeDevolucao[]
+  return linhas.map((linha) => paraDevolucao(banco, linha))
+}
