+
+async function listar(ctx: Contexto, query: Record<string, string> = {}) {
+  return ctx.pedir({ method: 'GET', url: '/produtos', query })
+}
+
+function nomes(corpo: { itens: { nome: string }[] }): string[] {
+  return corpo.itens.map((p) => p.nome)
+}
+
+/** "Produto 01" a "Produto 25", criados fora de ordem. */
+async function criar25(ctx: Contexto) {
+  for (let i = 25; i >= 1; i--) await criarProduto(ctx, { nome: `Produto ${String(i).padStart(2, '0')}` })
+}
+
+test('pagina a listagem na ordem de nome', async () => {
+  const ctx = montar()
+  await criar25(ctx)
+  const { status, corpo } = await listar(ctx, { pagina: '2', porPagina: '10' })
+  assert.equal(status, 200)
+  assert.deepEqual(
+    nomes(corpo),
+    Array.from({ length: 10 }, (_, i) => `Produto ${i + 11}`),
+  )
+  assert.equal(corpo.total, 25)
+  assert.equal(corpo.pagina, 2)
+  assert.equal(corpo.porPagina, 10)
+})
+
+test('sem parâmetros, devolve os 20 primeiros e diz os valores usados', async () => {
+  const ctx = montar()
+  await criar25(ctx)
+  const { status, corpo } = await listar(ctx)
+  assert.equal(status, 200)
+  assert.equal(corpo.itens.length, 20)
+  assert.equal(corpo.itens[0].nome, 'Produto 01')
+  assert.equal(corpo.itens[19].nome, 'Produto 20')
+  assert.equal(corpo.total, 25)
+  assert.equal(corpo.pagina, 1)
+  assert.equal(corpo.porPagina, 20)
+  assert.deepEqual(Object.keys(corpo.itens[0]).sort(), ['ativo', 'estoque', 'id', 'nome', 'preco', 'precoPromocional'])
+})
+
+test('uma página depois da última vem vazia, com o total certo', async () => {
+  const ctx = montar()
+  await criar25(ctx)
+  const depoisDaUltima: Record<string, string>[] = [{ pagina: '4', porPagina: '10' }, { pagina: '999999999999999' }]
+  for (const query of depoisDaUltima) {
+    const { status, corpo } = await listar(ctx, query)
+    assert.equal(status, 200, query.pagina)
+    assert.deepEqual(corpo.itens, [])
+    assert.equal(corpo.total, 25)
+  }
+})
+
+test('recusa paginação fora dos limites ou que não é inteira', async () => {
+  const ctx = montar()
+  const invalidas: Record<string, string>[] = [
+    { porPagina: '101' },
+    { porPagina: '0' },
+    { pagina: '0' },
+    { pagina: 'abc' },
+    { pagina: '1.5' },
+    { pagina: '-1' },
+  ]
+  for (const query of invalidas) {
+    const { status, corpo } = await listar(ctx, query)
+    assert.equal(status, 400, JSON.stringify(query))
+    assert.equal(corpo.erro.codigo, 'dados_invalidos')
+  }
+})
+
+test('busca por nome sem diferenciar maiúsculas nem acentos', async () => {
+  const ctx = montar()
+  for (const nome of ['Café com Leite', 'CAFETEIRA', 'Chá', 'Bule']) await criarProduto(ctx, { nome })
+
+  // A ordem por nome é a do SQLite, que põe as maiúsculas antes.
+  assert.deepEqual(nomes((await listar(ctx, { busca: 'cafe' })).corpo), ['CAFETEIRA', 'Café com Leite'])
+  assert.deepEqual(nomes((await listar(ctx, { busca: 'CHÁ' })).corpo), ['Chá'])
+  assert.deepEqual(nomes((await listar(ctx, { busca: 'cha' })).corpo), ['Chá'])
