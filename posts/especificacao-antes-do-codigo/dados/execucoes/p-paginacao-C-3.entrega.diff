+export type FiltrosDeProdutos = {
+  /** Trecho do nome, sem diferenciar maiúsculas nem acentos. */
+  busca?: string
+  /** Faixa do preço de venda, com os dois limites incluídos. */
+  precoMin?: Centavos
+  precoMax?: Centavos
+  /** A partir de 1. */
+  pagina: number
+  porPagina: number
+}
+
+/**
+ * Uma página dos produtos à venda que passam nos filtros, em ordem de nome. `total` conta os que passam nos filtros
+ * em todas as páginas.
+ */
+export function listarProdutos(banco: Banco, filtros: FiltrosDeProdutos): { itens: Produto[]; total: number } {
+  const condicoes = ['ativo = 1']
+  const valores: (string | number)[] = []
+  const busca = filtros.busca?.trim()
+  if (busca) {
+    condicoes.push("normalizar(nome) LIKE ? ESCAPE '\\'")
+    valores.push(`%${escaparLike(normalizar(busca))}%`)
+  }
+  if (filtros.precoMin !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) >= ?')
+    valores.push(filtros.precoMin)
+  }
+  if (filtros.precoMax !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) <= ?')
+    valores.push(filtros.precoMax)
+  }
+  const onde = condicoes.join(' AND ')
+
+  const { total } = banco.prepare(`SELECT COUNT(*) AS total FROM produtos WHERE ${onde}`).get(...valores) as {
+    total: number
+  }
+  const deslocamento = (filtros.pagina - 1) * filtros.porPagina
+  // Depois da última página não há o que buscar (e um deslocamento enorme nem caberia num inteiro do SQLite).
+  if (deslocamento >= total) return { itens: [], total }
+  const linhas = banco
+    .prepare(`SELECT * FROM produtos WHERE ${onde} ORDER BY nome, id LIMIT ? OFFSET ?`)
+    .all(...valores, filtros.porPagina, deslocamento) as Linha[]
+  return { itens: linhas.map(paraProduto), total }
+}
+
+/** Faz `\`, `%` e `_` valerem como caracteres comuns num `LIKE ... ESCAPE '\'`. */
+function escaparLike(texto: string): string {
+  return texto.replace(/[\\%_]/g, (caractere) => `\\${caractere}`)
 }
 
