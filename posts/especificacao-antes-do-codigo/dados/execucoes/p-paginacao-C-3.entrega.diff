+/** O texto em minúsculas e sem acentos, para comparar nomes: "Café" e "CAFE" viram "cafe". Também é a função SQL `normalizar`. */
+export function normalizar(texto: string): string {
+  return texto.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '')
+}
