+/** Um cliente, uma caneca de R$ 30,00 e um pires de R$ 10,00 que está em promoção por R$ 6,00. */
+async function prepararPedidoComPromocao(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3000, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1000, precoPromocional: 600, estoque: 10 })
+  return { cliente, caneca, pires }
+}
+
+test('itens em promoção não recebem o desconto do cupom', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  const { cliente, caneca, pires } = await prepararPedidoComPromocao(ctx)
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 1 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+    cupom: 'DEZ',
+  })
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3600)
+  assert.equal(corpo.desconto, 300)
+  assert.equal(corpo.total, 3300)
+})
