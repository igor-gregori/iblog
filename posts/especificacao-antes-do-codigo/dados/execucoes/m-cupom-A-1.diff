index 0000000..a1a4860
--- /dev/null
+++ b/src/cupons/repositorio.ts
@@ -0,0 +1,79 @@
+import type { Banco } from '../banco.ts'
+import type { Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  /** A porcentagem (de 1 a 100), se o cupom for `percentual`; os centavos de desconto, se for `fixo`. */
+  valor: number
+  /** O último dia em que o cupom vale (AAAA-MM-DD), em UTC. */
+  validoAte: string
+  /** O subtotal mínimo do pedido (contando os itens em promoção) para o cupom valer. */
+  minimo: Centavos
+}
+
+export type NovoCupom = Omit<Cupom, 'id' | 'minimo'> & { minimo?: Centavos }
+
+type Linha = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  valido_ate: string
+  minimo: number
+}
+
+function paraCupom(linha: Linha): Cupom {
+  return {
+    id: linha.id,
+    codigo: linha.codigo,
+    tipo: linha.tipo,
+    valor: linha.valor,
+    validoAte: linha.valido_ate,
+    minimo: linha.minimo,
+  }
+}
+
+export function buscarCupom(banco: Banco, id: number): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE id = ?').get(id) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+/** `codigo` já normalizado (veja `normalizarCodigo`). */
+export function buscarCupomPorCodigo(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE codigo = ?').get(codigo) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+export function inserirCupom(banco: Banco, novo: NovoCupom, criadoEm: string): Cupom {
+  const { lastInsertRowid } = banco
+    .prepare('INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(novo.codigo, novo.tipo, novo.valor, novo.validoAte, novo.minimo ?? 0, criadoEm)
+  return buscarCupom(banco, Number(lastInsertRowid))!
+}
+
+/** Códigos não diferenciam maiúsculas: `natal10` e `NATAL10` são o mesmo cupom. */
+export function normalizarCodigo(codigo: string): string {
+  return codigo.trim().toUpperCase()
+}
+
+/**
+ * Quanto o cupom tira de `base`, o valor dos itens que aceitam cupom (os que não estão em promoção). Nunca passa da
+ * base; na porcentagem, os centavos quebrados são arredondados para baixo.
+ */
+export function calcularDesconto(cupom: Cupom, base: Centavos): Centavos {
+  const desconto = cupom.tipo === 'percentual' ? Math.floor((base * cupom.valor) / 100) : cupom.valor
+  return Math.min(desconto, base)
+}
+
+/** A data de hoje (AAAA-MM-DD) em UTC, para comparar com `validoAte`. */
+export function hojeEmUtc(agora: Date): string {
+  return agora.toISOString().slice(0, 10)
+}
+
+export function clienteJaUsouCupom(banco: Banco, clienteId: number, cupomId: number): boolean {
+  return banco.prepare('SELECT 1 FROM pedidos WHERE cliente_id = ? AND cupom_id = ?').get(clienteId, cupomId) !== undefined
+}
