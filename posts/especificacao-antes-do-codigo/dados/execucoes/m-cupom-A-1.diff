diff --git a/test/cupons.test.ts b/test/cupons.test.ts
new file mode 100644
index 0000000..0ef48fe
--- /dev/null
+++ b/test/cupons.test.ts
@@ -0,0 +1,251 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  return ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'DEZ', tipo: 'percentual', valor: 10, validoAte: '2026-03-31', ...dados },
+  })
+}
+
+/** Um cliente e uma caneca de R$ 39,90, prontos para um pedido. */
+async function prepararPedido(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  return (quantidade: number, cupom?: string) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: caneca.id, quantidade }], cupom })
+}
+
+test('cadastra um cupom com o código em maiúsculas e mínimo zero', async () => {
+  const ctx = montar()
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'natal10' })
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, {
+    id: corpo.id,
+    codigo: 'NATAL10',
+    tipo: 'percentual',
+    valor: 10,
+    validoAte: '2026-03-31',
+    minimo: 0,
+  })
+})
+
+test('recusa código repetido com 409, sem ligar para maiúsculas', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ' })
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'dez' })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa cupom malformado com 400', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { tipo: 'brinde' },
+    { tipo: 'percentual', valor: 101 },
+    { valor: 0 },
+    { valor: 9.5 },
+    { validoAte: '31/03/2026' },
+    { validoAte: '2026-02-30' },
+    { minimo: -1 },
+    { codigo: '' },
+    { codigo: 'COM ESPACO' },
+  ]
+  for (const dados of casos) {
+    assert.equal((await criarCupom(ctx, dados)).status, 400, JSON.stringify(dados))
+  }
+  assert.equal((await criarCupom(ctx, { codigo: 'MIL', tipo: 'fixo', valor: 100000 })).status, 201)
+})
+
+test('pedido sem cupom: desconto zero e total igual ao subtotal', async () => {
+  const ctx = montar()
+  const pedir = await prepararPedido(ctx)
+  const { corpo } = await pedir(2)
+  assert.equal(corpo.subtotal, 7980)
+  assert.equal(corpo.desconto, 0)
+  assert.equal(corpo.total, 7980)
+  assert.equal(corpo.cupom, null)
+})
+
+test('cupom percentual: arredonda os centavos quebrados para baixo', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  const pedir = await prepararPedido(ctx)
+  const { status, corpo } = await pedir(1, 'dez')
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3990)
+  assert.equal(corpo.desconto, 399)
+  assert.equal(corpo.total, 3591)
+  assert.equal(corpo.cupom, 'DEZ')
+
+  await criarCupom(ctx, { codigo: 'TREZE', tipo: 'percentual', valor: 13 })
+  const outro = await pedir(1, 'TREZE')
+  assert.equal(outro.corpo.desconto, 518) // 13% de 3990 é 518,7
+  assert.equal(outro.corpo.total, 3472)
+})
+
+test('cupom fixo tira o valor, mas nunca deixa o total negativo', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'CINCO', tipo: 'fixo', valor: 500 })
+  await criarCupom(ctx, { codigo: 'CEM', tipo: 'fixo', valor: 10000 })
+  const pedir = await prepararPedido(ctx)
+
