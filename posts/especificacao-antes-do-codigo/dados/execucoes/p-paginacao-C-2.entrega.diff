+export type FiltrosDeProdutos = {
+  pagina: number
+  porPagina: number
+  /** Parte do nome, sem diferenciar maiúsculas nem acentos. */
+  busca?: string
+  /** Limites do preço de venda, inclusive. */
+  precoMin?: Centavos
+  precoMax?: Centavos
+}
+
+/** Uma página dos produtos à venda que passam nos filtros, em ordem de nome, e quantos passam ao todo. */
+export function listarProdutos(banco: Banco, filtros: FiltrosDeProdutos): { itens: Produto[]; total: number } {
+  const condicoes = ['ativo = 1']
+  const valores: (string | number)[] = []
+  const busca = filtros.busca?.trim()
+  if (busca) {
+    condicoes.push("normalizar(nome) LIKE ? ESCAPE '\\'")
+    valores.push(`%${normalizar(busca).replace(/[\\%_]/g, '\\$&')}%`)
+  }
+  if (filtros.precoMin !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) >= ?')
+    valores.push(filtros.precoMin)
+  }
+  if (filtros.precoMax !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) <= ?')
+    valores.push(filtros.precoMax)
+  }
+  const where = condicoes.join(' AND ')
+
+  const { total } = banco.prepare(`SELECT COUNT(*) AS total FROM produtos WHERE ${where}`).get(...valores) as {
+    total: number
+  }
+  const pular = (filtros.pagina - 1) * filtros.porPagina
+  // Uma página tão alta que o OFFSET nem cabe num inteiro do SQLite está, com certeza, depois da última.
+  if (!Number.isSafeInteger(pular)) return { itens: [], total }
+  const linhas = banco
+    .prepare(`SELECT * FROM produtos WHERE ${where} ORDER BY nome, id LIMIT ? OFFSET ?`)
+    .all(...valores, filtros.porPagina, pular) as Linha[]
+  return { itens: linhas.map(paraProduto), total }
 }
 
