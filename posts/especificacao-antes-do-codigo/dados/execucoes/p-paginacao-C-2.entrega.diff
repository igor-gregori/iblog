+const nomes = (corpo: { itens: { nome: string }[] }) => corpo.itens.map((p) => p.nome)
+
+function listar(ctx: Contexto, query: Record<string, string> = {}) {
+  return ctx.pedir({ method: 'GET', url: '/produtos', query })
+}
+
+async function criarVarios(ctx: Contexto, quantos: number) {
+  for (let i = 1; i <= quantos; i++) await criarProduto(ctx, { nome: `Produto ${String(i).padStart(2, '0')}` })
+}
+
+test('pagina a listagem: a segunda página de 10, com o total', async () => {
+  const ctx = montar()
+  await criarVarios(ctx, 25)
+
+  const { status, corpo } = await listar(ctx, { pagina: '2', porPagina: '10' })
+  assert.equal(status, 200)
+  assert.deepEqual(
+    nomes(corpo),
+    Array.from({ length: 10 }, (_, i) => `Produto ${i + 11}`),
+  )
+  assert.equal(corpo.total, 25)
+  assert.equal(corpo.pagina, 2)
+  assert.equal(corpo.porPagina, 10)
+})
+
