+
+/** Cancela um pedido que ainda não foi enviado: todo o estoque volta e o total inteiro é reembolsado. */
+export function cancelarPedido(banco: Banco, pedido: Pedido, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    registrarReembolso(banco, pedido.id, pedido.total - pedido.reembolsado)
+    return buscarPedido(banco, pedido.id)!
+  })
+}
+
+/**
+ * Registra a devolução de itens de um pedido entregue. Cada item volta ao estoque e é reembolsado pelo preço pago na
+ * compra. Não se devolve mais unidades de um produto do que as compradas, somando as devoluções anteriores.
+ */
+export function devolverItens(banco: Banco, pedido: Pedido, nova: NovaDevolucao, agora: Date): Devolucao {
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só se devolve item de pedido entregue; este está ${pedido.status}`)
+  }
+  const produtos = new Set(nova.itens.map((item) => item.produtoId))
+  if (produtos.size !== nova.itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
+
+  const criadaEm = agora.toISOString()
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((comprado) => comprado.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_maior_que_a_comprada',
+          `Do produto ${item.produtoId} só ${restante} unidade(s) ainda podem ser devolvidas`,
+        )
+      }
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const id = inserirDevolucao(banco, { pedidoId: pedido.id, reembolso, criadaEm, itens })
+    for (const item of itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    registrarReembolso(banco, pedido.id, reembolso)
+    return buscarDevolucao(banco, id)!
+  })
+}
