@@ -0,0 +1,175 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Um pedido de 3 canecas (R$ 39,90) e 1 pires (R$ 15,00), com o estoque de cada um em 10 antes da compra. */
+async function pedidoDeExemplo(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+  })
+  return { pedido, caneca, pires }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number) {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: { produtoId: number; quantidade: number }[]) {
+  return ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/devolucoes`, payload: { itens } })
+}
+
+test('um pedido novo não tem nada reembolsado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoDeExemplo(ctx)
+  assert.equal(pedido.reembolsado, 0)
+})
+
+test('cancela um pedido pago: o estoque volta, o total é reembolsado e fica no histórico', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.reembolsado, 3 * 3990 + 1500)
+  assert.equal(corpo.reembolsado, corpo.total)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela pedido enviado, entregue ou já cancelado, e não mexe no estoque', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  const deNovo = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(deNovo.status, 409)
+  assert.equal(deNovo.corpo.erro.codigo, 'transicao_invalida')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+
+  const { pedido: outro, caneca: outraCaneca } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/enviar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/cancelar` })).status, 409)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/entregar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.id}/cancelar` })).status, 409)
+  assert.equal(await estoqueDe(ctx, outraCaneca.id), 7)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${outro.id}` })).corpo.reembolsado, 0)
+})
+
+test('um pedido cancelado não pode ser enviado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })).status, 409)
+})
+
+test('devolve parte de um pedido entregue, pelo preço da compra', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, {
+    id: corpo.id,
+    pedidoId: pedido.id,
+    itens: [{ produtoId: caneca.id, quantidade: 2, precoUnitario: 3990 }],
+    reembolso: 2 * 3990,
+    criadaEm: '2026-03-06T12:00:00.000Z',
+  })
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 2 * 3990)
+})
+
+test('várias devoluções somam no reembolsado, mas não passam do que foi comprado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])).status, 201)
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(demais.status, 422)
+  assert.equal(demais.corpo.erro.codigo, 'quantidade_maior_que_a_comprada')
+
+  const resto = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(resto.status, 201)
+  assert.equal(resto.corpo.reembolso, 3990 + 1500)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.reembolsado, depois.corpo.total)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])).status, 422)
+})
+
+test('uma devolução recusada não grava nada, mesmo com itens válidos junto', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
