+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Uma caneca (R$ 39,90) e um pires (R$ 15,00), e um pedido entregue com 3 canecas e 2 pires. */
+async function pedidoEntregue(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 5 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 2 },
+    ],
+  })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/entregar` })
+  return { pedido, caneca, pires }
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown, chave?: string) {
+  return ctx.pedir({
+    method: 'POST',
+    url: `/pedidos/${pedidoId}/devolucoes`,
+    payload: { itens },
+    headers: chave === undefined ? {} : { 'idempotency-key': chave },
+  })
+}
+
+test('devolve parte de um pedido entregue: reembolsa, repõe o estoque e mostra no pedido', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  assert.equal(status, 201)
+  assert.equal(typeof corpo.id, 'number')
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.equal(corpo.reembolso, 3990 + 2 * 1500)
+  assert.equal(corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+  assert.deepEqual(corpo.itens, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal(await estoqueDe(ctx, pires.id), 5)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 3990 + 2 * 1500)
+})
+
+test('o reembolso usa o preço da compra, mesmo que o produto mude depois', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990, precoPromocional: 100 } })
+  const { corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(corpo.reembolso, 2 * 3990)
+})
+
+test('devoluções parciais se somam e não passam do que foi comprado', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(demais.status, 422)
+  assert.equal(demais.corpo.erro.codigo, 'quantidade_excede_compra')
+
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.reembolsado, 3 * 3990)
+})
+
+test('um erro em qualquer item recusa a devolução inteira', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+  const { status, corpo } = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 3 },
+  ])
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'quantidade_excede_compra')
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+  assert.equal(await estoqueDe(ctx, pires.id), 3)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.reembolsado, 0)
+})
+
+test('recusa produto fora do pedido e item repetido', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  const outro = await criarProduto(ctx, { nome: 'Prato' })
+
+  const fora = await devolver(ctx, pedido.id, [{ produtoId: outro.id, quantidade: 1 }])
+  assert.equal(fora.status, 422)
+  assert.equal(fora.corpo.erro.codigo, 'produto_fora_do_pedido')
+
+  const repetido = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: caneca.id, quantidade: 1 },
+  ])
+  assert.equal(repetido.status, 422)
+  assert.equal(repetido.corpo.erro.codigo, 'item_repetido')
+})
+
+test('só pedido entregue aceita devolução', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx)
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+  })
+  for (const acao of [null, 'enviar']) {
+    if (acao) await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/${acao}` })
+    const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'pedido_nao_entregue')
+  }
+
+  const { corpo: cancelado } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+  })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.id}/cancelar` })
+  assert.equal((await devolver(ctx, cancelado.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 409)
+})
+
+test('recusa corpo malformado e pedido que não existe', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  assert.equal((await devolver(ctx, pedido.id, [])).status, 400)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 0 }])).status, 400)
+  assert.equal((await devolver(ctx, 999, [{ produtoId: caneca.id, quantidade: 1 }])).status, 404)
+})
+
+test('o pedido lista as devoluções', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  const segunda = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+
+  const { corpo } = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.deepEqual(corpo.devolucoes, [primeira.corpo, segunda.corpo])
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.deepEqual(lista.corpo, { itens: [primeira.corpo, segunda.corpo] })
+})
+
+test('devolve até 7 dias depois da entrega, e recusa depois disso', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  ctx.relogio.avancarDias(7)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+
+  ctx.relogio.atual = new Date(ctx.relogio.atual.getTime() + 1000)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'prazo_de_devolucao_expirado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+})
+
+test('com tudo devolvido, o pedido passa para devolvido, com evento no histórico', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 3 }])
+  const parcial = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(parcial.corpo.status, 'entregue')
+
+  ctx.relogio.avancarDias(2)
+  await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 2 }])
+  const { corpo } = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(corpo.status, 'devolvido')
+  assert.equal(corpo.devolvidoEm, '2026-03-03T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, corpo.total)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), {
+    de: 'entregue',
+    para: 'devolvido',
+    em: '2026-03-03T12:00:00.000Z',
+  })
+  const depois = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+  assert.equal(depois.status, 409)
+})
+
+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+  const tresCanecas = { produtoId: caneca.id, quantidade: 3 }
+  const doisPires = { produtoId: pires.id, quantidade: 2 }
+  const primeira = await devolver(ctx, pedido.id, [tresCanecas, doisPires], 'abc')
+  assert.equal(primeira.status, 201)
+
+  // O mesmo corpo, com os itens em outra ordem, depois que o pedido já ficou devolvido
+  const repetida = await devolver(ctx, pedido.id, [doisPires, tresCanecas], 'abc')
+  assert.equal(repetida.status, 200)
+  assert.deepEqual(repetida.corpo, primeira.corpo)
+
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  const { corpo } = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(corpo.devolucoes.length, 1)
+  assert.equal(corpo.reembolsado, corpo.total)
+})
+
+test('a mesma Idempotency-Key com outro corpo é recusada com 409', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }], 'abc')
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }], 'abc')
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'chave_de_idempotencia_reutilizada')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }], 'outra')).status, 201)
+})
