+++ b/test/cupons.test.ts
@@ -0,0 +1,221 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'BEMVINDO', tipo: 'percentual', valor: 10, validoAte: '2026-03-31', minimo: 0, ...dados },
+  })
+  if (status !== 201) throw new Error(`não criou o cupom: ${JSON.stringify(corpo)}`)
+  return corpo
+}
+
+/** Um cliente e um produto de R$ 100,00, prontos para um pedido. */
+async function preparar(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco: 10000, estoque: 10 })
+  return (cupom?: string, quantidade = 1) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom })
+}
+
+test('cadastra um cupom, guardando o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'natal10', tipo: 'fixo', valor: 1500, validoAte: '2026-12-25', minimo: 5000 },
+  })
+  assert.equal(status, 201)
+  assert.deepEqual(
+    { ...corpo, id: undefined },
+    { id: undefined, codigo: 'NATAL10', tipo: 'fixo', valor: 1500, validoAte: '2026-12-25', minimo: 5000 },
+  )
+})
+
+test('recusa código repetido, mesmo com outras maiúsculas', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'BEMVINDO' })
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'bemvindo', tipo: 'fixo', valor: 100, validoAte: '2026-03-31' },
+  })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa cupom malformado, inclusive percentual acima de 100', async () => {
+  const ctx = montar()
+  const base = { codigo: 'X', tipo: 'fixo', valor: 100, validoAte: '2026-03-31' }
+  const malformados = [
+    { ...base, tipo: 'brinde' },
+    { ...base, valor: 0 },
+    { ...base, tipo: 'percentual', valor: 101 },
+    { ...base, validoAte: '31/03/2026' },
+    { ...base, validoAte: '2026-02-30' },
+    { ...base, codigo: 'com espaço' },
+    { ...base, minimo: -1 },
+  ]
+  for (const payload of malformados) {
+    assert.equal((await ctx.pedir({ method: 'POST', url: '/cupons', payload })).status, 400, JSON.stringify(payload))
+  }
+  // Um fixo acima de 100 é só um valor em centavos.
+  assert.equal((await ctx.pedir({ method: 'POST', url: '/cupons', payload: { ...base, valor: 101 } })).status, 201)
+})
+
+test('pedido sem cupom tem desconto zero', async () => {
+  const ctx = montar()
+  const pedir = await preparar(ctx)
+  const { corpo } = await pedir()
+  assert.equal(corpo.subtotal, 10000)
+  assert.equal(corpo.desconto, 0)
+  assert.equal(corpo.total, 10000)
+  assert.equal(corpo.cupom, null)
+})
+
+test('cupom percentual desconta a porcentagem do subtotal, arredondando para baixo', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco: 3999 })
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: produto.id, quantidade: 1 }],
+    cupom: 'dez',
+  })
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3999)
+  assert.equal(corpo.desconto, 399)
+  assert.equal(corpo.total, 3600)
+  assert.equal(corpo.cupom, 'DEZ')
+})
+
