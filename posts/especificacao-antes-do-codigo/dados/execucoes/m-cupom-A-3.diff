+import { formatar, type Centavos } from '../dinheiro.ts'
+import { ErroDeNegocio } from '../erros.ts'
+import type { Cupom } from './repositorio.ts'
+
+/** Os códigos não diferenciam maiúsculas: `natal10` e `NATAL10` são o mesmo cupom. */
+export function normalizarCodigo(codigo: string): string {
+  return codigo.trim().toUpperCase()
+}
+
+/** Os valores de um pedido que o cupom olha. */
+export type ValoresDoPedido = {
+  /** A soma de todos os itens: é com ela que se confere o mínimo. */
+  subtotal: Centavos
+  /** A soma dos itens que não estão em promoção: só eles recebem o desconto do cupom. */
+  semPromocao: Centavos
+}
+
+/**
+ * O desconto que o cupom dá num pedido. Recusa o cupom vencido (a validade vai até o fim do dia `validoAte`, em UTC),
+ * abaixo do mínimo ou sem nenhum item fora de promoção. O desconto vale só sobre os itens sem promoção: o percentual é
+ * arredondado para baixo, e o fixo não passa do valor desses itens.
+ */
+export function calcularDesconto(cupom: Cupom, valores: ValoresDoPedido, agora: Date): Centavos {
+  if (agora.toISOString().slice(0, 10) > cupom.validoAte) {
+    throw new ErroDeNegocio('cupom_expirado', `O cupom ${cupom.codigo} venceu em ${cupom.validoAte}`)
+  }
+  if (valores.subtotal < cupom.minimo) {
+    throw new ErroDeNegocio(
+      'cupom_abaixo_do_minimo',
+      `O cupom ${cupom.codigo} vale para pedidos a partir de ${formatar(cupom.minimo)}`,
+    )
+  }
+  if (valores.semPromocao === 0) {
+    throw new ErroDeNegocio('cupom_sem_itens_elegiveis', 'O cupom não vale para itens em promoção')
+  }
+  const desconto =
+    cupom.tipo === 'percentual' ? Math.floor((valores.semPromocao * cupom.valor) / 100) : cupom.valor
+  return Math.min(desconto, valores.semPromocao)
+}
