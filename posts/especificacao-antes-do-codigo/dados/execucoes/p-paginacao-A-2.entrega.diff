+test('pagina a lista e informa o total', async () => {
+  const ctx = montar()
+  for (const nome of ['E', 'C', 'A', 'D', 'B']) await criarProduto(ctx, { nome })
+  const nomes = (corpo: { itens: { nome: string }[] }) => corpo.itens.map((p) => p.nome)
+
+  const primeira = await ctx.pedir({ method: 'GET', url: '/produtos?porPagina=2' })
+  assert.equal(primeira.status, 200)
+  assert.deepEqual(nomes(primeira.corpo), ['A', 'B'])
+  assert.equal(primeira.corpo.total, 5)
+
+  const terceira = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=3&porPagina=2' })
+  assert.deepEqual(nomes(terceira.corpo), ['E'])
+  assert.equal(terceira.corpo.total, 5)
+
+  const alemDoFim = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=4&porPagina=2' })
+  assert.deepEqual(alemDoFim.corpo, { itens: [], total: 5 })
+})
+
+test('mostra 20 produtos por página se não pedirem outro número', async () => {
+  const ctx = montar()
+  for (let i = 0; i < 21; i++) await criarProduto(ctx, { nome: `Produto ${String(i).padStart(2, '0')}` })
+  const { corpo } = await ctx.pedir({ method: 'GET', url: '/produtos' })
+  assert.equal(corpo.itens.length, 20)
+  assert.equal(corpo.total, 21)
+})
+
+test('filtra pelo nome, sem diferença entre maiúsculas e minúsculas', async () => {
+  const ctx = montar()
+  await criarProduto(ctx, { nome: 'Caneca branca' })
+  await criarProduto(ctx, { nome: 'Xícara' })
+  await criarProduto(ctx, { nome: 'Caneca preta' })
+  await criarProduto(ctx, { nome: 'Desconto 100%' })
+
+  const { corpo } = await ctx.pedir({ method: 'GET', url: '/produtos?busca=CANECA' })
+  assert.deepEqual(
+    corpo.itens.map((p: { nome: string }) => p.nome),
+    ['Caneca branca', 'Caneca preta'],
+  )
+  assert.equal(corpo.total, 2)
+
+  // % e _ são letras comuns na busca, não curingas do LIKE
+  const curinga = await ctx.pedir({ method: 'GET', url: '/produtos?busca=%25' })
+  assert.deepEqual(
+    curinga.corpo.itens.map((p: { nome: string }) => p.nome),
+    ['Desconto 100%'],
+  )
+})
+
+test('filtra pela faixa do preço de venda, com as pontas incluídas', async () => {
+  const ctx = montar()
