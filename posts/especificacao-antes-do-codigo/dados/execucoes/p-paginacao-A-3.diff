+export type FiltroDeProdutos = {
+  /** Trecho do nome, sem diferença entre maiúsculas e minúsculas nem de acentos. Vazio, não filtra. */
+  busca?: string
+  /** Faixa do preço de venda (o promocional, se houver), com os extremos inclusos. */
+  precoMin?: Centavos
+  precoMax?: Centavos
+}
+
+export type Paginacao = { pagina: number; porPagina: number }
+
+/** Uma página dos produtos à venda que atendem ao filtro, em ordem de nome, e quantos são ao todo. */
+export function listarProdutosAtivos(
+  banco: Banco,
+  filtro: FiltroDeProdutos,
+  { pagina, porPagina }: Paginacao,
+): { itens: Produto[]; total: number } {
+  const condicoes = ['ativo = 1']
+  const valores: (string | number)[] = []
+  const busca = normalizar(filtro.busca?.trim() ?? '')
+  if (busca) {
+    condicoes.push("normalizar(nome) LIKE ? ESCAPE '\\'")
+    valores.push(`%${busca.replace(/[\\%_]/g, '\\$&')}%`)
+  }
+  if (filtro.precoMin !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) >= ?')
+    valores.push(filtro.precoMin)
+  }
+  if (filtro.precoMax !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) <= ?')
+    valores.push(filtro.precoMax)
+  }
+  const onde = condicoes.join(' AND ')
+
+  const { total } = banco.prepare(`SELECT COUNT(*) AS total FROM produtos WHERE ${onde}`).get(...valores) as {
+    total: number
+  }
+  const linhas = banco
+    .prepare(`SELECT * FROM produtos WHERE ${onde} ORDER BY nome, id LIMIT ? OFFSET ?`)
+    .all(...valores, porPagina, (pagina - 1) * porPagina) as Linha[]
+  return { itens: linhas.map(paraProduto), total }
 }
 
