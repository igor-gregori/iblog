diff --git a/test/cupons.test.ts b/test/cupons.test.ts
new file mode 100644
index 0000000..8d08997
--- /dev/null
+++ b/test/cupons.test.ts
@@ -0,0 +1,259 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarCupom, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function cadastrar(ctx: Contexto, payload: Record<string, unknown>) {
+  return ctx.pedir({ method: 'POST', url: '/cupons', payload })
+}
+
+async function pedirCom(ctx: Contexto, cupom: string, dadosDoProduto: Record<string, unknown> = {}, quantidade = 1) {
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, dadosDoProduto)
+  const resposta = await criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom })
+  return { ...resposta, produto }
+}
+
+test('cadastra um cupom, com o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await cadastrar(ctx, {
+    codigo: 'natal10',
+    tipo: 'percentual',
+    valor: 10,
+    validoAte: '2026-12-25',
+    minimo: 5000,
+  })
+  assert.equal(status, 201)
+  assert.equal(corpo.codigo, 'NATAL10')
+  assert.equal(corpo.tipo, 'percentual')
+  assert.equal(corpo.valor, 10)
+  assert.equal(corpo.validoAte, '2026-12-25')
+  assert.equal(corpo.minimo, 5000)
+  assert.equal(corpo.criadoEm, '2026-03-01T12:00:00.000Z')
+})
+
+test('o mínimo é zero quando não vem', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx)
+  assert.equal(cupom.minimo, 0)
+})
+
+test('recusa cupom malformado com 400', async () => {
+  const ctx = montar()
+  const base = { codigo: 'X', tipo: 'fixo', valor: 500, validoAte: '2026-12-31' }
+  const casos: Record<string, unknown>[] = [
+    { ...base, tipo: 'brinde' },
+    { ...base, valor: 0 },
+    { ...base, valor: 9.5 },
+    { ...base, validoAte: '31/12/2026' },
+    { ...base, validoAte: '2026-02-30' },
+    { ...base, codigo: 'com espaço' },
+    { ...base, minimo: -1 },
+  ]
+  for (const payload of casos) {
+    const { status, corpo } = await cadastrar(ctx, payload)
+    assert.equal(status, 400, JSON.stringify(payload))
+    assert.equal(corpo.erro.codigo, 'dados_invalidos')
+  }
+})
+
+test('recusa código repetido, mesmo em outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'BEMVINDO' })
+  const { status, corpo } = await cadastrar(ctx, { codigo: 'bemvindo', tipo: 'fixo', valor: 500, validoAte: '2026-12-31' })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('a porcentagem vai de 1 a 100; o fixo pode passar de 100', async () => {
+  const ctx = montar()
+  const acima = await cadastrar(ctx, { codigo: 'A', tipo: 'percentual', valor: 101, validoAte: '2026-12-31' })
+  assert.equal(acima.status, 400)
+  assert.equal(acima.corpo.erro.codigo, 'dados_invalidos')
+  const cem = await cadastrar(ctx, { codigo: 'B', tipo: 'percentual', valor: 100, validoAte: '2026-12-31' })
+  assert.equal(cem.status, 201)
