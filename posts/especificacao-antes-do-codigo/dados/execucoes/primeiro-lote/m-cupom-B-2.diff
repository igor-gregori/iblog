+test('o pedido guarda o desconto', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'fixo', valor: 1000 })
+  const { corpo } = await pedirCom(ctx, 'DEZ', { preco: 3990 })
+  const esperado = { subtotal: 3990, desconto: 1000, total: 2990, cupom: 'DEZ' }
+
+  const um = await ctx.pedir({ method: 'GET', url: `/pedidos/${corpo.id}` })
+  assert.deepEqual(
+    { subtotal: um.corpo.subtotal, desconto: um.corpo.desconto, total: um.corpo.total, cupom: um.corpo.cupom },
+    esperado,
+  )
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${corpo.clienteId}` })
+  const [doCliente] = lista.corpo.itens
+  assert.deepEqual(
+    { subtotal: doCliente.subtotal, desconto: doCliente.desconto, total: doCliente.total, cupom: doCliente.cupom },
+    esperado,
+  )
+})
+
+test('o mínimo vale sobre o subtotal de todos os itens, e o próprio mínimo basta', async () => {
