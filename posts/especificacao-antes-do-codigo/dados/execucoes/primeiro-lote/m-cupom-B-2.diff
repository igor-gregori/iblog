@@ -0,0 +1,90 @@
+import type { Banco } from '../banco.ts'
+import { porcentagem, type Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  /** A porcentagem (de 1 a 100), se `percentual`; o valor em centavos, se `fixo`. */
+  valor: number
+  /** O último dia em que o cupom vale (`AAAA-MM-DD`, em UTC). */
+  validoAte: string
+  /** O subtotal mínimo do pedido para usar o cupom, contando também os itens em promoção. */
+  minimo: Centavos
+  criadoEm: string
+}
+
+export type NovoCupom = {
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  validoAte: string
+  minimo?: Centavos
+}
+
+type Linha = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  valido_ate: string
+  minimo: number
+  criado_em: string
+}
+
+function paraCupom(linha: Linha): Cupom {
+  return {
+    id: linha.id,
+    codigo: linha.codigo,
+    tipo: linha.tipo,
+    valor: linha.valor,
+    validoAte: linha.valido_ate,
+    minimo: linha.minimo,
+    criadoEm: linha.criado_em,
+  }
+}
+
+/** Os códigos são guardados em maiúsculas: `natal10` e `NATAL10` são o mesmo cupom. */
+export function normalizarCodigo(codigo: string): string {
+  return codigo.trim().toUpperCase()
+}
+
+export function buscarCupom(banco: Banco, id: number): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE id = ?').get(id) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+export function buscarCupomPorCodigo(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE codigo = ?').get(normalizarCodigo(codigo)) as
+    | Linha
+    | undefined
+  return linha && paraCupom(linha)
+}
+
+export function inserirCupom(banco: Banco, novo: NovoCupom, criadoEm: string): Cupom {
+  const { lastInsertRowid } = banco
+    .prepare('INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(normalizarCodigo(novo.codigo), novo.tipo, novo.valor, novo.validoAte, novo.minimo ?? 0, criadoEm)
+  return buscarCupom(banco, Number(lastInsertRowid))!
+}
+
+/**
+ * Quanto o cupom tira de um pedido, dado o valor dos itens que não estão em promoção (os únicos que recebem o
+ * desconto). Nunca passa desse valor.
+ */
+export function descontoDoCupom(cupom: Cupom, semPromocao: Centavos): Centavos {
+  const desconto = cupom.tipo === 'percentual' ? porcentagem(semPromocao, cupom.valor) : cupom.valor
+  return Math.min(desconto, semPromocao)
+}
+
+/** O cupom vale até o fim do dia `validoAte`, em UTC. */
+export function cupomValeEm(cupom: Cupom, agora: Date): boolean {
+  return agora.toISOString().slice(0, 10) <= cupom.validoAte
+}
+
+/** Cada cliente usa um cupom uma vez só. */
+export function clienteJaUsouCupom(banco: Banco, clienteId: number, cupomId: number): boolean {
+  return banco.prepare('SELECT 1 FROM pedidos WHERE cliente_id = ? AND cupom_id = ?').get(clienteId, cupomId) !== undefined
+}
