diff --git a/test/devolucoes.test.ts b/test/devolucoes.test.ts
new file mode 100644
index 0000000..25b1d94
--- /dev/null
+++ b/test/devolucoes.test.ts
@@ -0,0 +1,288 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+async function buscar(ctx: Contexto, pedidoId: number) {
+  return (await ctx.pedir({ method: 'GET', url: `/pedidos/${pedidoId}` })).corpo
+}
+
+/** Uma caneca (R$ 39,90) e um pires (R$ 15,00), com 10 de estoque cada, e um pedido de 3 canecas e 2 pires. */
+async function pedidoComDoisProdutos(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 2 },
+    ],
+  })
+  return { caneca, pires, pedido }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number): Promise<void> {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown) {
+  return ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/devolucoes`, payload: { itens } })
+}
+
+test('um pedido novo sai sem nada reembolsado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoComDoisProdutos(ctx)
+  assert.equal(pedido.reembolsado, 0)
+  assert.equal(pedido.canceladoEm, null)
+})
+
+test('cancela um pedido pago: estoque volta, reembolsa o total e registra no histórico', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoComDoisProdutos(ctx)
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, 3 * 3990 + 2 * 1500)
+  assert.equal(corpo.reembolsado, corpo.total)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela pedido enviado, entregue ou já cancelado, e não mexe no estoque', async () => {
+  const ctx = montar()
+  const { caneca, pedido } = await pedidoComDoisProdutos(ctx)
+  const cancelar = () => ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })
+  const enviado = await cancelar()
+  assert.equal(enviado.status, 409)
+  assert.equal(enviado.corpo.erro.codigo, 'transicao_invalida')
+
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/entregar` })
+  assert.equal((await cancelar()).status, 409)
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 0)
+
+  const outro = await pedidoComDoisProdutos(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.pedido.id}/cancelar` })
+  const deNovo = await ctx.pedir({ method: 'POST', url: `/pedidos/${outro.pedido.id}/cancelar` })
+  assert.equal(deNovo.status, 409)
+  assert.equal(await estoqueDe(ctx, outro.caneca.id), 10)
+  assert.equal((await buscar(ctx, outro.pedido.id)).reembolsado, outro.pedido.total)
+})
+
+test('devolve parte de um pedido entregue, reembolsando pelo preço da compra', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoComDoisProdutos(ctx)
+  await entregar(ctx, pedido.id)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  ctx.relogio.avancarDias(2)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.equal(corpo.reembolso, 2 * 3990)
+  assert.equal(corpo.criadaEm, '2026-03-03T12:00:00.000Z')
+  assert.deepEqual(corpo.itens, [{ produtoId: caneca.id, quantidade: 2, precoUnitario: 3990 }])
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+
+  const depois = await buscar(ctx, pedido.id)
+  assert.equal(depois.status, 'entregue')
+  assert.equal(depois.reembolsado, 2 * 3990)
+})
+
+test('devoluções seguidas acumulam o reembolso, até a quantidade comprada', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoComDoisProdutos(ctx)
+  await entregar(ctx, pedido.id)
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  const segunda = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(segunda.status, 201)
+  assert.equal(segunda.corpo.reembolso, 2 * 3990)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 3 * 3990)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(demais.status, 422)
+  assert.equal(demais.corpo.erro.codigo, 'quantidade_excede_comprada')
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+})
+
+test('o pedido lista as devoluções, também em GET /pedidos/:id/devolucoes', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoComDoisProdutos(ctx)
+  await entregar(ctx, pedido.id)
+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  ctx.relogio.avancarDias(1)
+  const segunda = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+
+  assert.deepEqual((await buscar(ctx, pedido.id)).devolucoes, [primeira.corpo, segunda.corpo])
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.equal(lista.status, 200)
+  assert.deepEqual(lista.corpo, { itens: [primeira.corpo, segunda.corpo] })
+  assert.equal((await ctx.pedir({ method: 'GET', url: '/pedidos/999/devolucoes' })).status, 404)
+})
+
+test('aceita devolução até 7 dias da entrega e recusa depois', async () => {
+  const ctx = montar()
+  const { caneca, pedido } = await pedidoComDoisProdutos(ctx)
+  await entregar(ctx, pedido.id)
+
+  ctx.relogio.avancarDias(7)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+
+  ctx.relogio.atual = new Date(ctx.relogio.atual.getTime() + 1)
+  const tarde = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(tarde.status, 422)
+  assert.equal(tarde.corpo.erro.codigo, 'prazo_de_devolucao_expirado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 3990)
+})
+
+test('com tudo devolvido, o pedido passa para devolvido, com evento no histórico', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoComDoisProdutos(ctx)
+  await entregar(ctx, pedido.id)
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 3 }])
+  assert.equal((await buscar(ctx, pedido.id)).status, 'entregue')
+
+  ctx.relogio.avancarDias(1)
+  await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 2 }])
+  const depois = await buscar(ctx, pedido.id)
+  assert.equal(depois.status, 'devolvido')
+  assert.equal(depois.devolvidoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(depois.reembolsado, depois.total)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), {
+    de: 'entregue',
+    para: 'devolvido',
+    em: '2026-03-02T12:00:00.000Z',
+  })
+
+  const outra = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'pedido_nao_entregue')
+})
+
+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoComDoisProdutos(ctx)
+  await entregar(ctx, pedido.id)
+  const pedir = (itens: unknown) =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedido.id}/devolucoes`,
+      headers: { 'idempotency-key': 'abc-123' },
+      payload: { itens },
+    })
+
+  const primeira = await pedir([
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  const repetida = await pedir([
+    { produtoId: pires.id, quantidade: 1 },
+    { produtoId: caneca.id, quantidade: 1 },
+  ])
+  assert.equal(primeira.status, 201)
+  assert.equal(repetida.status, 201)
+  assert.deepEqual(repetida.corpo, primeira.corpo)
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+  const depois = await buscar(ctx, pedido.id)
+  assert.equal(depois.reembolsado, 3990 + 1500)
+  assert.equal(depois.devolucoes.length, 1)
+})
+
+test('a mesma Idempotency-Key com outro corpo é recusada com 409', async () => {
+  const ctx = montar()
+  const { caneca, pedido } = await pedidoComDoisProdutos(ctx)
+  await entregar(ctx, pedido.id)
+  const pedir = (quantidade: number) =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedido.id}/devolucoes`,
+      headers: { 'idempotency-key': 'abc-123' },
+      payload: { itens: [{ produtoId: caneca.id, quantidade }] },
+    })
+
+  assert.equal((await pedir(1)).status, 201)
+  const outra = await pedir(2)
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'chave_de_idempotencia_reutilizada')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 3990)
+})
+
+test('recusa devolução de produto fora do pedido, repetido ou acima do comprado, sem mexer em nada', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoComDoisProdutos(ctx)
+  const outro = await criarProduto(ctx, { nome: 'Bule' })
+  await entregar(ctx, pedido.id)
+
+  const casos: [unknown, string][] = [
+    [[{ produtoId: outro.id, quantidade: 1 }], 'item_fora_do_pedido'],
+    [
+      [
+        { produtoId: caneca.id, quantidade: 1 },
+        { produtoId: caneca.id, quantidade: 1 },
+      ],
+      'item_repetido',
+    ],
+    [
+      [
+        { produtoId: pires.id, quantidade: 1 },
+        { produtoId: caneca.id, quantidade: 4 },
+      ],
+      'quantidade_excede_comprada',
+    ],
