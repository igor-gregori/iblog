+/** A `Idempotency-Key` de uma devolução e o corpo com que ela foi pedida. */
+export type Idempotencia = { chave: string; corpo: string }
+
+export function inserirDevolucao(
+  banco: Banco,
+  devolucao: {
+    pedidoId: number
+    reembolso: Centavos
+    criadaEm: string
+    itens: ItemDoPedido[]
+    idempotencia: Idempotencia | null
+  },
+): number {
+  const { lastInsertRowid } = banco
+    .prepare(
+      `INSERT INTO devolucoes (pedido_id, reembolso, criada_em, chave_idempotencia, corpo_idempotencia)
+       VALUES (?, ?, ?, ?, ?)`,
+    )
+    .run(
+      devolucao.pedidoId,
+      devolucao.reembolso,
+      devolucao.criadaEm,
+      devolucao.idempotencia?.chave ?? null,
+      devolucao.idempotencia?.corpo ?? null,
+    )
+  const id = Number(lastInsertRowid)
+  const inserirItem = banco.prepare(
+    'INSERT INTO itens_devolucao (devolucao_id, produto_id, quantidade, preco_unitario) VALUES (?, ?, ?, ?)',
+  )
