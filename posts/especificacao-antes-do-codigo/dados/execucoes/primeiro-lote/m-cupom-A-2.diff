+import type { Banco } from '../banco.ts'
+import type { Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  /** A porcentagem (de 1 a 100), se o cupom for percentual; o valor em centavos, se for fixo. */
+  valor: number
+  /** O último dia em que o cupom vale (inclusive), como `AAAA-MM-DD`, em UTC. */
+  validoAte: string
+  /** O subtotal mínimo do pedido (contando todos os itens, inclusive os em promoção) para o cupom valer. */
+  minimo: Centavos
+}
+
+export type NovoCupom = Omit<Cupom, 'id' | 'minimo'> & { minimo?: Centavos }
+
+type Linha = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  valido_ate: string
+  minimo: number
+}
+
+function paraCupom(linha: Linha): Cupom {
+  return {
+    id: linha.id,
+    codigo: linha.codigo,
+    tipo: linha.tipo,
+    valor: linha.valor,
+    validoAte: linha.valido_ate,
+    minimo: linha.minimo,
+  }
+}
+
+/** Os códigos são guardados e procurados em maiúsculas: `natal10` e `NATAL10` são o mesmo cupom. */
+export function normalizarCodigo(codigo: string): string {
+  return codigo.trim().toUpperCase()
+}
+
+export function buscarCupomPorCodigo(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE codigo = ?').get(normalizarCodigo(codigo)) as
+    | Linha
+    | undefined
+  return linha && paraCupom(linha)
+}
+
+export function inserirCupom(banco: Banco, novo: NovoCupom, criadoEm: string): Cupom {
+  const { lastInsertRowid } = banco
+    .prepare('INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(normalizarCodigo(novo.codigo), novo.tipo, novo.valor, novo.validoAte, novo.minimo ?? 0, criadoEm)
+  const linha = banco.prepare('SELECT * FROM cupons WHERE id = ?').get(Number(lastInsertRowid)) as Linha
+  return paraCupom(linha)
+}
+
+/**
+ * Quanto o cupom tira de `base` (a soma dos itens que aceitam cupom). O percentual arredonda para baixo (nunca dá mais
+ * desconto que a porcentagem), e o desconto nunca passa da base.
+ */
+export function descontoDoCupom(cupom: Cupom, base: Centavos): Centavos {
+  const desconto = cupom.tipo === 'percentual' ? Math.floor((base * cupom.valor) / 100) : cupom.valor
+  return Math.min(desconto, base)
+}
