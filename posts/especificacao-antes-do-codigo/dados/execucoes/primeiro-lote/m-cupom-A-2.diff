+/** O dia de `momento` em UTC, como `AAAA-MM-DD`. Datas sem hora (como a validade de um cupom) são dias em UTC. */
+export function diaEmUtc(momento: Date): string {
+  return momento.toISOString().slice(0, 10)
+}
