@@ -0,0 +1,260 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  return ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-03-31', ...dados },
+  })
+}
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+test('cadastra um cupom, com o código em maiúsculas e mínimo zero por padrão', async () => {
+  const ctx = montar()
+  const { status, corpo } = await criarCupom(ctx, { codigo: ' natal10 ' })
+  assert.equal(status, 201)
+  assert.equal(corpo.codigo, 'NATAL10')
+  assert.equal(corpo.tipo, 'percentual')
+  assert.equal(corpo.valor, 10)
+  assert.equal(corpo.validoAte, '2026-03-31')
+  assert.equal(corpo.minimo, 0)
+})
+
+test('recusa cupom com código repetido, mesmo em outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx)
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'natal10', tipo: 'fixo', valor: 500 })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'cupom_existente')
+})
+
+test('recusa cupom malformado', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { tipo: 'percentual', valor: 101 },
+    { tipo: 'percentual', valor: 0 },
+    { tipo: 'fixo', valor: 0 },
+    { tipo: 'fixo', valor: 9.9 },
+    { tipo: 'brinde' },
+    { validoAte: '2026-02-30' },
+    { validoAte: '31/03/2026' },
+    { codigo: 'com espaço' },
+    { minimo: -1 },
+  ]
+  for (const dados of casos) {
+    const { status } = await criarCupom(ctx, dados)
+    assert.equal(status, 400, JSON.stringify(dados))
+  }
+  assert.equal((await criarCupom(ctx, { tipo: 'fixo', valor: 5000 })).status, 201)
+})
+
+test('cadastra cupom vencido, mas recusa o pedido com ele sem mexer no estoque', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { estoque: 5 })
+  assert.equal((await criarCupom(ctx, { codigo: 'VELHO', validoAte: '2026-02-28' })).status, 201)
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: 'VELHO',
+  })
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_expirado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 5)
+})
+
+test('pedido sem cupom tem desconto zero e total igual ao subtotal', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990 })
+  const { corpo } = await criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: caneca.id, quantidade: 2 }] })
+  assert.equal(corpo.subtotal, 7980)
+  assert.equal(corpo.desconto, 0)
+  assert.equal(corpo.total, 7980)
+  assert.equal(corpo.cupom, null)
+})
+
+test('cupom percentual tira a porcentagem do subtotal, arredondando o desconto para baixo', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3995 })
+  await criarCupom(ctx, { codigo: 'DEZ', valor: 10 })
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: 'dez',
+  })
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3995)
+  assert.equal(corpo.desconto, 399)
+  assert.equal(corpo.total, 3596)
+  assert.equal(corpo.cupom, 'DEZ')
+
+  const salvo = await ctx.pedir({ method: 'GET', url: `/pedidos/${corpo.id}` })
+  assert.equal(salvo.corpo.desconto, 399)
+  assert.equal(salvo.corpo.total, 3596)
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${cliente.id}` })
+  assert.equal(lista.corpo.itens[0].cupom, 'DEZ')
+})
+
+test('cupom fixo tira o valor, sem deixar o total negativo', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990 })
+  await criarCupom(ctx, { codigo: 'MENOS10', tipo: 'fixo', valor: 1000 })
+  await criarCupom(ctx, { codigo: 'MENOS100', tipo: 'fixo', valor: 10000 })
+
+  const dez = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: 'MENOS10',
+  })
+  assert.equal(dez.corpo.desconto, 1000)
+  assert.equal(dez.corpo.total, 2990)
+
+  const cem = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: 'MENOS100',
+  })
+  assert.equal(cem.corpo.desconto, 3990)
+  assert.equal(cem.corpo.total, 0)
+})
+
+test('o mínimo vale sobre o subtotal de todos os itens, e o próprio mínimo basta', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 2000, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 4000, precoPromocional: 3000, estoque: 10 })
+  await criarCupom(ctx, { codigo: 'ACIMA50', minimo: 5000 })
+
+  const abaixo = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 2 }],
+    cupom: 'ACIMA50',
+  })
+  assert.equal(abaixo.status, 422)
+  assert.equal(abaixo.corpo.erro.codigo, 'pedido_abaixo_do_minimo')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+
+  // 2.000 da caneca + 3.000 do pires em promoção: o pires conta para o mínimo, mas não recebe desconto.
+  const exato = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 1 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+    cupom: 'ACIMA50',
+  })
+  assert.equal(exato.status, 201)
+  assert.equal(exato.corpo.subtotal, 5000)
+  assert.equal(exato.corpo.desconto, 200)
+})
+
+test('o cupom vale até o fim do dia de validoAte, em UTC', async () => {
+  const ctx = montar()
+  const ana = await criarCliente(ctx)
+  const bia = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx)
+  await criarCupom(ctx, { codigo: 'HOJE', validoAte: '2026-03-01' })
+  const pedido = { itens: [{ produtoId: caneca.id, quantidade: 1 }], cupom: 'HOJE' }
+
+  ctx.relogio.atual = new Date('2026-03-01T23:59:59Z')
+  assert.equal((await criarPedido(ctx, { clienteId: ana.id, ...pedido })).status, 201)
+
+  ctx.relogio.atual = new Date('2026-03-02T00:00:00Z')
+  const { status, corpo } = await criarPedido(ctx, { clienteId: bia.id, ...pedido })
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_expirado')
+})
+
+test('cada cliente usa o mesmo cupom uma vez só', async () => {
+  const ctx = montar()
+  const ana = await criarCliente(ctx)
+  const bia = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  await criarCupom(ctx, { codigo: 'UMAVEZ' })
+  const pedido = { itens: [{ produtoId: caneca.id, quantidade: 1 }], cupom: 'UMAVEZ' }
+
+  assert.equal((await criarPedido(ctx, { clienteId: ana.id, ...pedido })).status, 201)
+  const deNovo = await criarPedido(ctx, { clienteId: ana.id, ...pedido })
+  assert.equal(deNovo.status, 422)
+  assert.equal(deNovo.corpo.erro.codigo, 'cupom_ja_usado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal((await criarPedido(ctx, { clienteId: bia.id, ...pedido })).status, 201)
+})
+
+test('itens em promoção não recebem o desconto do cupom', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3000 })
