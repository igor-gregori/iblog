+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { test } from 'node:test'
+import { migrar } from '../src/banco.ts'
+
+const PASTA = join(import.meta.dirname, '..', 'src', 'migracoes')
+
+test('a 002 mantém o total dos pedidos que já existiam, sem desconto', () => {
+  const banco = new DatabaseSync(':memory:')
+  banco.exec('PRAGMA foreign_keys = ON')
+  banco.exec('CREATE TABLE migracoes (nome TEXT PRIMARY KEY, aplicada_em TEXT NOT NULL)')
+  banco.exec(readFileSync(join(PASTA, '001_inicial.sql'), 'utf8'))
+  banco.exec("INSERT INTO migracoes VALUES ('001_inicial.sql', 'x')")
+  banco.exec("INSERT INTO clientes (id, nome, email, criado_em) VALUES (1, 'Ana', 'ana@exemplo.com', 'x')")
+  banco.exec("INSERT INTO pedidos (cliente_id, status, total, criado_em) VALUES (1, 'pago', 3990, 'x')")
+
+  migrar(banco)
+
+  assert.deepEqual({ ...banco.prepare('SELECT subtotal, desconto, total, cupom_id FROM pedidos').get() }, {
+    subtotal: 3990,
+    desconto: 0,
+    total: 3990,
+    cupom_id: null,
+  })
+})
