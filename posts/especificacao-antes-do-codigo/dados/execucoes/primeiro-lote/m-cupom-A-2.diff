+
+test('se todos os itens estão em promoção, o cupom é recusado e nada muda', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 2000, precoPromocional: 1500, estoque: 4 })
