+export type FiltrosDeProdutos = {
+  /** Um pedaço do nome, sem ligar para maiúsculas nem acentos. Vazia ou só com espaços, não filtra. */
+  busca?: string
+  /** Faixa do preço de venda (o promocional, se houver), com os dois limites incluídos. */
+  precoMin?: Centavos
+  precoMax?: Centavos
+  /** Começa em 1. */
+  pagina: number
+  porPagina: number
+}
+
+export type PaginaDeProdutos = { itens: Produto[]; total: number; pagina: number; porPagina: number }
+
+/** Uma página dos produtos à venda, em ordem de nome, e quantos produtos atendem aos filtros. */
+export function listarProdutos(banco: Banco, filtros: FiltrosDeProdutos): PaginaDeProdutos {
+  const condicoes = ['ativo = 1']
+  const valores: (string | number)[] = []
+  const busca = normalizar(filtros.busca?.trim() ?? '')
+  if (busca !== '') {
+    condicoes.push("normalizar(nome) LIKE ? ESCAPE '\\'")
+    valores.push(`%${escaparLike(busca)}%`)
+  }
+  if (filtros.precoMin !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) >= ?')
+    valores.push(filtros.precoMin)
+  }
+  if (filtros.precoMax !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) <= ?')
+    valores.push(filtros.precoMax)
+  }
+  const onde = condicoes.join(' AND ')
+
+  const { total } = banco.prepare(`SELECT COUNT(*) AS total FROM produtos WHERE ${onde}`).get(...valores) as {
+    total: number
+  }
+  const linhas = banco
+    .prepare(`SELECT * FROM produtos WHERE ${onde} ORDER BY nome, id LIMIT ? OFFSET ?`)
+    .all(...valores, filtros.porPagina, (filtros.pagina - 1) * filtros.porPagina) as Linha[]
+  return { itens: linhas.map(paraProduto), total, pagina: filtros.pagina, porPagina: filtros.porPagina }
+}
+
+/** Faz `%`, `_` e `\` valerem como texto num `LIKE ... ESCAPE '\'`. */
+function escaparLike(texto: string): string {
+  return texto.replace(/[\\%_]/g, '\\$&')
 }
 
