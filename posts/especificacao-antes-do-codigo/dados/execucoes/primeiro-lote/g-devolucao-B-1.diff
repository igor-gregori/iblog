+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 3 }],
+  })
+  await entregar(ctx, pedido.id)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990, precoPromocional: null } })
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.equal(typeof corpo.id, 'number')
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.deepEqual(corpo.itens, [{ produtoId: caneca.id, quantidade: 2, precoUnitario: 2990 }])
+  assert.equal(corpo.reembolso, 2 * 2990)
+  assert.equal(corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  const depois = await pedidoDe(ctx, pedido.id)
+  assert.equal(depois.reembolsado, 2 * 2990)
+  assert.equal(depois.status, 'entregue')
+})
+
+test('devoluções seguidas somam no reembolsado até devolver tudo', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await montarPedido(ctx)
