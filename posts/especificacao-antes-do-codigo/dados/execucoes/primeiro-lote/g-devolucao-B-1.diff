+
+/** Quantos dias depois da entrega o cliente ainda pode devolver (o direito de arrependimento do CDC). */
+export const PRAZO_DE_DEVOLUCAO_EM_DIAS = 7
+
+const UM_DIA = 24 * 60 * 60 * 1000
+
+/**
+ * Registra a devolução de itens de um pedido entregue: devolve o estoque e reembolsa os itens pelo preço da compra.
+ * Não dá para devolver mais do que foi comprado, somando as devoluções anteriores, nem depois do prazo. Quando tudo
+ * volta, o pedido passa a devolvido.
+ *
+ * Com `chave` (o cabeçalho Idempotency-Key), repetir o pedido com a mesma chave e o mesmo corpo devolve a devolução
+ * já feita, sem mexer em nada; a mesma chave com outro corpo é recusada.
+ */
+export function devolverItens(
+  banco: Banco,
+  pedido: Pedido,
+  nova: NovaDevolucao,
+  agora: Date,
+  chave?: string,
+): Devolucao {
+  const corpo = JSON.stringify({
+    pedidoId: pedido.id,
+    itens: [...nova.itens]
+      .sort((a, b) => a.produtoId - b.produtoId)
+      .map((item) => ({ produtoId: item.produtoId, quantidade: item.quantidade })),
+  })
+  if (chave !== undefined) {
+    const anterior = buscarDevolucaoPorChave(banco, chave)
+    if (anterior) {
+      if (anterior.corpo !== corpo) {
+        throw new Conflito(
+          'chave_de_idempotencia_reutilizada',
+          'Esta Idempotency-Key já foi usada numa devolução diferente',
+        )
+      }
+      return buscarDevolucao(banco, anterior.id)!
+    }
+  }
+
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só um pedido entregue aceita devolução; este está ${pedido.status}`)
+  }
+  const entregueEm = new Date(pedido.entregueEm!).getTime()
+  if (agora.getTime() - entregueEm > PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_encerrado',
+      `A devolução só pode ser feita até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+    )
+  }
+  recusarItemRepetido(nova.itens, 'na devolução')
+
+  const criadaEm = agora.toISOString()
+  const idempotencia = chave === undefined ? undefined : { chave, corpo }
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_maior_que_a_comprada',
+          `Do produto ${item.produtoId} só há ${restante} unidade(s) para devolver`,
+        )
+      }
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const id = inserirDevolucao(banco, { pedidoId: pedido.id, reembolso, criadaEm, itens, idempotencia })
+    for (const item of itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, reembolso)
+
+    const agoraDevolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const tudoDevolvido = pedido.itens.every(
+      (item) => (agoraDevolvidas.get(item.produtoId) ?? 0) >= item.quantidade,
+    )
+    if (tudoDevolvido) mudarStatus(banco, pedido, 'devolvido', agora)
+    return buscarDevolucao(banco, id)!
+  })
+}
