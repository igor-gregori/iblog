+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(primeira.corpo.reembolso, 3990)
+  const segunda = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 2 },
