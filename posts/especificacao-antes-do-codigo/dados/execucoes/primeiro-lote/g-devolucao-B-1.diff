+})
+
+test('recusa devolução de produto fora do pedido ou repetido', async () => {
+  const ctx = montar()
+  const { caneca, pedido } = await montarPedido(ctx)
+  const outro = await criarProduto(ctx, { nome: 'Prato' })
+  await entregar(ctx, pedido.id)
+
+  const casos: [unknown, string][] = [
+    [[{ produtoId: outro.id, quantidade: 1 }], 'item_fora_do_pedido'],
