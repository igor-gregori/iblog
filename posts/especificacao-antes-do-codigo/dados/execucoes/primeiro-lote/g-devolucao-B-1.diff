+/** Devolve `quantidade` ao estoque (pedido cancelado ou itens devolvidos). */
+export function reporEstoque(banco: Banco, id: number, quantidade: number): void {
+  banco.prepare('UPDATE produtos SET estoque = estoque + ? WHERE id = ?').run(quantidade, id)
+}
+
 /** O preço que o cliente paga hoje: o promocional, se houver. */
 export function precoDeVenda(produto: Produto): Centavos {
   return produto.precoPromocional ?? produto.preco
