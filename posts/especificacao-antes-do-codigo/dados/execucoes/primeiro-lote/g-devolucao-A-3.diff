+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { caneca, pedido } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const pedir = () =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedido.id}/devolucoes`,
+      headers: { 'idempotency-key': 'abc-123' },
+      payload: { itens: [{ produtoId: caneca.id, quantidade: 1 }] },
+    })
+
+  const primeira = await pedir()
+  const segunda = await pedir()
+  assert.equal(primeira.status, 201)
+  assert.equal(segunda.status, 201)
+  assert.deepEqual(segunda.corpo, primeira.corpo)
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.reembolsado, 3990)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })).corpo.itens.length, 1)
+})
