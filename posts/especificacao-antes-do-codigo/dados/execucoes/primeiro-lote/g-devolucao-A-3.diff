+
+/** Quantas unidades de cada produto do pedido já foram devolvidas, por id do produto. */
+export function quantidadesDevolvidas(banco: Banco, pedidoId: number): Map<number, number> {
+  const linhas = banco
+    .prepare(
+      `SELECT i.produto_id, SUM(i.quantidade) AS quantidade
+       FROM itens_devolucao i JOIN devolucoes d ON d.id = i.devolucao_id
+       WHERE d.pedido_id = ? GROUP BY i.produto_id`,
+    )
+    .all(pedidoId) as { produto_id: number; quantidade: number }[]
+  return new Map(linhas.map((linha) => [linha.produto_id, linha.quantidade]))
+}
+
+/** De onde veio uma devolução: a chave de idempotência do cliente, se mandou, e o corpo do pedido HTTP. */
+export type OrigemDaDevolucao = {
+  chave: string | null
+  corpo: string
+}
+
+type LinhaDeDevolucao = {
+  id: number
+  pedido_id: number
+  reembolso: number
+  criada_em: string
+  corpo: string | null
+}
+
+function paraDevolucao(banco: Banco, linha: LinhaDeDevolucao): Devolucao {
+  const itens = banco
+    .prepare('SELECT produto_id, quantidade, preco_unitario FROM itens_devolucao WHERE devolucao_id = ? ORDER BY id')
+    .all(linha.id) as LinhaDeItem[]
+  return {
+    id: linha.id,
+    pedidoId: linha.pedido_id,
+    itens: itens.map((item) => ({
+      produtoId: item.produto_id,
+      quantidade: item.quantidade,
+      precoUnitario: item.preco_unitario,
+    })),
+    reembolso: linha.reembolso,
+    criadaEm: linha.criada_em,
+  }
+}
+
+export function inserirDevolucao(banco: Banco, devolucao: Omit<Devolucao, 'id'>, origem: OrigemDaDevolucao): Devolucao {
+  const { lastInsertRowid } = banco
+    .prepare(
+      'INSERT INTO devolucoes (pedido_id, reembolso, criada_em, chave_idempotencia, corpo) VALUES (?, ?, ?, ?, ?)',
+    )
+    .run(devolucao.pedidoId, devolucao.reembolso, devolucao.criadaEm, origem.chave, origem.corpo)
+  const id = Number(lastInsertRowid)
+  const inserirItem = banco.prepare(
+    'INSERT INTO itens_devolucao (devolucao_id, produto_id, quantidade, preco_unitario) VALUES (?, ?, ?, ?)',
+  )
+  for (const item of devolucao.itens) {
+    inserirItem.run(id, item.produtoId, item.quantidade, item.precoUnitario)
+  }
+  return { id, ...devolucao }
+}
+
+/** As devoluções de um pedido, da mais antiga para a mais nova. */
+export function listarDevolucoes(banco: Banco, pedidoId: number): Devolucao[] {
+  const linhas = banco
+    .prepare('SELECT * FROM devolucoes WHERE pedido_id = ? ORDER BY id')
+    .all(pedidoId) as LinhaDeDevolucao[]
+  return linhas.map((linha) => paraDevolucao(banco, linha))
+}
+
+/** A devolução já registrada com esta chave de idempotência, junto com o corpo que veio com ela. */
+export function buscarDevolucaoPorChave(
+  banco: Banco,
+  pedidoId: number,
+  chave: string,
+): { devolucao: Devolucao; corpo: string | null } | undefined {
+  const linha = banco
+    .prepare('SELECT * FROM devolucoes WHERE pedido_id = ? AND chave_idempotencia = ?')
+    .get(pedidoId, chave) as LinhaDeDevolucao | undefined
+  return linha && { devolucao: paraDevolucao(banco, linha), corpo: linha.corpo }
+}
+
