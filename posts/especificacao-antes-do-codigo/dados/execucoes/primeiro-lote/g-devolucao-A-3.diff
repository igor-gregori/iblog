+/** Cancela um pedido que ainda não saiu da loja: o estoque volta e o cliente é reembolsado do total. */
+export function cancelarPedido(banco: Banco, pedido: Pedido, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, pedido.total - pedido.reembolsado)
+    return buscarPedido(banco, pedido.id)!
+  })
+}
+
+/** Quantos dias depois da entrega o cliente ainda pode devolver. */
+export const PRAZO_DE_DEVOLUCAO_EM_DIAS = 7
+
+const UM_DIA_EM_MS = 24 * 60 * 60 * 1000
+
+/** O corpo da devolução numa forma que não depende da ordem dos itens, para comparar repetições. */
+function corpoCanonico(nova: NovaDevolucao): string {
+  const itens = nova.itens
+    .map((item) => ({ produtoId: item.produtoId, quantidade: item.quantidade }))
+    .sort((a, b) => a.produtoId - b.produtoId)
+  return JSON.stringify({ itens })
+}
+
+/**
+ * Registra a devolução de itens de um pedido entregue há no máximo `PRAZO_DE_DEVOLUCAO_EM_DIAS` dias. Cada produto só
+ * pode voltar até a quantidade comprada, somando as devoluções anteriores. O reembolso é pelo preço pago na compra, e
+ * o estoque volta. Quando tudo volta, o pedido passa a devolvido.
+ *
+ * Com `chave` (o cabeçalho Idempotency-Key), repetir a mesma devolução devolve a que já foi registrada, sem repor
+ * estoque nem reembolsar de novo; a mesma chave com outro corpo é um conflito.
+ */
+export function devolverItens(
+  banco: Banco,
+  pedido: Pedido,
+  nova: NovaDevolucao,
+  agora: Date,
+  chave: string | null = null,
+): Devolucao {
+  const corpo = corpoCanonico(nova)
+  if (chave !== null) {
+    const anterior = buscarDevolucaoPorChave(banco, pedido.id, chave)
+    if (anterior) {
+      if (anterior.corpo !== corpo) {
+        throw new Conflito(
+          'chave_de_idempotencia_reusada',
+          'Esta Idempotency-Key já foi usada numa devolução diferente deste pedido',
+        )
+      }
+      return anterior.devolucao
+    }
+  }
+
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só um pedido entregue aceita devolução; este está ${pedido.status}`)
+  }
+  const prazo = new Date(pedido.entregueEm!).getTime() + PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA_EM_MS
+  if (agora.getTime() > prazo) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_encerrado',
+      `A devolução só é aceita até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+    )
+  }
+  const produtos = new Set(nova.itens.map((item) => item.produtoId))
+  if (produtos.size !== nova.itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
+
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está neste pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_acima_da_comprada',
+          `Do produto ${item.produtoId} ainda podem voltar ${restante} unidade(s)`,
+        )
+      }
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    somarReembolso(banco, pedido.id, reembolso)
+    const devolucao = inserirDevolucao(
+      banco,
+      { pedidoId: pedido.id, itens, reembolso, criadaEm: agora.toISOString() },
+      { chave, corpo },
+    )
+
+    const agoraDevolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const tudoVoltou = pedido.itens.every((item) => agoraDevolvidas.get(item.produtoId) === item.quantidade)
+    if (tudoVoltou) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return devolucao
+  })
+}
