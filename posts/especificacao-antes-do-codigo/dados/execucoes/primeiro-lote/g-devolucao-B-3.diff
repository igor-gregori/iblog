@@ -0,0 +1,294 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, estoqueDe, montar, type Contexto } from './ajuda.ts'
+
+async function pedidoPago(ctx: Contexto, itens: { produtoId: number; quantidade: number }[]) {
+  const cliente = await criarCliente(ctx)
+  const { status, corpo } = await criarPedido(ctx, { clienteId: cliente.id, itens })
+  if (status !== 201) throw new Error(`não criou o pedido: ${JSON.stringify(corpo)}`)
+  return corpo
+}
+
+async function pedidoEntregue(ctx: Contexto, itens: { produtoId: number; quantidade: number }[]) {
+  const pedido = await pedidoPago(ctx, itens)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/entregar` })
+  return pedido
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown, chave?: string) {
+  return ctx.pedir({
+    method: 'POST',
+    url: `/pedidos/${pedidoId}/devolucoes`,
+    payload: { itens },
+    headers: chave === undefined ? {} : { 'idempotency-key': chave },
+  })
+}
+
+test('um pedido novo não tem nada reembolsado', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx)
+  const pedido = await pedidoPago(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(pedido.reembolsado, 0)
+  assert.equal(pedido.canceladoEm, null)
+})
+
+test('cancela um pedido pago: estoque de volta, total reembolsado e histórico', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 5 })
+  const pedido = await pedidoPago(ctx, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 3 },
+  ])
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, 2 * 3990 + 3 * 1500)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 5)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela pedido enviado, entregue ou já cancelado', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  const enviado = await pedidoPago(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.id}/enviar` })
+  const entregue = await pedidoEntregue(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  const cancelado = await pedidoPago(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.id}/cancelar` })
+  const estoqueAntes = await estoqueDe(ctx, caneca.id)
+
+  for (const pedido of [enviado, entregue, cancelado]) {
+    const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'transicao_invalida')
+  }
+  assert.equal(await estoqueDe(ctx, caneca.id), estoqueAntes)
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${cancelado.id}` })
+  assert.equal(depois.corpo.reembolsado, cancelado.total)
+})
+
+test('um pedido cancelado não pode mais ser enviado', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx)
+  const pedido = await pedidoPago(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })).status, 409)
+})
+
+test('devolve parte de um pedido entregue, pelo preço pago, e acumula o reembolso', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { preco: 3990, precoPromocional: 2990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const pedido = await pedidoEntregue(ctx, [
+    { produtoId: caneca.id, quantidade: 3 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990, precoPromocional: null } })
+
+  ctx.relogio.avancarDias(5)
+  const primeira = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(primeira.status, 201)
+  assert.equal(primeira.corpo.pedidoId, pedido.id)
+  assert.equal(primeira.corpo.reembolso, 2 * 2990 + 1500)
+  assert.equal(primeira.corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+  assert.deepEqual(primeira.corpo.itens, [
+    { produtoId: caneca.id, quantidade: 2, precoUnitario: 2990 },
+    { produtoId: pires.id, quantidade: 1, precoUnitario: 1500 },
+  ])
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+
+  const segunda = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(segunda.status, 201)
+  assert.equal(segunda.corpo.reembolso, 2990)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 3 * 2990 + 1500)
+})
+
+test('não devolve mais do que foi comprado, contando as devoluções anteriores, e não muda nada', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', estoque: 10 })
+  const pedido = await pedidoEntregue(ctx, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])).status, 201)
+
+  const { status, corpo } = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'quantidade_maior_que_a_comprada')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.reembolsado, pedido.itens[1].precoUnitario)
+})
+
+test('recusa devolução de produto fora do pedido ou repetido', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx)
+  const outro = await criarProduto(ctx, { nome: 'Outro' })
+  const pedido = await pedidoEntregue(ctx, [{ produtoId: caneca.id, quantidade: 2 }])
+
+  const casos: [unknown, string][] = [
+    [[{ produtoId: outro.id, quantidade: 1 }], 'item_fora_do_pedido'],
+    [
+      [
+        { produtoId: caneca.id, quantidade: 1 },
+        { produtoId: caneca.id, quantidade: 1 },
+      ],
+      'item_repetido',
+    ],
+  ]
+  for (const [itens, codigo] of casos) {
+    const { status, corpo } = await devolver(ctx, pedido.id, itens)
+    assert.equal(status, 422, codigo)
+    assert.equal(corpo.erro.codigo, codigo)
+  }
+})
+
+test('só pedido entregue tem devolução', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx)
+  const pago = await pedidoPago(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  const enviado = await pedidoPago(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.id}/enviar` })
+  const cancelado = await pedidoPago(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.id}/cancelar` })
+
+  for (const pedido of [pago, enviado, cancelado]) {
+    const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'pedido_nao_entregue')
+  }
+})
+
+test('recusa corpo de devolução malformado', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx)
+  const pedido = await pedidoEntregue(ctx, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal((await devolver(ctx, pedido.id, [])).status, 400)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 0 }])).status, 400)
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/devolucoes`, payload: {} })).status, 400)
+})
+
+test('404 ao cancelar ou devolver pedido que não existe', async () => {
+  const ctx = montar()
+  assert.equal((await ctx.pedir({ method: 'POST', url: '/pedidos/7/cancelar' })).status, 404)
+  assert.equal((await devolver(ctx, 7, [{ produtoId: 1, quantidade: 1 }])).status, 404)
+  assert.equal((await ctx.pedir({ method: 'GET', url: '/pedidos/7/devolucoes' })).status, 404)
+})
+
+test('o pedido lista as devoluções, da mais antiga para a mais nova', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { preco: 3990 })
+  const pedido = await pedidoEntregue(ctx, [{ produtoId: caneca.id, quantidade: 3 }])
+  const vazia = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.deepEqual(vazia.corpo, { itens: [] })
+
+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  ctx.relogio.avancarDias(1)
+  const segunda = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+
+  const { status, corpo } = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.equal(status, 200)
+  assert.deepEqual(corpo, { itens: [primeira.corpo, segunda.corpo] })
+})
+
+test('devolução depois de 7 dias da entrega é recusada', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  const pedido = await pedidoEntregue(ctx, [{ produtoId: caneca.id, quantidade: 2 }])
+
+  ctx.relogio.avancarDias(7)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+
+  ctx.relogio.atual = new Date(ctx.relogio.atual.getTime() + 1000)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'prazo_de_devolucao_encerrado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+})
+
+test('com tudo devolvido, o pedido passa para devolvido, com evento no histórico', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx)
+  const pires = await criarProduto(ctx, { nome: 'Pires' })
+  const pedido = await pedidoEntregue(ctx, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  let atual = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(atual.corpo.status, 'entregue')
+
+  ctx.relogio.avancarDias(1)
+  await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+  atual = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(atual.corpo.status, 'devolvido')
+  assert.equal(atual.corpo.reembolsado, pedido.total)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'entregue', para: 'devolvido', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', estoque: 10 })
+  const pedido = await pedidoEntregue(ctx, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+
+  const itens = [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ]
+  const primeira = await devolver(ctx, pedido.id, itens, 'abc-123')
+  const repetida = await devolver(ctx, pedido.id, [...itens].reverse(), 'abc-123')
+  assert.equal(repetida.status, 201)
+  assert.deepEqual(repetida.corpo, primeira.corpo)
+
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.reembolsado, primeira.corpo.reembolso)
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.equal(lista.corpo.itens.length, 1)
+})
+
+test('a mesma Idempotency-Key com outro corpo é recusada com 409', async () => {
+  const ctx = montar()
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  const pedido = await pedidoEntregue(ctx, [{ produtoId: caneca.id, quantidade: 3 }])
+  const outro = await pedidoEntregue(ctx, [{ produtoId: caneca.id, quantidade: 3 }])
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }], 'abc-123')
+  for (const [pedidoId, quantidade] of [
+    [pedido.id, 2],
+    [outro.id, 1],
+  ]) {
+    const { status, corpo } = await devolver(ctx, pedidoId, [{ produtoId: caneca.id, quantidade }], 'abc-123')
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'chave_de_idempotencia_reutilizada')
+  }
+  assert.equal(await estoqueDe(ctx, caneca.id), 10 - 6 + 1)
+})
