+
+/** Quantos dias depois da entrega o cliente ainda pode devolver (o direito de arrependimento do CDC). */
+export const PRAZO_DE_DEVOLUCAO_EM_DIAS = 7
+
+const UM_DIA = 24 * 60 * 60 * 1000
+
+/** Os itens de uma devolução numa forma que não depende da ordem, para comparar duas tentativas. */
+function corpoCanonico(nova: NovaDevolucao): string {
+  const itens = nova.itens
+    .map((item) => [item.produtoId, item.quantidade])
+    .sort(([a], [b]) => a - b)
+  return JSON.stringify(itens)
+}
+
+/**
+ * Registra a devolução de itens de um pedido entregue, em até `PRAZO_DE_DEVOLUCAO_EM_DIAS` da entrega. Cada item é
+ * reembolsado pelo preço que foi pago e volta ao estoque. Um pedido pode ter várias devoluções, mas nunca mais do que
+ * foi comprado de cada produto; quando tudo volta, o pedido passa a devolvido.
+ *
+ * Com `chave` (a `Idempotency-Key`), repetir a mesma chave com o mesmo corpo devolve a devolução já registrada, sem
+ * repetir nada; com outro corpo, é um conflito.
+ */
+export function registrarDevolucao(
+  banco: Banco,
+  pedido: Pedido,
+  nova: NovaDevolucao,
+  agora: Date,
+  chave?: string,
+): Devolucao {
+  const corpo = corpoCanonico(nova)
+  if (chave !== undefined) {
+    const anterior = buscarDevolucaoPorChave(banco, chave)
+    if (anterior) {
+      if (anterior.devolucao.pedidoId !== pedido.id || anterior.corpo !== corpo) {
+        throw new Conflito(
+          'chave_de_idempotencia_reutilizada',
+          'Esta Idempotency-Key já foi usada numa devolução diferente',
+        )
+      }
+      return anterior.devolucao
+    }
+  }
+
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só um pedido entregue pode ter devolução; este está ${pedido.status}`)
+  }
+  const entregueEm = new Date(pedido.entregueEm!)
+  if (agora.getTime() - entregueEm.getTime() > PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_encerrado',
+      `A devolução só pode ser feita em até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias da entrega`,
+    )
+  }
+  recusarRepetidos(nova.itens, 'Cada produto aparece uma vez só na devolução; use a quantidade')
+
+  const criadaEm = agora.toISOString()
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_maior_que_a_comprada',
+          `Do produto ${item.produtoId}, só ${restante} ainda pode(m) ser devolvido(s)`,
+        )
+      }
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const id = inserirDevolucao(
+      banco,
+      { pedidoId: pedido.id, itens, reembolso, criadaEm },
+      chave === undefined ? null : { chave, corpo },
+    )
+    for (const item of itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      devolvidas.set(item.produtoId, (devolvidas.get(item.produtoId) ?? 0) + item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, reembolso)
+    if (pedido.itens.every((item) => devolvidas.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return buscarDevolucao(banco, id)!
+  })
+}
