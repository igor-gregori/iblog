+  return Math.min(desconto, semPromocao)
+}
diff --git a/test/cupons.test.ts b/test/cupons.test.ts
new file mode 100644
index 0000000..e9b76ac
--- /dev/null
+++ b/test/cupons.test.ts
@@ -0,0 +1,257 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { test } from 'node:test'
+import { migrar } from '../src/banco.ts'
+import { buscarPedido } from '../src/pedidos/repositorio.ts'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  return ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'BEMVINDO', tipo: 'percentual', valor: 10, validoAte: '2026-03-31', minimo: 0, ...dados },
+  })
+}
+
+/** Um cliente e um produto de R$ 100,00, para pedir com cupom. */
+async function preparar(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco: 10000, estoque: 10 })
+  const pedir = (cupom: string | undefined, quantidade = 1) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom })
+  return { cliente, produto, pedir }
+}
+
+test('cadastra um cupom, com o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await criarCupom(ctx, { codigo: ' natal10 ', minimo: 5000 })
+  assert.equal(status, 201)
+  assert.deepEqual(
+    { ...corpo, id: 0 },
+    { id: 0, codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-03-31', minimo: 5000 },
+  )
+})
+
+test('recusa código repetido, mesmo com outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'NATAL10' })
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'natal10' })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa cupom malformado', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { tipo: 'brinde' },
+    { tipo: 'percentual', valor: 101 },
+    { tipo: 'percentual', valor: 0 },
+    { tipo: 'fixo', valor: 9.9 },
+    { validoAte: '31/03/2026' },
+    { validoAte: '2026-02-30' },
+    { minimo: -1 },
+    { codigo: '' },
+    { codigo: 'com espaço' },
+  ]
+  for (const dados of casos) {
+    const { status, corpo } = await criarCupom(ctx, dados)
+    assert.equal(status, 400, JSON.stringify(dados))
+    assert.equal(corpo.erro.codigo, 'dados_invalidos')
+  }
+  assert.equal((await criarCupom(ctx, { tipo: 'fixo', valor: 5000 })).status, 201)
+})
+
+test('pedido sem cupom: subtotal igual ao total, sem desconto', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  const { corpo } = await pedir(undefined, 2)
+  assert.equal(corpo.subtotal, 20000)
+  assert.equal(corpo.desconto, 0)
+  assert.equal(corpo.total, 20000)
+  assert.equal(corpo.cupom, null)
+})
+
+test('cupom percentual desconta a porcentagem do subtotal', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  const { status, corpo } = await pedir('dez', 2)
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 20000)
+  assert.equal(corpo.desconto, 2000)
+  assert.equal(corpo.total, 18000)
+  assert.equal(corpo.cupom, 'DEZ')
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${corpo.id}` })
+  assert.deepEqual(depois.corpo, corpo)
+})
+
+test('cupom percentual arredonda o desconto para baixo até o centavo', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const bala = await criarProduto(ctx, { nome: 'Bala', preco: 99 })
