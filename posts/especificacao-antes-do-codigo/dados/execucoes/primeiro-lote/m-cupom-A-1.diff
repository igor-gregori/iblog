+import type { FastifyInstance } from 'fastify'
+import { Conflito } from '../erros.ts'
+import { centavos } from '../esquemas.ts'
+import { buscarCupomPorCodigo, inserirCupom, normalizarCodigo, type NovoCupom } from './repositorio.ts'
+
+export async function rotasDeCupons(app: FastifyInstance): Promise<void> {
+  app.post<{ Body: NovoCupom }>(
+    '/cupons',
+    {
+      schema: {
+        body: {
+          type: 'object',
+          required: ['codigo', 'tipo', 'valor', 'validoAte', 'minimo'],
+          additionalProperties: false,
+          properties: {
+            codigo: { type: 'string', pattern: '^\\s*[A-Za-z0-9_-]{1,40}\\s*$' },
+            tipo: { enum: ['percentual', 'fixo'] },
+            valor: { type: 'integer', minimum: 1 },
+            validoAte: { type: 'string', format: 'date' },
+            minimo: centavos,
+          },
+          // Um desconto percentual vai até 100%.
+          anyOf: [
+            { properties: { tipo: { const: 'fixo' } } },
+            { properties: { valor: { type: 'integer', maximum: 100 } } },
+          ],
+        },
+      },
+    },
+    async (pedido, resposta) => {
+      const codigo = normalizarCodigo(pedido.body.codigo)
+      if (buscarCupomPorCodigo(app.banco, codigo)) {
+        throw new Conflito('codigo_em_uso', 'Já existe um cupom com esse código')
+      }
+      const cupom = inserirCupom(app.banco, { ...pedido.body, codigo }, app.agora().toISOString())
+      return resposta.code(201).send(cupom)
+    },
+  )
+}
