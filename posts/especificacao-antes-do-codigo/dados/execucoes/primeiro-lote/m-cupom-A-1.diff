+ * com o subtotal de todos os itens no mínimo, ainda não usado pelo cliente e com algum item fora de promoção.
+ */
+function cupomValido(
+  banco: Banco,
+  codigo: string,
+  pedido: { clienteId: number; subtotal: Centavos; semPromocao: Centavos; agora: Date },
+): Cupom {
+  const cupom = buscarCupomPorCodigo(banco, normalizarCodigo(codigo))
+  if (!cupom) {
+    throw new ErroDeNegocio('cupom_inexistente', 'Cupom não encontrado')
+  }
+  if (pedido.agora.toISOString().slice(0, 10) > cupom.validoAte) {
+    throw new ErroDeNegocio('cupom_vencido', `O cupom ${cupom.codigo} valia até ${cupom.validoAte}`)
+  }
+  if (pedido.subtotal < cupom.minimo) {
+    throw new ErroDeNegocio(
+      'pedido_abaixo_do_minimo',
+      `O cupom ${cupom.codigo} vale para pedidos a partir de ${formatar(cupom.minimo)}`,
+    )
+  }
+  if (clienteJaUsouCupom(banco, pedido.clienteId, cupom.id)) {
+    throw new ErroDeNegocio('cupom_ja_usado', `O cupom ${cupom.codigo} já foi usado por este cliente`)
+  }
