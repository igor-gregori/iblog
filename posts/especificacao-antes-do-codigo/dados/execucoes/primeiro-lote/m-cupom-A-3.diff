+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { DatabaseSync } from 'node:sqlite'
+import { test } from 'node:test'
+import { migrar } from '../src/banco.ts'
+import { criarCliente, criarCupom, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Um cliente e um produto de `preco` para os pedidos do teste. */
+async function preparar(ctx: Contexto, preco = 10000) {
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco, estoque: 10 })
+  const pedir = (cupom?: string, quantidade = 1) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom })
+  return { cliente, produto, pedir }
+}
+
+test('cadastra um cupom e guarda o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'natal10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 },
+  })
+  assert.equal(status, 201)
+  assert.deepEqual(
+    { ...corpo, id: 0 },
+    { id: 0, codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 },
+  )
+  const buscado = await ctx.pedir({ method: 'GET', url: '/cupons/Natal10' })
+  assert.equal(buscado.corpo.id, corpo.id)
+  assert.equal((await ctx.pedir({ method: 'GET', url: '/cupons/NAOEXISTE' })).status, 404)
+})
+
+test('o mínimo é opcional e começa em zero', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx)
+  assert.equal(cupom.minimo, 0)
+})
+
+test('recusa código repetido, mesmo com outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'FRETE' })
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
