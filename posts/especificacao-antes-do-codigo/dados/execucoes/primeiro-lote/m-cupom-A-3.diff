+import type { FastifyInstance } from 'fastify'
+import { Conflito, NaoEncontrado } from '../erros.ts'
+import { centavos } from '../esquemas.ts'
+import { buscarCupomPorCodigo, inserirCupom, type NovoCupom } from './repositorio.ts'
+
+export async function rotasDeCupons(app: FastifyInstance): Promise<void> {
+  app.post<{ Body: NovoCupom }>(
+    '/cupons',
+    {
+      schema: {
+        body: {
+          type: 'object',
+          required: ['codigo', 'tipo', 'valor', 'validoAte'],
+          additionalProperties: false,
+          properties: {
+            codigo: { type: 'string', pattern: '^[A-Za-z0-9_-]{1,40}$' },
+            tipo: { type: 'string', enum: ['percentual', 'fixo'] },
+            valor: { type: 'integer', minimum: 1 },
+            validoAte: { type: 'string', format: 'date' },
+            minimo: centavos,
+          },
+          // Um desconto percentual vai até 100%.
+          anyOf: [{ properties: { tipo: { const: 'fixo' } } }, { properties: { valor: { maximum: 100 } } }],
+        },
+      },
+    },
+    async (pedido, resposta) => {
+      if (buscarCupomPorCodigo(app.banco, pedido.body.codigo)) {
+        throw new Conflito('codigo_em_uso', 'Já existe um cupom com esse código')
+      }
+      const cupom = inserirCupom(app.banco, pedido.body, app.agora().toISOString())
+      return resposta.code(201).send(cupom)
+    },
+  )
+
+  app.get<{ Params: { codigo: string } }>('/cupons/:codigo', async (pedido) => {
+    const cupom = buscarCupomPorCodigo(app.banco, pedido.params.codigo)
+    if (!cupom) throw new NaoEncontrado('Cupom')
+    return cupom
+  })
+}
