+/**
+ * Registra a devolução de itens de um pedido entregue há até 7 dias. Cada item é reembolsado pelo preço que o cliente
+ * pagou, e não dá para devolver mais unidades do que foram compradas, somando as devoluções anteriores. Quando tudo
+ * volta, o pedido passa para devolvido.
+ *
+ * Com `chaveDeIdempotencia`, repetir a requisição devolve a devolução já feita, sem fazer outra; a mesma chave com
+ * outro corpo (ou outro pedido) é recusada.
+ */
+export function devolverItens(
+  banco: Banco,
+  pedido: Pedido,
+  nova: NovaDevolucao,
+  agora: Date,
+  chaveDeIdempotencia?: string,
+): Devolucao {
+  const idempotencia: Idempotencia | undefined = chaveDeIdempotencia
+    ? {
+        chave: chaveDeIdempotencia,
+        corpo: JSON.stringify({
+          pedidoId: pedido.id,
+          itens: nova.itens.map((item) => ({ produtoId: item.produtoId, quantidade: item.quantidade })),
+        }),
+      }
+    : undefined
+  if (idempotencia) {
+    const anterior = buscarDevolucaoPelaChave(banco, idempotencia.chave)
+    if (anterior) {
+      if (anterior.corpo !== idempotencia.corpo) {
+        throw new Conflito(
+          'chave_de_idempotencia_reutilizada',
+          'Esta Idempotency-Key já foi usada numa requisição diferente',
+        )
+      }
+      return anterior.devolucao
+    }
+  }
+
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só um pedido entregue aceita devolução; este está ${pedido.status}`)
+  }
+  const prazo = new Date(pedido.entregueEm!).getTime() + PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA_EM_MS
+  if (agora.getTime() > prazo) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_expirado',
+      `A devolução só é aceita até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+    )
+  }
