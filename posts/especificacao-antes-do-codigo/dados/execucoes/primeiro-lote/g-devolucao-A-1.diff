+
+/** Quantas unidades de cada produto do pedido já foram devolvidas, somando todas as devoluções. */
+export function quantidadesDevolvidas(banco: Banco, pedidoId: number): Map<number, number> {
+  const linhas = banco
+    .prepare(
+      `SELECT i.produto_id, SUM(i.quantidade) AS quantidade
+       FROM itens_devolucao i JOIN devolucoes d ON d.id = i.devolucao_id
+       WHERE d.pedido_id = ?
+       GROUP BY i.produto_id`,
+    )
+    .all(pedidoId) as { produto_id: number; quantidade: number }[]
+  return new Map(linhas.map((linha) => [linha.produto_id, linha.quantidade]))
+}
+
+/** O que identifica uma requisição repetida: o cabeçalho Idempotency-Key e o corpo que veio com ele. */
+export type Idempotencia = { chave: string; corpo: string }
+
+export function inserirDevolucao(
+  banco: Banco,
+  devolucao: { pedidoId: number; reembolso: Centavos; criadaEm: string; itens: ItemDoPedido[] },
+  idempotencia?: Idempotencia,
+): number {
+  const { lastInsertRowid } = banco
+    .prepare(
+      `INSERT INTO devolucoes (pedido_id, reembolso, criada_em, chave_de_idempotencia, corpo_da_requisicao)
+       VALUES (?, ?, ?, ?, ?)`,
+    )
+    .run(
+      devolucao.pedidoId,
+      devolucao.reembolso,
+      devolucao.criadaEm,
+      idempotencia?.chave ?? null,
+      idempotencia?.corpo ?? null,
+    )
+  const id = Number(lastInsertRowid)
+  const inserirItem = banco.prepare(
+    'INSERT INTO itens_devolucao (devolucao_id, produto_id, quantidade, preco_unitario) VALUES (?, ?, ?, ?)',
+  )
+  for (const item of devolucao.itens) {
+    inserirItem.run(id, item.produtoId, item.quantidade, item.precoUnitario)
+  }
+  return id
+}
+
+function paraDevolucao(banco: Banco, linha: LinhaDeDevolucao): Devolucao {
+  const itens = banco
+    .prepare('SELECT produto_id, quantidade, preco_unitario FROM itens_devolucao WHERE devolucao_id = ? ORDER BY id')
+    .all(linha.id) as LinhaDeItem[]
+  return {
+    id: linha.id,
+    pedidoId: linha.pedido_id,
+    itens: itens.map(paraItem),
+    reembolso: linha.reembolso,
+    criadaEm: linha.criada_em,
+  }
+}
+
+export function buscarDevolucao(banco: Banco, id: number): Devolucao | undefined {
+  const linha = banco.prepare('SELECT * FROM devolucoes WHERE id = ?').get(id) as LinhaDeDevolucao | undefined
+  return linha && paraDevolucao(banco, linha)
+}
+
+/** A devolução feita com esta Idempotency-Key, se houver, e o corpo que veio com ela. */
+export function buscarDevolucaoPelaChave(
+  banco: Banco,
+  chave: string,
+): { devolucao: Devolucao; corpo: string } | undefined {
+  const linha = banco.prepare('SELECT * FROM devolucoes WHERE chave_de_idempotencia = ?').get(chave) as
+    | LinhaDeDevolucao
+    | undefined
+  return linha && { devolucao: paraDevolucao(banco, linha), corpo: linha.corpo_da_requisicao ?? '' }
+}
+
+export function devolucoesDoPedido(banco: Banco, pedidoId: number): Devolucao[] {
+  const linhas = banco
+    .prepare('SELECT * FROM devolucoes WHERE pedido_id = ? ORDER BY id')
+    .all(pedidoId) as LinhaDeDevolucao[]
+  return linhas.map((linha) => paraDevolucao(banco, linha))
+}
