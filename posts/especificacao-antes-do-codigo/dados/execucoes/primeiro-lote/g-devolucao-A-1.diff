+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+/** Um pedido de 3 canecas (R$ 39,90) e 1 pires (R$ 15,00), feito com 10 de cada no estoque. */
+async function pedidoDeExemplo(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+  })
+  return { pedido, caneca, pires }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number): Promise<void> {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown) {
+  return ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/devolucoes`, payload: { itens } })
+}
+
+test('um pedido novo não tem nada reembolsado', async () => {
+  const ctx = montar()
+  const { pedido } = await pedidoDeExemplo(ctx)
+  assert.equal(pedido.reembolsado, 0)
+})
+
+test('cancela um pedido pago: o estoque volta, o total é reembolsado e fica no histórico', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, 3 * 3990 + 1500)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela um pedido enviado, nem cancela duas vezes, nem envia um cancelado', async () => {
+  const ctx = montar()
+  const { pedido: enviado, caneca } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.id}/enviar` })
+  const recusado = await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.id}/cancelar` })
+  assert.equal(recusado.status, 409)
+  assert.equal(recusado.corpo.erro.codigo, 'transicao_invalida')
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+
+  const { pedido: cancelado } = await pedidoDeExemplo(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.id}/cancelar` })
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.id}/cancelar` })).status, 409)
+  assert.equal((await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.id}/enviar` })).status, 409)
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${cancelado.id}` })
+  assert.equal(depois.corpo.reembolsado, 3 * 3990 + 1500)
+})
+
+test('devolve itens de um pedido entregue, pelo preço pago, e o estoque volta', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  // O preço muda depois da compra; o reembolso é pelo que o cliente pagou.
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.equal(corpo.reembolso, 2 * 3990)
+  assert.equal(corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+  assert.deepEqual(corpo.itens, [{ produtoId: caneca.id, quantidade: 2, precoUnitario: 3990 }])
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 2 * 3990)
+})
+
+test('várias devoluções somam no reembolsado, até o limite do que foi comprado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(demais.status, 422)
+  assert.equal(demais.corpo.erro.codigo, 'quantidade_excede_compra')
+
+  const segunda = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(segunda.status, 201)
+  assert.equal(segunda.corpo.reembolso, 3990 + 1500)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.reembolsado, depois.corpo.total)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+})
+
+test('com tudo devolvido, o pedido passa para devolvido e não aceita outra devolução', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 3 }])
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.status, 'entregue')
+
+  ctx.relogio.avancarDias(1)
+  await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'devolvido')
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'entregue', para: 'devolvido', em: '2026-03-02T12:00:00.000Z' })
+
+  const outra = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'pedido_nao_entregue')
+})
+
+test('aceita devolução até 7 dias depois da entrega, e recusa depois disso', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  ctx.relogio.avancarDias(7)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+  ctx.relogio.avancarDias(1)
+  const tarde = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(tarde.status, 422)
+  assert.equal(tarde.corpo.erro.codigo, 'prazo_de_devolucao_expirado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+})
+
+test('o pedido lista as devoluções', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  const segunda = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.deepEqual(lista.corpo, { itens: [primeira.corpo, segunda.corpo] })
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.deepEqual(depois.corpo.devolucoes, [primeira.corpo, segunda.corpo])
+})
+
+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const requisicao = {
+    method: 'POST' as const,
+    url: `/pedidos/${pedido.id}/devolucoes`,
+    headers: { 'idempotency-key': 'abc-123' },
+    payload: { itens: [{ produtoId: caneca.id, quantidade: 1 }] },
+  }
+
+  const primeira = await ctx.pedir(requisicao)
+  const repetida = await ctx.pedir(requisicao)
+  assert.equal(primeira.status, 201)
+  assert.equal(repetida.status, 201)
+  assert.deepEqual(repetida.corpo, primeira.corpo)
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.reembolsado, 3990)
+  assert.equal(depois.corpo.devolucoes.length, 1)
+})
+
+test('a mesma Idempotency-Key com outro corpo é recusada com 409', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+  const comChave = (quantidade: number) =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedido.id}/devolucoes`,
+      headers: { 'idempotency-key': 'abc-123' },
+      payload: { itens: [{ produtoId: caneca.id, quantidade }] },
+    })
+
+  await comChave(1)
+  const outra = await comChave(2)
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'chave_de_idempotencia_reutilizada')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+})
+
+test('uma devolução recusada não muda nada, nem nos itens que estavam certos', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoDeExemplo(ctx)
+  await entregar(ctx, pedido.id)
+
+  const { status } = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 2 },
+  ])
+  assert.equal(status, 422)
+  assert.equal(await estoqueDe(ctx, caneca.id), 7)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+  assert.equal((await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })).corpo.reembolsado, 0)
+})
+
