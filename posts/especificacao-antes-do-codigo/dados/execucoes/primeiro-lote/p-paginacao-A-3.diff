+
+const nomes = (corpo: { itens: { nome: string }[] }) => corpo.itens.map((p) => p.nome)
+
+test('pagina a lista, com o total de produtos', async () => {
+  const ctx = montar()
+  for (const nome of ['E', 'D', 'C', 'B', 'A']) await criarProduto(ctx, { nome })
+
+  const primeira = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=1&porPagina=2' })
+  assert.equal(primeira.status, 200)
+  assert.deepEqual(nomes(primeira.corpo), ['A', 'B'])
+  assert.equal(primeira.corpo.total, 5)
+
+  const ultima = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=3&porPagina=2' })
+  assert.deepEqual(nomes(ultima.corpo), ['E'])
+  assert.equal(ultima.corpo.total, 5)
+
+  const depoisDoFim = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=4&porPagina=2' })
+  assert.deepEqual(depoisDoFim.corpo, { itens: [], total: 5, pagina: 4, porPagina: 2 })
+})
+
+test('sem parâmetros, devolve a primeira página de 20 e diz a página e o tamanho', async () => {
+  const ctx = montar()
+  for (let i = 0; i < 25; i++) await criarProduto(ctx, { nome: `Produto ${String(i).padStart(2, '0')}` })
+  const { corpo } = await ctx.pedir({ method: 'GET', url: '/produtos' })
+  assert.equal(corpo.itens.length, 20)
+  assert.equal(corpo.itens[0].nome, 'Produto 00')
+  assert.equal(corpo.total, 25)
+  assert.equal(corpo.pagina, 1)
+  assert.equal(corpo.porPagina, 20)
+})
+
+test('busca não diferencia maiúsculas nem acentos', async () => {
+  const ctx = montar()
+  await criarProduto(ctx, { nome: 'Xícara' })
+  await criarProduto(ctx, { nome: 'AÇÚCAR' })
+  await criarProduto(ctx, { nome: 'Pires' })
+
+  assert.deepEqual(nomes((await ctx.pedir({ method: 'GET', url: '/produtos?busca=XICARA' })).corpo), ['Xícara'])
+  assert.deepEqual(nomes((await ctx.pedir({ method: 'GET', url: '/produtos?busca=açúcar' })).corpo), ['AÇÚCAR'])
+  assert.deepEqual(nomes((await ctx.pedir({ method: 'GET', url: '/produtos?busca=acucar' })).corpo), ['AÇÚCAR'])
+})
+
+test('busca vazia ou só com espaços não filtra, e os espaços das pontas são ignorados', async () => {
+  const ctx = montar()
+  await criarProduto(ctx, { nome: 'Caneca azul' })
