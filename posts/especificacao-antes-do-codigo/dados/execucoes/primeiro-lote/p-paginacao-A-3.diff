+export type FiltrosDeProdutos = {
+  /** Trecho do nome, sem diferença de maiúsculas nem de acentos. Vazio ou só espaços não filtra. */
+  busca?: string
+  /** Faixa do preço de venda (o promocional, se houver), com as pontas incluídas. */
+  precoMin?: Centavos
+  precoMax?: Centavos
+}
+
+export type Pagina = {
+  pagina: number
+  porPagina: number
+}
+
+/** Os produtos à venda que atendem aos filtros, em ordem de nome, uma página por vez. `total` conta todas as páginas. */
+export function listarProdutosAtivos(
+  banco: Banco,
+  filtros: FiltrosDeProdutos,
+  { pagina, porPagina }: Pagina,
+): { itens: Produto[]; total: number } {
+  const condicoes = ['ativo = 1']
+  const valores: (string | number)[] = []
+  const busca = normalizar(filtros.busca?.trim() ?? '')
+  if (busca) {
+    condicoes.push("normalizar(nome) LIKE ? ESCAPE '\\'")
+    valores.push(`%${busca.replace(/[\\%_]/g, '\\$&')}%`)
+  }
+  if (filtros.precoMin !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) >= ?')
+    valores.push(filtros.precoMin)
+  }
+  if (filtros.precoMax !== undefined) {
+    condicoes.push('COALESCE(preco_promocional, preco) <= ?')
+    valores.push(filtros.precoMax)
+  }
+  const onde = condicoes.join(' AND ')
+
+  const { total } = banco.prepare(`SELECT COUNT(*) AS total FROM produtos WHERE ${onde}`).get(...valores) as {
+    total: number
+  }
+  const linhas = banco
+    .prepare(`SELECT * FROM produtos WHERE ${onde} ORDER BY nome, id LIMIT ? OFFSET ?`)
+    .all(...valores, porPagina, (pagina - 1) * porPagina) as Linha[]
+  return { itens: linhas.map(paraProduto), total }
 }
 
