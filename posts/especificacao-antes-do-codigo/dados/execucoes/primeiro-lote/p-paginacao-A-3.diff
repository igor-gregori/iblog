index 0000000..f09d26f
--- /dev/null
+++ b/src/texto.ts
@@ -0,0 +1,4 @@
+/** O texto em minúsculas e sem acentos, para comparar nomes: "Xícara" e "XICARA" viram "xicara". */
+export function normalizar(texto: string): string {
+  return texto.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase()
+}
