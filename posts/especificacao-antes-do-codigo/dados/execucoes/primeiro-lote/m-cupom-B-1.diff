diff --git a/test/cupons.test.ts b/test/cupons.test.ts
new file mode 100644
index 0000000..d5c51d8
--- /dev/null
+++ b/test/cupons.test.ts
@@ -0,0 +1,214 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarCupom, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+function cadastrar(ctx: Contexto, payload: Record<string, unknown>) {
+  return ctx.pedir({ method: 'POST', url: '/cupons', payload })
+}
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+const cupomValido = { codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 }
+
+test('cadastra um cupom', async () => {
+  const ctx = montar()
+  const { status, corpo } = await cadastrar(ctx, cupomValido)
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, { id: corpo.id, ...cupomValido })
+})
+
+test('sem mínimo, o mínimo é zero', async () => {
+  const ctx = montar()
+  const { status, corpo } = await cadastrar(ctx, { ...cupomValido, minimo: undefined })
+  assert.equal(status, 201)
+  assert.equal(corpo.minimo, 0)
+})
+
+test('o código não diferencia maiúsculas: é guardado e devolvido em maiúsculas', async () => {
+  const ctx = montar()
+  const { corpo } = await cadastrar(ctx, { ...cupomValido, codigo: 'Natal10' })
+  assert.equal(corpo.codigo, 'NATAL10')
+
+  const repetido = await cadastrar(ctx, { ...cupomValido, codigo: 'natal10' })
+  assert.equal(repetido.status, 409)
+  assert.equal(repetido.corpo.erro.codigo, 'codigo_em_uso')
+
+  const pedido = await pedidoCom(ctx, 'natal10', 6000)
+  assert.equal(pedido.status, 201)
+  assert.equal(pedido.corpo.cupom, 'NATAL10')
+})
+
+test('cadastro recusa porcentagem fora de 1 a 100, valor zero e data inválida', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { ...cupomValido, valor: 101 },
+    { ...cupomValido, valor: 0 },
+    { ...cupomValido, tipo: 'fixo', valor: 0 },
+    { ...cupomValido, valor: 9.5 },
+    { ...cupomValido, validoAte: '25/12/2026' },
+    { ...cupomValido, validoAte: '2026-02-30' },
+    { ...cupomValido, validoAte: '2026-12-25T00:00:00Z' },
+    { ...cupomValido, tipo: 'brinde' },
+    { ...cupomValido, minimo: -1 },
+    { ...cupomValido, codigo: '' },
+    { codigo: 'SEMDATA', tipo: 'fixo', valor: 100 },
+  ]
+  for (const payload of casos) {
+    assert.equal((await cadastrar(ctx, payload)).status, 400, JSON.stringify(payload))
+  }
+  assert.equal((await cadastrar(ctx, { ...cupomValido, valor: 100 })).status, 201)
+  assert.equal((await cadastrar(ctx, { ...cupomValido, codigo: 'FIXO', tipo: 'fixo', valor: 15000 })).status, 201)
+})
+
+/** Um pedido de um cliente novo, com um produto sem promoção. */
+async function pedidoCom(ctx: Contexto, cupom: string | undefined, preco = 3995, quantidade = 1) {
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco, estoque: 10 })
+  return criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: produto.id, quantidade }], cupom })
+}
+
+test('cupom percentual arredonda o desconto para baixo', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx, { tipo: 'percentual', valor: 10 })
+  const { status, corpo } = await pedidoCom(ctx, cupom.codigo, 3995)
+  assert.equal(status, 201)
+  assert.deepEqual([corpo.subtotal, corpo.desconto, corpo.total], [3995, 399, 3596])
+  assert.equal(corpo.cupom, cupom.codigo)
+
+  const salvo = await ctx.pedir({ method: 'GET', url: `/pedidos/${corpo.id}` })
+  assert.deepEqual(salvo.corpo, corpo)
+})
+
+test('cupom fixo tira o valor, e nunca mais que o subtotal', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx, { tipo: 'fixo', valor: 1000 })
+  const { corpo } = await pedidoCom(ctx, cupom.codigo, 3990)
+  assert.deepEqual([corpo.subtotal, corpo.desconto, corpo.total], [3990, 1000, 2990])
+
+  const grande = await criarCupom(ctx, { tipo: 'fixo', valor: 10000 })
+  const { corpo: gratis } = await pedidoCom(ctx, grande.codigo, 3990)
+  assert.deepEqual([gratis.subtotal, gratis.desconto, gratis.total], [3990, 3990, 0])
+})
+
+test('itens em promoção não recebem o desconto do cupom', async () => {
