+import type { Centavos } from '../dinheiro.ts'
+import type { Cupom } from './repositorio.ts'
+
+/** O cupom ainda vale em `agora`: `validoAte` inclui o próprio dia, em UTC. */
+export function cupomVale(cupom: Cupom, agora: Date): boolean {
+  return agora.toISOString().slice(0, 10) <= cupom.validoAte
+}
+
+/**
+ * Quanto o cupom tira de `base` (o valor dos itens que recebem desconto). O percentual arredonda para baixo; o fixo
+ * nunca passa da base.
+ */
+export function calcularDesconto(cupom: Cupom, base: Centavos): Centavos {
+  const desconto = cupom.tipo === 'percentual' ? Math.floor((base * cupom.valor) / 100) : cupom.valor
+  return Math.min(desconto, base)
+}
