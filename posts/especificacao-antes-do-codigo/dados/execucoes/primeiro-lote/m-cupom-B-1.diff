+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 3000, precoPromocional: 2000 })
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 1 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+    cupom: cupom.codigo,
+  })
+  assert.equal(status, 201)
+  assert.deepEqual([corpo.subtotal, corpo.desconto, corpo.total], [6000, 400, 5600])
+})
+
+test('o desconto fixo não passa do valor dos itens sem promoção', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx, { tipo: 'fixo', valor: 5000 })
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 1500 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 9000, precoPromocional: 8000 })
+  const { corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 2 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+    cupom: cupom.codigo,
+  })
+  assert.deepEqual([corpo.subtotal, corpo.desconto, corpo.total], [11000, 3000, 8000])
+})
+
+test('se todos os itens estão em promoção, o cupom é recusado e nada muda', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx)
+  const cliente = await criarCliente(ctx)
+  const pires = await criarProduto(ctx, { preco: 3000, precoPromocional: 2000, estoque: 5 })
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: pires.id, quantidade: 1 }],
+    cupom: cupom.codigo,
+  })
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_sem_itens_elegiveis')
+  assert.equal(await estoqueDe(ctx, pires.id), 5)
+  assert.deepEqual((await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${cliente.id}` })).corpo.itens, [])
+})
+
+test('o mínimo vale sobre o subtotal de todos os itens, e o próprio mínimo basta', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx, { minimo: 8000 })
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 4000, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 5000, precoPromocional: 4000, estoque: 10 })
+
+  const abaixo = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: cupom.codigo,
+  })
+  assert.equal(abaixo.status, 422)
+  assert.equal(abaixo.corpo.erro.codigo, 'cupom_abaixo_do_minimo')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+
+  // 4000 sem promoção + 4000 em promoção = 8000, o mínimo; o desconto só vale sobre os 4000 sem promoção.
+  const igual = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 1 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+    cupom: cupom.codigo,
+  })
+  assert.equal(igual.status, 201)
+  assert.deepEqual([igual.corpo.subtotal, igual.corpo.desconto, igual.corpo.total], [8000, 400, 7600])
+})
+
+test('cada cliente usa o mesmo cupom uma vez só', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx)
+  const ana = await criarCliente(ctx)
+  const bia = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { estoque: 10 })
+  const pedir = (clienteId: number) =>
+    criarPedido(ctx, { clienteId, itens: [{ produtoId: caneca.id, quantidade: 1 }], cupom: cupom.codigo })
+
+  assert.equal((await pedir(ana.id)).status, 201)
+  const segunda = await pedir(ana.id)
+  assert.equal(segunda.status, 422)
+  assert.equal(segunda.corpo.erro.codigo, 'cupom_ja_usado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal((await pedir(bia.id)).status, 201)
+
+  // Sem cupom, a Ana continua comprando.
+  const semCupom = await criarPedido(ctx, { clienteId: ana.id, itens: [{ produtoId: caneca.id, quantidade: 1 }] })
+  assert.equal(semCupom.status, 201)
+})
+
+test('o cupom vale até o fim do dia de validoAte, em UTC', async () => {
+  const ctx = montar()
+  const cupom = await criarCupom(ctx, { validoAte: '2026-03-01' })
+
+  ctx.relogio.atual = new Date('2026-03-01T23:59:59Z')
+  assert.equal((await pedidoCom(ctx, cupom.codigo)).status, 201)
+
+  ctx.relogio.atual = new Date('2026-03-02T00:00:00Z')
+  const { status, corpo } = await pedidoCom(ctx, cupom.codigo)
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_expirado')
+})
+
+test('cupom inexistente é recusado', async () => {
+  const ctx = montar()
+  const { status, corpo } = await pedidoCom(ctx, 'NAOEXISTE')
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_inexistente')
+})
