+test('devolve itens de um pedido entregue: o estoque volta e o reembolso é pelo preço pago', async () => {
+  const ctx = montar()
+  const { caneca, pires, pedido } = await pedidoDeCanecasEPires(ctx)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+  await entregar(ctx, pedido.id)
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(status, 201)
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.equal(corpo.reembolso, 2 * 3990 + 1500)
+  assert.equal(corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+  assert.deepEqual(corpo.itens, [
+    { produtoId: caneca.id, quantidade: 2, precoUnitario: 3990 },
+    { produtoId: pires.id, quantidade: 1, precoUnitario: 1500 },
+  ])
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 9)
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.status, 'entregue')
+  assert.equal(depois.corpo.reembolsado, 2 * 3990 + 1500)
+})
