+/** Cancela um pedido que ainda não foi enviado: o estoque volta e o total inteiro é reembolsado. */
+export function cancelarPedido(banco: Banco, pedido: Pedido, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarAoReembolsado(banco, pedido.id, pedido.total)
+    return buscarPedido(banco, pedido.id)!
+  })
+}
+
+export type NovaDevolucao = {
+  itens: { produtoId: number; quantidade: number }[]
+}
+
+export const PRAZO_DE_DEVOLUCAO_EM_DIAS = 7
+
+/**
+ * Registra a devolução de itens de um pedido entregue há no máximo `PRAZO_DE_DEVOLUCAO_EM_DIAS`: cada item volta ao
+ * estoque e é reembolsado pelo preço que o cliente pagou. Um pedido pode ter várias devoluções, mas nunca devolver
+ * mais do que foi comprado; quando tudo volta, o pedido passa a devolvido.
+ *
+ * Com `chave` (a `Idempotency-Key`), repetir o mesmo pedido devolve a devolução já feita (com `repetida`), sem repor
+ * estoque nem reembolsar de novo; usar a mesma chave com outro corpo é um conflito.
+ */
+export function devolverItens(
+  banco: Banco,
+  pedido: Pedido,
+  nova: NovaDevolucao,
+  agora: Date,
+  chave?: string,
+): { devolucao: Devolucao; repetida: boolean } {
+  const idempotencia = chave === undefined ? undefined : { chave, corpo: corpoParaIdempotencia(pedido.id, nova) }
+  if (idempotencia) {
+    const anterior = buscarDevolucaoPelaChave(banco, idempotencia.chave)
+    if (anterior && anterior.corpo !== idempotencia.corpo) {
+      throw new Conflito(
+        'chave_de_idempotencia_reutilizada',
+        'Esta Idempotency-Key já foi usada numa devolução diferente',
+      )
+    }
+    if (anterior) return { devolucao: anterior.devolucao, repetida: true }
+  }
+
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só um pedido entregue aceita devolução; este está ${pedido.status}`)
+  }
+  const prazo = new Date(pedido.entregueEm!).getTime() + PRAZO_DE_DEVOLUCAO_EM_DIAS * 24 * 60 * 60 * 1000
+  if (agora.getTime() > prazo) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_encerrado',
+      `A devolução só é aceita até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+    )
+  }
+  const produtos = new Set(nova.itens.map((item) => item.produtoId))
+  if (produtos.size !== nova.itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
+
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_acima_da_comprada',
+          `Do produto ${item.produtoId} só ${restante} unidade(s) ainda podem ser devolvidas`,
+        )
+      }
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const devolucao = inserirDevolucao(banco, {
+      pedidoId: pedido.id,
+      reembolso,
+      criadaEm: agora.toISOString(),
+      itens,
+      idempotencia,
+    })
+    somarAoReembolsado(banco, pedido.id, reembolso)
+
+    const todasDevolvidas = quantidadesDevolvidas(banco, pedido.id)
+    if (pedido.itens.every((item) => todasDevolvidas.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return { devolucao, repetida: false }
+  })
+}
+
+/** O corpo da devolução numa forma que não depende da ordem dos itens, para comparar repetições da mesma chave. */
+function corpoParaIdempotencia(pedidoId: number, nova: NovaDevolucao): string {
+  const itens = nova.itens
+    .map((item) => [item.produtoId, item.quantidade])
+    .sort(([a], [b]) => a! - b!)
+  return JSON.stringify({ pedidoId, itens })
+}
