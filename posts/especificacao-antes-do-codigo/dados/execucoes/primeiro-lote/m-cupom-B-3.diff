+import type { Banco } from '../banco.ts'
+import { porcentagem, type Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  /** A porcentagem, se o cupom for percentual; os centavos, se for fixo. */
+  valor: number
+  /** O último dia em que o cupom vale (AAAA-MM-DD, em UTC). */
+  validoAte: string
+  /** O subtotal mínimo do pedido para o cupom valer. */
+  minimo: Centavos
+}
+
+export type NovoCupom = Omit<Cupom, 'id'>
+
+type Linha = {
+  id: number
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  valido_ate: string
+  minimo: number
+}
+
+function paraCupom(linha: Linha): Cupom {
+  return {
+    id: linha.id,
+    codigo: linha.codigo,
+    tipo: linha.tipo,
+    valor: linha.valor,
+    validoAte: linha.valido_ate,
+    minimo: linha.minimo,
+  }
+}
+
+/** O código como fica guardado: sem espaços nas pontas e em maiúsculas (`dez` e `DEZ` são o mesmo cupom). */
+export function normalizarCodigo(codigo: string): string {
+  return codigo.trim().toUpperCase()
+}
+
+export function buscarCupom(banco: Banco, id: number): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE id = ?').get(id) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+export function buscarCupomPorCodigo(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE codigo = ?').get(normalizarCodigo(codigo)) as
+    | Linha
+    | undefined
+  return linha && paraCupom(linha)
+}
+
+export function inserirCupom(banco: Banco, novo: NovoCupom, criadoEm: string): Cupom {
+  const { lastInsertRowid } = banco
+    .prepare(
+      'INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)',
+    )
+    .run(normalizarCodigo(novo.codigo), novo.tipo, novo.valor, novo.validoAte, novo.minimo, criadoEm)
+  return buscarCupom(banco, Number(lastInsertRowid))!
+}
+
+/** Quanto o cupom tira de `base` (o valor dos itens sem promoção). Nunca passa da base. */
+export function descontoDe(cupom: Cupom, base: Centavos): Centavos {
+  const desconto = cupom.tipo === 'percentual' ? porcentagem(base, cupom.valor) : cupom.valor
+  return Math.min(desconto, base)
+}
+
+/** O cupom vale até o fim do dia `validoAte`, em UTC. */
+export function estaValido(cupom: Cupom, agora: Date): boolean {
+  return agora.toISOString().slice(0, 10) <= cupom.validoAte
+}
