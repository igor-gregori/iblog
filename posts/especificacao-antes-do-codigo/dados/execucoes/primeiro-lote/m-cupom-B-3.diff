@@ -0,0 +1,228 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarCupom, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function pedirComCupom(ctx: Contexto, cupom: string, produto: { preco?: number; precoPromocional?: number } = {}) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, ...produto })
+  return criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: caneca.id, quantidade: 1 }], cupom })
+}
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+test('cadastra um cupom, guardando o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: ' natal10 ', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 },
+  })
+  assert.equal(status, 201)
+  const { id, ...resto } = corpo
+  assert.equal(typeof id, 'number')
+  assert.deepEqual(resto, { codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 })
+})
+
+test('recusa código repetido, mesmo com outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ' })
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'dez', tipo: 'fixo', valor: 1000, validoAte: '2026-12-31', minimo: 0 },
+  })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'cupom_existente')
+})
+
+test('recusa cupom malformado com 400', async () => {
+  const ctx = montar()
+  const valido = { codigo: 'OK', tipo: 'fixo', valor: 1000, validoAte: '2026-12-31', minimo: 0 }
+  const casos: Record<string, unknown>[] = [
+    { tipo: 'brinde' },
+    { validoAte: '2026-02-30' },
+    { validoAte: '31/12/2026' },
+    { valor: 0 },
+    { valor: 9.5 },
+    { tipo: 'percentual', valor: 101 },
+    { minimo: -1 },
+    { codigo: 'com espaço' },
+  ]
+  for (const caso of casos) {
+    const { status } = await ctx.pedir({ method: 'POST', url: '/cupons', payload: { ...valido, ...caso } })
+    assert.equal(status, 400, JSON.stringify(caso))
+  }
+})
+
+test('aceita percentual de 100 e fixo acima de 100', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { tipo: 'percentual', valor: 100 })
+  await criarCupom(ctx, { tipo: 'fixo', valor: 5000 })
+})
+
+test('aplica cupom percentual e guarda subtotal, desconto e total', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  const { status, corpo } = await pedirComCupom(ctx, 'DEZ')
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3990)
+  assert.equal(corpo.desconto, 399)
+  assert.equal(corpo.total, 3591)
+  assert.equal(corpo.cupom, 'DEZ')
+
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${corpo.id}` })
+  assert.equal(depois.corpo.subtotal, 3990)
+  assert.equal(depois.corpo.desconto, 399)
+  assert.equal(depois.corpo.total, 3591)
+  assert.equal(depois.corpo.cupom, 'DEZ')
+})
+
+test('o desconto percentual arredonda para baixo', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'QUINZE', tipo: 'percentual', valor: 15 })
+  const { corpo } = await pedirComCupom(ctx, 'QUINZE')
+  assert.equal(corpo.desconto, 598)
+  assert.equal(corpo.total, 3990 - 598)
+})
+
+test('aplica cupom fixo, sem deixar o total negativo', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'CINCO', tipo: 'fixo', valor: 500 })
+  await criarCupom(ctx, { codigo: 'CEM', tipo: 'fixo', valor: 10000 })
+
+  const cinco = await pedirComCupom(ctx, 'CINCO')
+  assert.equal(cinco.corpo.desconto, 500)
+  assert.equal(cinco.corpo.total, 3490)
+
+  const cem = await pedirComCupom(ctx, 'CEM')
+  assert.equal(cem.corpo.desconto, 3990)
+  assert.equal(cem.corpo.total, 0)
+})
+
+test('aceita o código com outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ' })
+  const { status, corpo } = await pedirComCupom(ctx, 'dez')
+  assert.equal(status, 201)
+  assert.equal(corpo.cupom, 'DEZ')
+})
+
+test('itens em promoção não recebem o desconto do cupom', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  await criarCupom(ctx, { codigo: 'FIXO', tipo: 'fixo', valor: 5000 })
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 2000, precoPromocional: 1500 })
+  const itens = [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 2 },
+  ]
+
+  const dez = await criarPedido(ctx, { clienteId: cliente.id, itens, cupom: 'DEZ' })
+  assert.equal(dez.corpo.subtotal, 3990 + 3000)
+  assert.equal(dez.corpo.desconto, 399)
+  assert.equal(dez.corpo.total, 3990 + 3000 - 399)
+
+  // O fixo para no valor dos itens sem promoção.
+  const fixo = await criarPedido(ctx, { clienteId: cliente.id, itens, cupom: 'FIXO' })
+  assert.equal(fixo.corpo.desconto, 3990)
+  assert.equal(fixo.corpo.total, 3000)
+})
+
+test('se todos os itens estão em promoção, recusa o cupom sem baixar estoque', async () => {
