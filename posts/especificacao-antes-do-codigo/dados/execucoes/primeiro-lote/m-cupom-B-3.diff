+  assert.equal(denovo.status, 422)
+  assert.equal(denovo.corpo.erro.codigo, 'cupom_ja_usado')
+  assert.equal((await pedido(bia.id)).status, 201)
+})
+
+test('o cupom vale até o fim do dia de validoAte, em UTC', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'HOJE', validoAte: '2026-03-01' })
+
+  ctx.relogio.atual = new Date('2026-03-01T23:59:59Z')
+  assert.equal((await pedirComCupom(ctx, 'HOJE')).status, 201)
+
+  ctx.relogio.atual = new Date('2026-03-02T00:00:00Z')
+  const { status, corpo } = await pedirComCupom(ctx, 'HOJE')
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'cupom_expirado')
+})
+
