+    cupom: 'MINIMO',
+  })
+  assert.equal(exato.status, 201)
+  assert.equal(exato.corpo.subtotal, 5000)
+  assert.equal(exato.corpo.desconto, 300)
+})
+
+test('cada cliente usa o mesmo cupom uma vez só', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'DEZ' })
+  const ana = await criarCliente(ctx)
+  const bia = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx)
+  const pedido = (clienteId: number) =>
+    criarPedido(ctx, { clienteId, itens: [{ produtoId: caneca.id, quantidade: 1 }], cupom: 'DEZ' })
+
+  assert.equal((await pedido(ana.id)).status, 201)
