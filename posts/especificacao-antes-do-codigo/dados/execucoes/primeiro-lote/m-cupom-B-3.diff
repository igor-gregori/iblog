+  assert.equal(corpo.erro.codigo, 'cupom_sem_itens_elegiveis')
+  assert.equal(await estoqueDe(ctx, caneca.id), 5)
+})
+
+test('o mínimo vale sobre o subtotal de todos os itens, e o próprio mínimo basta', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'MINIMO', minimo: 5000 })
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3000, estoque: 5 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 3000, precoPromocional: 2000 })
+
+  const abaixo = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [{ produtoId: caneca.id, quantidade: 1 }],
+    cupom: 'MINIMO',
+  })
+  assert.equal(abaixo.status, 422)
+  assert.equal(abaixo.corpo.erro.codigo, 'cupom_abaixo_do_minimo')
+  assert.equal(await estoqueDe(ctx, caneca.id), 5)
+
+  const exato = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
