+/**
+ * Registra a devolução de itens de um pedido entregue. Cada produto pode voltar, somando todas as devoluções, até a
+ * quantidade comprada; o reembolso usa o preço da compra. O estoque volta.
+ */
+export function devolverItens(banco: Banco, pedido: Pedido, nova: NovaDevolucao, agora: Date): Devolucao {
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só pedido entregue aceita devolução; este está ${pedido.status}`)
+  }
+  recusarItemRepetido(nova.itens, 'na devolução')
+
+  const criadaEm = agora.toISOString()
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('produto_fora_do_pedido', `O produto ${item.produtoId} não está neste pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_excede_compra',
+          `Do produto ${item.produtoId} ainda podem voltar ${restante} unidade(s), não ${item.quantidade}`,
+        )
+      }
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const id = inserirDevolucao(banco, { pedidoId: pedido.id, reembolso, criadaEm, itens })
+    for (const item of itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, reembolso)
+    return buscarDevolucao(banco, id)!
+  })
+}
+
+function recusarItemRepetido(itens: { produtoId: number }[], onde: string): void {
+  const produtos = new Set(itens.map((item) => item.produtoId))
+  if (produtos.size !== itens.length) {
+    throw new ErroDeNegocio('item_repetido', `Cada produto aparece uma vez só ${onde}; use a quantidade`)
+  }
