+  await ctx.pedir({ method: 'POST', url: `/pedidos/${cancelado.id}/cancelar` })
+  assert.equal((await devolver(ctx, cancelado.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 409)
+})
