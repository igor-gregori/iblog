+export function inserirDevolucao(
+  banco: Banco,
+  devolucao: { pedidoId: number; reembolso: Centavos; criadaEm: string; itens: ItemDoPedido[] },
+): number {
+  const { lastInsertRowid } = banco
+    .prepare('INSERT INTO devolucoes (pedido_id, reembolso, criada_em) VALUES (?, ?, ?)')
+    .run(devolucao.pedidoId, devolucao.reembolso, devolucao.criadaEm)
+  const id = Number(lastInsertRowid)
+  const inserirItem = banco.prepare(
+    'INSERT INTO itens_devolucao (devolucao_id, produto_id, quantidade, preco_unitario) VALUES (?, ?, ?, ?)',
+  )
+  for (const item of devolucao.itens) {
+    inserirItem.run(id, item.produtoId, item.quantidade, item.precoUnitario)
+  }
+  return id
+}
+
+export function buscarDevolucao(banco: Banco, id: number): Devolucao | undefined {
+  const linha = banco.prepare('SELECT * FROM devolucoes WHERE id = ?').get(id) as LinhaDeDevolucao | undefined
+  if (!linha) return undefined
+  const itens = banco
+    .prepare('SELECT produto_id, quantidade, preco_unitario FROM itens_devolucao WHERE devolucao_id = ? ORDER BY id')
+    .all(id) as LinhaDeItem[]
+  return {
+    id: linha.id,
+    pedidoId: linha.pedido_id,
+    itens: itens.map(paraItem),
+    reembolso: linha.reembolso,
+    criadaEm: linha.criada_em,
+  }
+}
