@@ -0,0 +1,281 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+async function lerPedido(ctx: Contexto, pedidoId: number) {
+  return (await ctx.pedir({ method: 'GET', url: `/pedidos/${pedidoId}` })).corpo
+}
+
+function devolver(
+  ctx: Contexto,
+  pedidoId: number,
+  itens: { produtoId: number; quantidade: number }[],
+  chave?: string,
+) {
+  return ctx.pedir({
+    method: 'POST',
+    url: `/pedidos/${pedidoId}/devolucoes`,
+    payload: { itens },
+    headers: chave === undefined ? {} : { 'idempotency-key': chave },
+  })
+}
+
+/** Uma caneca (R$ 50,00, 3 compradas) e um pires (R$ 15,00, 1 comprado), num pedido já entregue. */
+async function pedidoEntregue(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 5000, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 1 },
+    ],
+  })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/entregar` })
+  return { pedido, caneca, pires }
+}
+
+test('devolve itens de um pedido entregue: 201, reembolso, estoque e o pedido mostra a devolução', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+
+  ctx.relogio.avancarDias(2)
+  const { status, corpo } = await devolver(ctx, pedido.id, [
+    { produtoId: pires.id, quantidade: 1 },
+    { produtoId: caneca.id, quantidade: 2 },
+  ])
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, {
+    id: corpo.id,
+    itens: [
+      { produtoId: pires.id, quantidade: 1 },
+      { produtoId: caneca.id, quantidade: 2 },
+    ],
+    reembolso: 1500 + 2 * 5000,
+    criadaEm: '2026-03-03T12:00:00.000Z',
+  })
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const depois = await lerPedido(ctx, pedido.id)
+  assert.equal(depois.status, 'entregue')
+  assert.equal(depois.reembolsado, 11500)
+  assert.deepEqual(depois.devolucoes, [corpo])
+})
+
+test('o reembolso usa o preço pago na compra, não o preço atual', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990, precoPromocional: 100 } })
+  const { corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(corpo.reembolso, 5000)
+})
+
+test('devolve estoque mesmo de produto desativado', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { ativo: false } })
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 3 }])).status, 201)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+})
+
+test('devoluções parciais se somam e, quando tudo voltou, o pedido passa a devolvido', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await pedidoEntregue(ctx)
+
+  const primeira = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(primeira.status, 201)
+  assert.equal((await lerPedido(ctx, pedido.id)).status, 'entregue')
+
