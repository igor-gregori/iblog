+import type { Banco } from '../banco.ts'
+import type { Centavos } from '../dinheiro.ts'
+
+export type TipoDeCupom = 'percentual' | 'fixo'
+
+export type Cupom = {
+  /** Sempre em maiúsculas. */
+  codigo: string
+  tipo: TipoDeCupom
+  /** A porcentagem, no `percentual`; os centavos, no `fixo`. */
+  valor: number
+  /** O último dia em que o cupom vale (AAAA-MM-DD, em UTC). */
+  validoAte: string
+  minimo: Centavos
+}
+
+type Linha = {
+  codigo: string
+  tipo: TipoDeCupom
+  valor: number
+  valido_ate: string
+  minimo: number
+}
+
+function paraCupom(linha: Linha): Cupom {
+  return {
+    codigo: linha.codigo,
+    tipo: linha.tipo,
+    valor: linha.valor,
+    validoAte: linha.valido_ate,
+    minimo: linha.minimo,
+  }
+}
+
+/** Busca pelo código, em qualquer caixa. */
+export function buscarCupom(banco: Banco, codigo: string): Cupom | undefined {
+  const linha = banco.prepare('SELECT * FROM cupons WHERE codigo = ?').get(codigo.toUpperCase()) as Linha | undefined
+  return linha && paraCupom(linha)
+}
+
+export function inserirCupom(banco: Banco, cupom: Cupom, criadoEm: string): Cupom {
+  const codigo = cupom.codigo.toUpperCase()
+  banco
+    .prepare('INSERT INTO cupons (codigo, tipo, valor, valido_ate, minimo, criado_em) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(codigo, cupom.tipo, cupom.valor, cupom.validoAte, cupom.minimo, criadoEm)
+  return buscarCupom(banco, codigo)!
+}
+
+/** O cupom vale até o fim do dia `validoAte` em UTC. */
+export function cupomVencido(cupom: Cupom, agora: Date): boolean {
+  return agora.toISOString().slice(0, 10) > cupom.validoAte
+}
