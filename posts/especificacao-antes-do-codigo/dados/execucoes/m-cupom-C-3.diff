@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { calcularDesconto } from '../src/cupons/desconto.ts'
+import { montar, type Contexto } from './ajuda.ts'
+
+const natal = { codigo: 'natal10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 0 }
+
+function cadastrar(ctx: Contexto, payload: Record<string, unknown>) {
+  return ctx.pedir({ method: 'POST', url: '/cupons', payload })
+}
+
+test('cadastra o cupom com o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await cadastrar(ctx, natal)
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, { codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 0 })
+})
+
+test('recusa código que já existe, em qualquer caixa', async () => {
+  const ctx = montar()
+  await cadastrar(ctx, natal)
+  const { status, corpo } = await cadastrar(ctx, { ...natal, codigo: 'NaTaL10', tipo: 'fixo', valor: 500 })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa corpo fora das regras com 400', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { ...natal, codigo: '' },
+    { ...natal, codigo: 'A'.repeat(31) },
+    { ...natal, codigo: 'NATAL-10' },
+    { ...natal, tipo: 'brinde' },
+    { ...natal, valor: 0 },
+    { ...natal, valor: 101 },
+    { ...natal, valor: 10.5 },
+    { ...natal, tipo: 'fixo', valor: 0 },
+    { ...natal, minimo: -1 },
+    { ...natal, validoAte: '2026-13-01' },
+    { ...natal, validoAte: '2026-02-30' },
+    { ...natal, validoAte: '25/12/2026' },
+    { codigo: 'SEMTIPO', valor: 10, validoAte: '2026-12-25', minimo: 0 },
+  ]
+  for (const payload of casos) {
+    const { status, corpo } = await cadastrar(ctx, payload)
+    assert.equal(status, 400, JSON.stringify(payload))
+    assert.equal(corpo.erro.codigo, 'dados_invalidos')
+  }
+})
+
+test('aceita porcentagem de 100 e fixo acima de 100 centavos', async () => {
+  const ctx = montar()
+  assert.equal((await cadastrar(ctx, { ...natal, codigo: 'TUDO', valor: 100 })).status, 201)
+  assert.equal((await cadastrar(ctx, { ...natal, codigo: 'FIXO', tipo: 'fixo', valor: 5000 })).status, 201)
+  assert.equal((await cadastrar(ctx, { ...natal, codigo: 'BISSEXTO', validoAte: '2028-02-29' })).status, 201)
+})
+
+test('calcularDesconto: percentual arredonda para baixo e ignora itens em promoção', () => {
+  const cupom = { tipo: 'percentual', valor: 15 } as const
+  assert.equal(calcularDesconto(cupom, [{ precoUnitario: 3333, quantidade: 1, emPromocao: false }]), 499)
+  assert.equal(
+    calcularDesconto({ tipo: 'percentual', valor: 10 }, [
+      { precoUnitario: 3000, quantidade: 2, emPromocao: false },
+      { precoUnitario: 4000, quantidade: 1, emPromocao: true },
+    ]),
+    600,
+  )
+})
+
+test('calcularDesconto: fixo fica limitado aos itens sem promoção', () => {
+  const cupom = { tipo: 'fixo', valor: 3000 } as const
+  assert.equal(
+    calcularDesconto(cupom, [
+      { precoUnitario: 1000, quantidade: 1, emPromocao: false },
+      { precoUnitario: 4000, quantidade: 1, emPromocao: true },
+    ]),
+    1000,
+  )
+  assert.equal(calcularDesconto(cupom, [{ precoUnitario: 5000, quantidade: 1, emPromocao: false }]), 3000)
+})
