+test('pagina a lista e informa o total', async () => {
+  const ctx = montar()
+  for (const nome of ['E', 'C', 'A', 'D', 'B']) await criarProduto(ctx, { nome })
+  const nomes = (corpo: { itens: { nome: string }[] }) => corpo.itens.map((p) => p.nome)
+
+  const primeira = await ctx.pedir({ method: 'GET', url: '/produtos?porPagina=2' })
+  assert.equal(primeira.status, 200)
+  assert.deepEqual(nomes(primeira.corpo), ['A', 'B'])
+  assert.equal(primeira.corpo.total, 5)
+
+  const terceira = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=3&porPagina=2' })
+  assert.deepEqual(nomes(terceira.corpo), ['E'])
+  assert.equal(terceira.corpo.total, 5)
+
+  const alemDoFim = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=4&porPagina=2' })
+  assert.deepEqual(alemDoFim.corpo, { itens: [], total: 5, pagina: 4, porPagina: 2 })
+})
+
+test('mostra 20 produtos por página se não pedirem outro número, e diz a página e o tamanho', async () => {
