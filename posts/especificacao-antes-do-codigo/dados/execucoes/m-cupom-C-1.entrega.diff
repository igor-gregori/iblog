+import { multiplicar, somar, type Centavos } from '../dinheiro.ts'
+import type { Cupom } from './repositorio.ts'
+
+export type ItemComPreco = {
+  precoUnitario: Centavos
+  quantidade: number
+  /** Item em promoção não recebe desconto do cupom. */
+  emPromocao: boolean
+}
+
+/** A soma dos itens sem promoção: é sobre ela que o cupom dá desconto. */
+function baseDoDesconto(itens: ItemComPreco[]): Centavos {
+  return somar(itens.filter((item) => !item.emPromocao).map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+}
+
+/**
+ * O desconto do cupom, em centavos. O percentual é arredondado para baixo; o fixo é limitado à base, então o desconto
+ * nunca passa dos itens sem promoção.
+ */
+export function calcularDesconto(cupom: Pick<Cupom, 'tipo' | 'valor'>, itens: ItemComPreco[]): Centavos {
+  const base = baseDoDesconto(itens)
+  if (cupom.tipo === 'percentual') return Math.floor((base * cupom.valor) / 100)
+  return Math.min(cupom.valor, base)
+}
