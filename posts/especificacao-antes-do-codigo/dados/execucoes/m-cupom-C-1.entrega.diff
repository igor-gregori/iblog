+test('a migração deixa os pedidos antigos com subtotal = total, sem desconto nem cupom', () => {
+  const banco = new DatabaseSync(':memory:')
+  banco.exec('PRAGMA foreign_keys = ON')
+  banco.exec('CREATE TABLE migracoes (nome TEXT PRIMARY KEY, aplicada_em TEXT NOT NULL)')
+  banco.exec(readFileSync(join(import.meta.dirname, '../src/migracoes/001_inicial.sql'), 'utf8'))
+  banco.exec("INSERT INTO migracoes VALUES ('001_inicial.sql', datetime('now'))")
+  banco.exec("INSERT INTO clientes (nome, email, criado_em) VALUES ('Ana', 'ana@exemplo.com', '2026-01-01')")
+  banco.exec("INSERT INTO pedidos (cliente_id, status, total, criado_em) VALUES (1, 'pago', 4321, '2026-01-01')")
+
+  migrar(banco)
+
+  assert.deepEqual(
+    { ...banco.prepare('SELECT subtotal, desconto, total, cupom FROM pedidos').get() },
+    { subtotal: 4321, desconto: 0, total: 4321, cupom: null },
+  )
+})
