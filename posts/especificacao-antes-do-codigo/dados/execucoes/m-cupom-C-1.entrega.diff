+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  const { status, corpo } = await ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'DEZ', tipo: 'percentual', valor: 10, validoAte: '2026-12-31', minimo: 0, ...dados },
+  })
+  if (status !== 201) throw new Error(`não criou o cupom: ${JSON.stringify(corpo)}`)
+  return corpo
+}
+
+test('pedido sem cupom tem subtotal igual ao total, sem desconto', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990 })
+  const { corpo } = await criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: caneca.id, quantidade: 1 }] })
+  assert.equal(corpo.subtotal, 3990)
+  assert.equal(corpo.desconto, 0)
+  assert.equal(corpo.total, 3990)
+  assert.equal(corpo.cupom, null)
+})
+
+test('cupom de 10% num pedido de R$ 100,00 sem promoção', async () => {
+  const ctx = montar()
+  const cliente = await criarCliente(ctx)
+  const produto = await criarProduto(ctx, { preco: 5000 })
+  await criarCupom(ctx, { codigo: 'DEZ' })
+
+  const { status, corpo } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    cupom: 'dez',
+    itens: [{ produtoId: produto.id, quantidade: 2 }],
+  })
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 10000)
+  assert.equal(corpo.desconto, 1000)
+  assert.equal(corpo.total, 9000)
+  assert.equal(corpo.cupom, 'DEZ')
+
+  const lido = await ctx.pedir({ method: 'GET', url: `/pedidos/${corpo.id}` })
+  assert.deepEqual(
+    [lido.corpo.subtotal, lido.corpo.desconto, lido.corpo.total, lido.corpo.cupom],
+    [10000, 1000, 9000, 'DEZ'],
+  )
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${cliente.id}` })
+  assert.equal(lista.corpo.itens[0].desconto, 1000)
+})
