@@ -0,0 +1,109 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { test } from 'node:test'
+import { migrar } from '../src/banco.ts'
+import { calcularDesconto } from '../src/cupons/desconto.ts'
+import { montar, type Contexto } from './ajuda.ts'
+
+const cupomValido = { codigo: 'natal10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 5000 }
+
+function cadastrar(ctx: Contexto, dados: Record<string, unknown>) {
+  return ctx.pedir({ method: 'POST', url: '/cupons', payload: { ...cupomValido, ...dados } })
+}
+
+test('cadastra o cupom, com o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await cadastrar(ctx, {})
+  assert.equal(status, 201)
+  assert.deepEqual(corpo, { ...cupomValido, codigo: 'NATAL10' })
+})
+
+test('cadastra cupom fixo e aceita os limites da tabela', async () => {
+  const ctx = montar()
+  assert.equal((await cadastrar(ctx, { codigo: 'A', tipo: 'fixo', valor: 1, minimo: 0 })).status, 201)
+  assert.equal((await cadastrar(ctx, { codigo: 'CEM', valor: 100 })).status, 201)
+  assert.equal((await cadastrar(ctx, { codigo: 'X'.repeat(30), validoAte: '2028-02-29' })).status, 201)
+})
+
+test('código repetido, em qualquer caixa, é 409', async () => {
+  const ctx = montar()
+  await cadastrar(ctx, { codigo: 'NATAL10' })
+  const { status, corpo } = await cadastrar(ctx, { codigo: 'Natal10', tipo: 'fixo', valor: 500 })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa com 400 o corpo fora das regras', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { codigo: '' },
+    { codigo: 'X'.repeat(31) },
+    { codigo: 'natal-10' },
+    { tipo: 'brinde' },
+    { valor: 0 },
+    { valor: 101 },
+    { valor: 12.5 },
+    { tipo: 'fixo', valor: 0 },
+    { minimo: -1 },
+    { validoAte: '25/12/2026' },
+    { validoAte: '2026-13-01' },
+    { validoAte: '2026-02-29' },
+    { validoAte: '2026-04-31' },
+    { validoAte: '2026-12-25T00:00:00Z' },
+  ]
+  for (const caso of casos) {
+    const { status, corpo } = await cadastrar(ctx, caso)
+    assert.equal(status, 400, JSON.stringify(caso))
+    assert.equal(corpo.erro.codigo, 'dados_invalidos')
+  }
+  const { status } = await ctx.pedir({ method: 'POST', url: '/cupons', payload: { codigo: 'SEMTIPO' } })
+  assert.equal(status, 400)
+})
+
+test('cupom fixo aceita valor acima de 100 centavos', async () => {
+  const ctx = montar()
+  const { status, corpo } = await cadastrar(ctx, { tipo: 'fixo', valor: 3000 })
+  assert.equal(status, 201)
+  assert.equal(corpo.valor, 3000)
+})
+
+test('calcularDesconto: percentual arredonda para baixo e ignora itens em promoção', () => {
+  const cupom = { tipo: 'percentual', valor: 15 } as const
+  assert.equal(calcularDesconto(cupom, [{ precoUnitario: 3333, quantidade: 1, emPromocao: false }]), 499)
+  assert.equal(
+    calcularDesconto(cupom, [
+      { precoUnitario: 1000, quantidade: 2, emPromocao: false },
+      { precoUnitario: 5000, quantidade: 1, emPromocao: true },
+    ]),
+    300,
+  )
+})
+
+test('calcularDesconto: fixo é limitado aos itens sem promoção', () => {
+  const itens = [
+    { precoUnitario: 1000, quantidade: 1, emPromocao: false },
+    { precoUnitario: 4000, quantidade: 1, emPromocao: true },
+  ]
+  assert.equal(calcularDesconto({ tipo: 'fixo', valor: 3000 }, itens), 1000)
+  assert.equal(calcularDesconto({ tipo: 'fixo', valor: 700 }, itens), 700)
+  assert.equal(calcularDesconto({ tipo: 'fixo', valor: 700 }, [{ ...itens[1]! }]), 0)
+})
