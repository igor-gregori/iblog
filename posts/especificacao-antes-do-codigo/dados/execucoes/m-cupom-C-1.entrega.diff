+function inserirSemRepetirCupom(banco: Banco, pedido: Parameters<typeof inserirPedido>[1]): number {
+  try {
+    return inserirPedido(banco, pedido)
+  } catch (erro) {
+    if (pedido.cupom && (erro as { errcode?: number }).errcode === SQLITE_CONSTRAINT_UNIQUE) {
+      throw new ErroDeNegocio('cupom_ja_usado', `O cupom ${pedido.cupom} já foi usado por este cliente`)
+    }
+    throw erro
+  }
+}
