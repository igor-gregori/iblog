+const nomes = (corpo: { itens: { nome: string }[] }) => corpo.itens.map((p) => p.nome)
+
+test('pagina a lista e conta o total', async () => {
+  const ctx = montar()
+  for (const nome of ['E', 'D', 'C', 'B', 'A']) await criarProduto(ctx, { nome })
+
+  const primeira = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=1&porPagina=2' })
+  assert.equal(primeira.status, 200)
+  assert.deepEqual(nomes(primeira.corpo), ['A', 'B'])
+  assert.equal(primeira.corpo.total, 5)
+
+  const ultima = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=3&porPagina=2' })
+  assert.deepEqual(nomes(ultima.corpo), ['E'])
+
+  const depoisDoFim = await ctx.pedir({ method: 'GET', url: '/produtos?pagina=4&porPagina=2' })
+  assert.deepEqual(depoisDoFim.corpo, { itens: [], total: 5 })
+})
+
+test('sem parâmetros, devolve a primeira página de 20', async () => {
+  const ctx = montar()
+  for (let i = 0; i < 25; i++) await criarProduto(ctx, { nome: `P${String(i).padStart(2, '0')}` })
+  const { corpo } = await ctx.pedir({ method: 'GET', url: '/produtos' })
+  assert.equal(corpo.itens.length, 20)
+  assert.equal(corpo.total, 25)
+})
+
+test('busca pelo trecho do nome, sem ligar para maiúsculas', async () => {
+  const ctx = montar()
+  await criarProduto(ctx, { nome: 'Caneca azul' })
+  await criarProduto(ctx, { nome: 'Pires' })
+  await criarProduto(ctx, { nome: 'Caneca 100% algodão' })
+  await criarProduto(ctx, { nome: 'Xícara de canela' })
+
+  const { corpo } = await ctx.pedir({ method: 'GET', url: '/produtos?busca=CANE' })
+  assert.deepEqual(nomes(corpo), ['Caneca 100% algodão', 'Caneca azul', 'Xícara de canela'])
+  assert.equal(corpo.total, 3)
+
+  const curinga = await ctx.pedir({ method: 'GET', url: `/produtos?busca=${encodeURIComponent('0%')}` })
+  assert.deepEqual(nomes(curinga.corpo), ['Caneca 100% algodão'])
+})
+
+test('filtra pela faixa do preço de venda, com os extremos inclusos', async () => {
