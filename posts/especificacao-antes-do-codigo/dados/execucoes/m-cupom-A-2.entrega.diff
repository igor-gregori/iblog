+/** As datas de validade dos cupons são dias no horário da loja. */
+const FUSO_DA_LOJA = 'America/Sao_Paulo'
+
+/** O dia de `agora` no horário da loja, `AAAA-MM-DD`. */
+function diaNaLoja(agora: Date): string {
+  return new Intl.DateTimeFormat('en-CA', { timeZone: FUSO_DA_LOJA }).format(agora)
+}
+
+function cupomValido(banco: Banco, codigo: string, agora: Date): Cupom {
+  const cupom = buscarCupomPorCodigo(banco, codigo)
+  if (!cupom) {
+    throw new ErroDeNegocio('cupom_inexistente', 'Cupom não encontrado')
+  }
+  if (diaNaLoja(agora) > cupom.validoAte) {
+    throw new ErroDeNegocio('cupom_expirado', `O cupom ${cupom.codigo} valia até ${cupom.validoAte}`)
+  }
+  return cupom
+}
+
+/** O desconto do cupom num pedido de `subtotal`. Nunca passa do subtotal: o total não fica negativo. */
+function calcularDesconto(cupom: Cupom, subtotal: Centavos): Centavos {
+  if (subtotal < cupom.minimo) {
+    throw new ErroDeNegocio(
+      'pedido_abaixo_do_minimo',
+      `O cupom ${cupom.codigo} vale para pedidos a partir de ${formatar(cupom.minimo)}`,
+    )
+  }
+  const desconto = cupom.tipo === 'percentual' ? porcentagem(subtotal, cupom.valor) : cupom.valor
+  return Math.min(desconto, subtotal)
+}
