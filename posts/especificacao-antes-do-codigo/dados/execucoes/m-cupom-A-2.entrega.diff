+CREATE TABLE cupons (
+  id INTEGER PRIMARY KEY,
+  codigo TEXT NOT NULL UNIQUE,
+  tipo TEXT NOT NULL CHECK (tipo IN ('percentual', 'fixo')),
+  valor INTEGER NOT NULL,
+  valido_ate TEXT NOT NULL,
+  minimo INTEGER NOT NULL,
+  criado_em TEXT NOT NULL
+);
+
+-- O total passa a ser o que o cliente paga: subtotal - desconto. Os pedidos que já existem não tiveram desconto.
+ALTER TABLE pedidos ADD COLUMN subtotal INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE pedidos ADD COLUMN desconto INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE pedidos ADD COLUMN cupom_id INTEGER REFERENCES cupons (id);
+UPDATE pedidos SET subtotal = total;
