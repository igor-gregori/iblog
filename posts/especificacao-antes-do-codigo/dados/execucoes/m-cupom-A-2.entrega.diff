+/** `porcento`% de `valor`, arredondado para baixo: 10% de R$ 0,99 é R$ 0,09. */
+export function porcentagem(valor: Centavos, porcento: number): Centavos {
+  return Math.floor((valor * porcento) / 100)
+}
+
