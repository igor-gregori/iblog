@@ -0,0 +1,160 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function criarCupom(ctx: Contexto, dados: Record<string, unknown> = {}) {
+  return ctx.pedir({
+    method: 'POST',
+    url: '/cupons',
+    payload: { codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 0, ...dados },
+  })
+}
+
+/** Um cliente e uma caneca de R$ 39,90, prontos para um pedido. */
+async function preparar(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pedir = (quantidade: number, cupom?: string) =>
+    criarPedido(ctx, { clienteId: cliente.id, itens: [{ produtoId: caneca.id, quantidade }], cupom })
+  return { cliente, caneca, pedir }
+}
+
+test('cadastra um cupom, com o código em maiúsculas', async () => {
+  const ctx = montar()
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'natal10' })
+  assert.equal(status, 201)
+  assert.deepEqual(
+    { ...corpo, id: 0 },
+    { id: 0, codigo: 'NATAL10', tipo: 'percentual', valor: 10, validoAte: '2026-12-25', minimo: 0 },
+  )
+})
+
+test('recusa código repetido, mesmo com outra caixa', async () => {
+  const ctx = montar()
+  await criarCupom(ctx, { codigo: 'NATAL10' })
+  const { status, corpo } = await criarCupom(ctx, { codigo: 'natal10' })
+  assert.equal(status, 409)
+  assert.equal(corpo.erro.codigo, 'codigo_em_uso')
+})
+
+test('recusa cupom malformado', async () => {
+  const ctx = montar()
+  const casos: Record<string, unknown>[] = [
+    { tipo: 'brinde' },
+    { valor: 0 },
+    { valor: 9.9 },
+    { minimo: -1 },
+    { validoAte: '25/12/2026' },
+    { validoAte: '2026-02-30' },
+    { codigo: 'com espaço' },
+    { codigo: '' },
+  ]
+  for (const dados of casos) {
+    const { status } = await criarCupom(ctx, dados)
+    assert.equal(status, 400, JSON.stringify(dados))
+  }
+})
+
+test('recusa desconto percentual acima de 100', async () => {
+  const ctx = montar()
+  const { status, corpo } = await criarCupom(ctx, { valor: 101 })
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'desconto_invalido')
+  assert.equal((await criarCupom(ctx, { valor: 101, tipo: 'fixo' })).status, 201)
+})
+
+test('pedido sem cupom: subtotal igual ao total, sem desconto', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  const { corpo } = await pedir(2)
+  assert.equal(corpo.subtotal, 7980)
+  assert.equal(corpo.desconto, 0)
+  assert.equal(corpo.total, 7980)
+  assert.equal(corpo.cupom, null)
+})
+
+test('cupom percentual desconta a porcentagem do subtotal, arredondando o desconto para baixo', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'DEZ', tipo: 'percentual', valor: 10 })
+  const { status, corpo } = await pedir(1, 'dez')
+  assert.equal(status, 201)
+  assert.equal(corpo.subtotal, 3990)
+  assert.equal(corpo.desconto, 399)
+  assert.equal(corpo.total, 3591)
+  assert.equal(corpo.cupom, 'DEZ')
+
+  await criarCupom(ctx, { codigo: 'SETE', tipo: 'percentual', valor: 7 })
+  const sete = await pedir(1, 'SETE')
+  assert.equal(sete.corpo.desconto, 279) // 7% de 3990 = 279,3
+  assert.equal(sete.corpo.total, 3711)
+})
+
+test('cupom fixo desconta o valor, sem deixar o total negativo', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'CINCO', tipo: 'fixo', valor: 500 })
+  const { corpo } = await pedir(1, 'CINCO')
+  assert.deepEqual([corpo.subtotal, corpo.desconto, corpo.total], [3990, 500, 3490])
+
+  await criarCupom(ctx, { codigo: 'CEM', tipo: 'fixo', valor: 10000 })
+  const grande = await pedir(1, 'CEM')
+  assert.deepEqual([grande.corpo.subtotal, grande.corpo.desconto, grande.corpo.total], [3990, 3990, 0])
+})
+
+test('o desconto fica guardado no pedido', async () => {
+  const ctx = montar()
+  const { cliente, pedir } = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'CINCO', tipo: 'fixo', valor: 500 })
+  const { corpo: criado } = await pedir(1, 'CINCO')
+
+  const buscado = await ctx.pedir({ method: 'GET', url: `/pedidos/${criado.id}` })
+  assert.deepEqual(buscado.corpo, criado)
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos?clienteId=${cliente.id}` })
+  assert.deepEqual(lista.corpo.itens, [criado])
+})
+
+test('o mínimo vale sobre o subtotal, e ele mesmo já basta', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'MINIMO', minimo: 7980 })
+
+  const abaixo = await pedir(1, 'MINIMO')
+  assert.equal(abaixo.status, 422)
+  assert.equal(abaixo.corpo.erro.codigo, 'pedido_abaixo_do_minimo')
+  assert.match(abaixo.corpo.erro.mensagem, /R\$ 79,80/)
+
+  const exato = await pedir(2, 'MINIMO')
+  assert.equal(exato.status, 201)
+  assert.equal(exato.corpo.desconto, 798)
+})
+
+test('vale até o fim do dia de validade, no horário de Brasília', async () => {
+  const ctx = montar()
+  const { pedir } = await preparar(ctx)
+  await criarCupom(ctx, { codigo: 'MARCO', validoAte: '2026-03-01' })
+
+  // 1º de março, 23h em Brasília (2 de março, 2h em UTC): ainda vale.
+  ctx.relogio.atual = new Date('2026-03-02T02:00:00Z')
+  assert.equal((await pedir(1, 'MARCO')).status, 201)
+
+  // 2 de março, 0h em Brasília: venceu.
+  ctx.relogio.atual = new Date('2026-03-02T03:00:00Z')
+  const vencido = await pedir(1, 'MARCO')
+  assert.equal(vencido.status, 422)
+  assert.equal(vencido.corpo.erro.codigo, 'cupom_expirado')
+})
+
+test('cupom inexistente ou abaixo do mínimo recusa o pedido sem baixar estoque', async () => {
