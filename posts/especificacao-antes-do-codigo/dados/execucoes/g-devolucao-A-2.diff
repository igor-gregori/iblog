+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  const requisicao = {
+    method: 'POST' as const,
+    url: `/pedidos/${pedido.id}/devolucoes`,
+    headers: { 'idempotency-key': 'abc-123' },
+    payload: { itens: [{ produtoId: caneca.id, quantidade: 1 }] },
+  }
+  const primeira = await ctx.pedir(requisicao)
+  assert.equal(primeira.status, 201)
+  const segunda = await ctx.pedir(requisicao)
+  assert.equal(segunda.status, 200)
+  assert.deepEqual(segunda.corpo, primeira.corpo)
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+  const depois = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}` })
+  assert.equal(depois.corpo.devolucoes.length, 1)
+  assert.equal(depois.corpo.reembolsado, 2990)
+})
+
+test('a mesma Idempotency-Key com outro corpo é recusada com 409', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await pedidoEntregue(ctx)
+  const comChave = (quantidade: number) =>
+    ctx.pedir({
+      method: 'POST',
+      url: `/pedidos/${pedido.id}/devolucoes`,
+      headers: { 'idempotency-key': 'abc-123' },
+      payload: { itens: [{ produtoId: caneca.id, quantidade }] },
+    })
+  assert.equal((await comChave(1)).status, 201)
+  const outra = await comChave(2)
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'chave_de_idempotencia_reusada')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+})
