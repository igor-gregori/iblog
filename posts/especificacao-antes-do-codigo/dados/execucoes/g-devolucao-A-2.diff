+/** Cancela um pedido que ainda não foi enviado: o estoque volta e o total inteiro é reembolsado. */
+export function cancelarPedido(banco: Banco, pedidoId: number, agora: Date): Pedido {
+  return emTransacao(banco, () => {
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+    mudarStatus(banco, pedido, 'cancelado', agora)
+    for (const item of pedido.itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+    }
+    return buscarPedido(banco, pedidoId)!
+  })
+}
+
+export const PRAZO_DE_DEVOLUCAO_EM_DIAS = 7
+
+const UM_DIA = 24 * 60 * 60 * 1000
+
+/**
+ * Registra a devolução de itens de um pedido entregue, até `PRAZO_DE_DEVOLUCAO_EM_DIAS` depois da entrega: o estoque
+ * volta e cada unidade é reembolsada pelo preço que o cliente pagou. Um pedido pode ter várias devoluções, mas não se
+ * devolve mais do que foi comprado; quando tudo volta, o pedido fica devolvido.
+ *
+ * Com uma `chaveDeIdempotencia` já usada, não faz nada de novo: devolve a devolução daquela vez (`repetida`), se a
+ * requisição for a mesma, ou recusa, se for outra.
+ */
+export function devolverItens(
+  banco: Banco,
+  pedidoId: number,
+  nova: NovaDevolucao,
+  agora: Date,
+  chaveDeIdempotencia: string | null = null,
+): { devolucao: Devolucao; repetida: boolean } {
+  const produtos = new Set(nova.itens.map((item) => item.produtoId))
+  if (produtos.size !== nova.itens.length) {
+    throw new ErroDeNegocio('item_repetido', 'Cada produto aparece uma vez só na devolução; use a quantidade')
+  }
+  const requisicao = JSON.stringify({
+    pedidoId,
+    itens: nova.itens
+      .map((item) => ({ produtoId: item.produtoId, quantidade: item.quantidade }))
+      .sort((a, b) => a.produtoId - b.produtoId),
+  })
+
+  return emTransacao(banco, () => {
+    if (chaveDeIdempotencia !== null) {
+      const anterior = buscarDevolucaoPelaChave(banco, chaveDeIdempotencia)
+      if (anterior) {
+        if (anterior.requisicao !== requisicao) {
+          throw new Conflito(
+            'chave_de_idempotencia_reusada',
+            'Esta Idempotency-Key já foi usada numa devolução diferente',
+          )
+        }
+        return { devolucao: anterior.devolucao, repetida: true }
+      }
+    }
+
+    const pedido = buscarPedido(banco, pedidoId)
+    if (!pedido) throw new NaoEncontrado('Pedido')
+    if (pedido.status !== 'entregue') {
+      throw new Conflito('pedido_nao_entregue', `Só se devolve item de pedido entregue; este está ${pedido.status}`)
+    }
+    const prazo = new Date(pedido.entregueEm!).getTime() + PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA
+    if (agora.getTime() > prazo) {
+      throw new ErroDeNegocio(
+        'prazo_de_devolucao_encerrado',
+        `A devolução só vale até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+      )
+    }
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = nova.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'quantidade_acima_da_comprada',
+          `Do produto ${item.produtoId}, ainda dá para devolver ${restante} unidade(s)`,
+        )
+      }
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const id = inserirDevolucao(banco, {
+      pedidoId: pedido.id,
+      itens,
+      reembolso,
+      criadaEm: agora.toISOString(),
+      chaveDeIdempotencia,
+      requisicao,
+    })
+
+    const devolvidasAgora = quantidadesDevolvidas(banco, pedido.id)
+    if (pedido.itens.every((item) => devolvidasAgora.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return { devolucao: buscarDevolucao(banco, id)!, repetida: false }
+  })
+}
