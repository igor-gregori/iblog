+
+/** Quantos dias depois da entrega o cliente ainda pode devolver. */
+export const PRAZO_DE_DEVOLUCAO_EM_DIAS = 7
+
+const UM_DIA = 24 * 60 * 60 * 1000
+
+/**
+ * Registra a devolução de itens de um pedido entregue, até `PRAZO_DE_DEVOLUCAO_EM_DIAS` depois da entrega: devolve ao
+ * estoque e reembolsa pelo preço da compra. Um pedido pode ter várias devoluções, mas nunca mais de um produto do que
+ * foi comprado; quando tudo volta, o pedido passa a devolvido.
+ *
+ * Com uma `chaveIdempotencia` já usada, não faz nada de novo: devolve a devolução que ela criou (`repetida: true`), ou
+ * recusa se o pedido ou o corpo forem outros.
+ */
+export function registrarDevolucao(
+  banco: Banco,
+  pedido: Pedido,
+  pedida: NovaDevolucao,
+  agora: Date,
+  chaveIdempotencia: string | null = null,
+): { devolucao: Devolucao; repetida: boolean } {
+  const corpo = JSON.stringify({ pedidoId: pedido.id, itens: pedida.itens })
+  return emTransacao(banco, () => {
+    if (chaveIdempotencia !== null) {
+      const anterior = buscarDevolucaoPorChave(banco, chaveIdempotencia)
+      if (anterior) {
+        if (anterior.corpo !== corpo) {
+          throw new Conflito(
+            'chave_de_idempotencia_reutilizada',
+            'Esta Idempotency-Key já foi usada numa devolução diferente',
+          )
+        }
+        return { devolucao: anterior.devolucao, repetida: true }
+      }
+    }
+    return { devolucao: novaDevolucao(banco, pedido, pedida, agora, chaveIdempotencia, corpo), repetida: false }
+  })
+}
+
+function novaDevolucao(
+  banco: Banco,
+  pedido: Pedido,
+  pedida: NovaDevolucao,
+  agora: Date,
+  chaveIdempotencia: string | null,
+  corpo: string,
+): Devolucao {
+  if (pedido.status !== 'entregue') {
+    throw new Conflito('pedido_nao_entregue', `Só um pedido entregue aceita devolução; este está ${pedido.status}`)
+  }
+  const limite = new Date(pedido.entregueEm!).getTime() + PRAZO_DE_DEVOLUCAO_EM_DIAS * UM_DIA
+  if (agora.getTime() > limite) {
+    throw new ErroDeNegocio(
+      'prazo_de_devolucao_encerrado',
+      `A devolução é aceita até ${PRAZO_DE_DEVOLUCAO_EM_DIAS} dias depois da entrega`,
+    )
+  }
+  recusarItemRepetido(pedida.itens, 'na devolução')
+
+  const criadaEm = agora.toISOString()
+  return emTransacao(banco, () => {
+    const devolvidas = quantidadesDevolvidas(banco, pedido.id)
+    const itens: ItemDoPedido[] = pedida.itens.map((item) => {
+      const comprado = pedido.itens.find((doPedido) => doPedido.produtoId === item.produtoId)
+      if (!comprado) {
+        throw new ErroDeNegocio('item_fora_do_pedido', `O produto ${item.produtoId} não está no pedido`)
+      }
+      const restante = comprado.quantidade - (devolvidas.get(item.produtoId) ?? 0)
+      if (item.quantidade > restante) {
+        throw new ErroDeNegocio(
+          'devolucao_acima_do_comprado',
+          `Do produto ${item.produtoId} ainda podem ser devolvidas ${restante} unidades`,
+        )
+      }
+      return { produtoId: item.produtoId, quantidade: item.quantidade, precoUnitario: comprado.precoUnitario }
+    })
+    const reembolso = somar(itens.map((item) => multiplicar(item.precoUnitario, item.quantidade)))
+    const id = inserirDevolucao(banco, { pedidoId: pedido.id, itens, reembolso, criadaEm, chaveIdempotencia, corpo })
+    for (const item of itens) {
+      reporEstoque(banco, item.produtoId, item.quantidade)
+      devolvidas.set(item.produtoId, (devolvidas.get(item.produtoId) ?? 0) + item.quantidade)
+    }
+    somarReembolso(banco, pedido.id, reembolso)
+    if (pedido.itens.every((item) => devolvidas.get(item.produtoId) === item.quantidade)) {
+      mudarStatus(banco, pedido, 'devolvido', agora)
+    }
+    return buscarDevolucao(banco, id)!
+  })
+}
+
+function recusarItemRepetido(itens: { produtoId: number }[], onde: string): void {
+  const produtos = new Set(itens.map((item) => item.produtoId))
+  if (produtos.size !== itens.length) {
+    throw new ErroDeNegocio('item_repetido', `Cada produto aparece uma vez só ${onde}; use a quantidade`)
+  }
+}
