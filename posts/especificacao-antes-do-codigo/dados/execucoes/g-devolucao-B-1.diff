+import { criarCliente, criarPedido, criarProduto, montar, type Contexto } from './ajuda.ts'
+
+async function estoqueDe(ctx: Contexto, produtoId: number): Promise<number> {
+  return (await ctx.pedir({ method: 'GET', url: `/produtos/${produtoId}` })).corpo.estoque
+}
+
+async function buscar(ctx: Contexto, pedidoId: number) {
+  return (await ctx.pedir({ method: 'GET', url: `/pedidos/${pedidoId}` })).corpo
+}
+
+/** Um pedido de 3 canecas (R$ 39,90) e 2 pires (R$ 15,00), com 10 de estoque de cada antes da compra. */
+async function comprar(ctx: Contexto) {
+  const cliente = await criarCliente(ctx)
+  const caneca = await criarProduto(ctx, { preco: 3990, estoque: 10 })
+  const pires = await criarProduto(ctx, { nome: 'Pires', preco: 1500, estoque: 10 })
+  const { corpo: pedido } = await criarPedido(ctx, {
+    clienteId: cliente.id,
+    itens: [
+      { produtoId: caneca.id, quantidade: 3 },
+      { produtoId: pires.id, quantidade: 2 },
+    ],
+  })
+  return { pedido, caneca, pires }
+}
+
+async function entregar(ctx: Contexto, pedidoId: number): Promise<void> {
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/enviar` })
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedidoId}/entregar` })
+}
+
+function devolver(ctx: Contexto, pedidoId: number, itens: unknown, chave?: string) {
+  return ctx.pedir({
+    method: 'POST',
+    url: `/pedidos/${pedidoId}/devolucoes`,
+    payload: { itens },
+    headers: chave ? { 'idempotency-key': chave } : {},
+  })
+}
+
+test('um pedido novo não tem nada reembolsado nem devolvido', async () => {
+  const ctx = montar()
+  const { pedido } = await comprar(ctx)
+  assert.equal(pedido.reembolsado, 0)
+  assert.equal(pedido.canceladoEm, null)
+  assert.equal(pedido.devolvidoEm, null)
+  assert.deepEqual(pedido.devolucoes, [])
+})
+
+test('o pedido lista as devoluções', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  const primeira = (await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).corpo
+  const segunda = (
+    await devolver(ctx, pedido.id, [
+      { produtoId: caneca.id, quantidade: 1 },
+      { produtoId: pires.id, quantidade: 1 },
+    ])
+  ).corpo
+
+  assert.deepEqual((await buscar(ctx, pedido.id)).devolucoes, [primeira, segunda])
+  assert.deepEqual(segunda.itens, [
+    { produtoId: caneca.id, quantidade: 1 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  const lista = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/devolucoes` })
+  assert.deepEqual(lista.corpo, { itens: [primeira, segunda] })
+})
+
+test('devolve até 7 dias depois da entrega, e recusa depois disso', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+
+  ctx.relogio.avancarDias(7)
+  assert.equal((await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])).status, 201)
+
+  ctx.relogio.atual = new Date(ctx.relogio.atual.getTime() + 1)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(status, 422)
+  assert.equal(corpo.erro.codigo, 'prazo_de_devolucao_encerrado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 8)
+})
+
+test('com tudo devolvido, o pedido passa para devolvido, com evento no histórico', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 3 }])
+  assert.equal((await buscar(ctx, pedido.id)).status, 'entregue')
+
+  ctx.relogio.avancarDias(2)
+  await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 2 }])
+  const depois = await buscar(ctx, pedido.id)
+  assert.equal(depois.status, 'devolvido')
+  assert.equal(depois.devolvidoEm, '2026-03-03T12:00:00.000Z')
+  assert.equal(depois.reembolsado, pedido.total)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), {
+    de: 'entregue',
+    para: 'devolvido',
+    em: '2026-03-03T12:00:00.000Z',
+  })
+  const outra = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }])
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'pedido_nao_entregue')
+})
+
+test('a mesma Idempotency-Key devolve a mesma devolução, sem repetir nada', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  const itens = [{ produtoId: caneca.id, quantidade: 3 }]
+
+  const primeira = await devolver(ctx, pedido.id, itens, 'chave-1')
+  assert.equal(primeira.status, 201)
+  // A repetição chega depois de o pedido já ter passado a devolvido, e mesmo assim devolve a mesma resposta.
+  const repetida = await devolver(ctx, pedido.id, itens, 'chave-1')
+  assert.equal(repetida.status, 200)
+  assert.deepEqual(repetida.corpo, primeira.corpo)
+
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  const depois = await buscar(ctx, pedido.id)
+  assert.equal(depois.reembolsado, 3 * 3990)
+  assert.equal(depois.devolucoes.length, 1)
+})
+
+test('a mesma Idempotency-Key com outro corpo é recusada com 409', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }], 'chave-1')
+
+  const outra = await devolver(ctx, pedido.id, [{ produtoId: pires.id, quantidade: 1 }], 'chave-1')
+  assert.equal(outra.status, 409)
+  assert.equal(outra.corpo.erro.codigo, 'chave_de_idempotencia_reutilizada')
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+
+  const { pedido: outroPedido } = await comprar(ctx)
+  await entregar(ctx, outroPedido.id)
+  const outroItem = { produtoId: outroPedido.itens[0].produtoId, quantidade: 1 }
+  const emOutroPedido = await devolver(ctx, outroPedido.id, [outroItem], 'chave-1')
+  assert.equal(emOutroPedido.status, 409)
+})
+
+test('cancela um pedido pago: o estoque volta e o total é reembolsado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+
+  ctx.relogio.avancarDias(1)
+  const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(status, 200)
+  assert.equal(corpo.status, 'cancelado')
+  assert.equal(corpo.canceladoEm, '2026-03-02T12:00:00.000Z')
+  assert.equal(corpo.reembolsado, pedido.total)
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal(await estoqueDe(ctx, pires.id), 10)
+
+  const historico = await ctx.pedir({ method: 'GET', url: `/pedidos/${pedido.id}/historico` })
+  assert.deepEqual(historico.corpo.itens.at(-1), { de: 'pago', para: 'cancelado', em: '2026-03-02T12:00:00.000Z' })
+})
+
+test('não cancela duas vezes, nem um pedido enviado ou entregue', async () => {
+  const ctx = montar()
+  const { pedido, caneca } = await comprar(ctx)
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  const denovo = await ctx.pedir({ method: 'POST', url: `/pedidos/${pedido.id}/cancelar` })
+  assert.equal(denovo.status, 409)
+  assert.equal(denovo.corpo.erro.codigo, 'transicao_invalida')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, pedido.total)
+
+  const enviado = (await comprar(ctx)).pedido
+  await ctx.pedir({ method: 'POST', url: `/pedidos/${enviado.id}/enviar` })
+  const entregue = await comprar(ctx)
+  await entregar(ctx, entregue.pedido.id)
+  for (const id of [enviado.id, entregue.pedido.id]) {
+    const { status, corpo } = await ctx.pedir({ method: 'POST', url: `/pedidos/${id}/cancelar` })
+    assert.equal(status, 409)
+    assert.equal(corpo.erro.codigo, 'transicao_invalida')
+    assert.equal((await buscar(ctx, id)).reembolsado, 0)
+  }
+  assert.equal(await estoqueDe(ctx, entregue.caneca.id), 7)
+})
+
+test('devolve parte de um pedido entregue, pelo preço da compra', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  await ctx.pedir({ method: 'PATCH', url: `/produtos/${caneca.id}`, payload: { preco: 9990 } })
+
+  ctx.relogio.avancarDias(5)
+  const { status, corpo } = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(status, 201)
+  assert.equal(corpo.pedidoId, pedido.id)
+  assert.equal(corpo.reembolso, 2 * 3990)
+  assert.equal(corpo.criadaEm, '2026-03-06T12:00:00.000Z')
+  assert.deepEqual(corpo.itens, [{ produtoId: caneca.id, quantidade: 2 }])
+  assert.equal(await estoqueDe(ctx, caneca.id), 9)
+  assert.equal(await estoqueDe(ctx, pires.id), 8)
+
+  const depois = await buscar(ctx, pedido.id)
+  assert.equal(depois.status, 'entregue')
+  assert.equal(depois.reembolsado, 2 * 3990)
+})
+
+test('as devoluções se somam, até o que foi comprado', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+
+  await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  const segunda = await devolver(ctx, pedido.id, [
+    { produtoId: caneca.id, quantidade: 2 },
+    { produtoId: pires.id, quantidade: 1 },
+  ])
+  assert.equal(segunda.status, 201)
+  assert.equal(segunda.corpo.reembolso, 2 * 3990 + 1500)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 3 * 3990 + 1500)
+
+  const demais = await devolver(ctx, pedido.id, [{ produtoId: caneca.id, quantidade: 1 }])
+  assert.equal(demais.status, 422)
+  assert.equal(demais.corpo.erro.codigo, 'devolucao_acima_do_comprado')
+  assert.equal(await estoqueDe(ctx, caneca.id), 10)
+  assert.equal((await buscar(ctx, pedido.id)).reembolsado, 3 * 3990 + 1500)
+})
+
+test('uma devolução com um item inválido não grava nada', async () => {
+  const ctx = montar()
+  const { pedido, caneca, pires } = await comprar(ctx)
+  await entregar(ctx, pedido.id)
+  const { status, corpo } = await devolver(ctx, pedido.id, [
