+/**
+ * O texto em minúsculas e sem acentos, para comparar em buscas: "Café" e "CAFE" viram "cafe". No SQL, a mesma coisa
+ * é a função `para_busca(texto)`.
+ */
+export function paraBusca(texto: string): string {
+  return texto.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase()
